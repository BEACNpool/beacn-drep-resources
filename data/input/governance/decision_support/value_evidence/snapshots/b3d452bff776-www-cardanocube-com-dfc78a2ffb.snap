  <div class="project-ratings-cart__panel bg-white border border-light shadow rounded-3">
    <button
      type="button"
      class="project-ratings-cart__toggle btn btn-light w-100 border-light border-0 border-bottom d-flex align-items-center justify-content-between gap-3"
      data-project-ratings-target="toggle"
      data-action="click->project-ratings#toggle">
      <span class="fw-bolder">Ratings batch</span>
      <span class="d-flex align-items-center gap-2">
        <span class="badge bg-primary rounded-pill" data-project-ratings-target="count">0</span>
