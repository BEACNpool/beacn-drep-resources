          </div>
          <div id='post_2' itemprop="comment" itemscope="itemscope" itemtype="http://schema.org/Comment" class='topic-body crawler-post'>
            <div class='crawler-post-meta'>
              <span class="creator" itemprop="author" itemscope="itemscope" itemtype="http://schema.org/Person">
                <a rel='nofollow' href='https://forum.cardano.org/u/lodl_de'><span itemprop="name">lodl_de</span></a>
                  <meta itemprop='url' content='https://forum.cardano.org/u/lodl_de'>
                
              </span>



              <span class="crawler-post-infos">
