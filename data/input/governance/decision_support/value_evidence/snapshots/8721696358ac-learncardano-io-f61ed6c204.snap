 #spu-27449 .spu-close {
 font-size: 40px;
 color: rgb(18, 18, 18);
 text-shadow: 0 1px 0 #000;
 }
 #spu-27449 .spu-close:hover {
 color: #000;
 }
 #spu-27449 {
 background-color: rgb(236, 236, 236);
 max-width: 750px;
 border-radius: 0px; 
 height: auto;
 box-shadow:  5px 5px 20px 0px rgba(44, 44, 44, 0.32);
 }
 #spu-27449 .spu-container {
 padding: 50px;
 height: calc(100% - 0px);
 } </style><link rel='stylesheet' id='gform_basic-css' href='https://learncardano.io/wp-content/plugins/gravityforms/assets/css/dist/basic.min.css' media='all' /><link rel='stylesheet' id='gform_theme_components-css' href='https://learncardano.io/wp-content/plugins/gravityforms/assets/css/dist/theme-components.min.css' media='all' /><link rel='stylesheet' id='gform_theme-css' href='https://learncardano.io/wp-content/plugins/gravityforms/assets/css/dist/theme.min.css' media='all' /></head><body class="wp-singular sfwd-courses-template-default single single-sfwd-courses postid-28928 wp-embed-responsive wp-theme-cardanopress-bootstrap-theme wp-child-theme-learncardano-cardanopress-theme-child learndash-cpt learndash-cpt-sfwd-courses learndash-template-ld30 learndash-embed-responsive"><div x-data="cardanoPress" x-on:keydown.escape="showModal = false" data-wallets="[&quot;Eternl&quot;,&quot;Yoroi&quot;,&quot;Typhon&quot;,&quot;GeroWallet&quot;,&quot;NuFi&quot;,&quot;Lace&quot;,&quot;Begin&quot;,&quot;VESPR&quot;]"> <a class="screen-reader-text" href="#site-content">Skip to content</a><header class="site-header navbar navbar-expand-xl navbar-light"><nav class="container flex-wrap flex-xl-nowrap"> <a href="https://learncardano.io/" class="navbar-brand fs-3 fw-bold"> Learn Cardano </a> <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"> <span class="navbar-toggler-icon"></span> </button><div class="collapse navbar-collapse flex-grow-0" id="navbarSupportedContent"><div class="menu-primary-menu-container"><ul class="navbar-nav"><li class="nav-item"><a href="https://learncardano.io/podcasts/" class="nav-link">Podcast</a></li><li class="nav-item"><a href="https://learncardano.io/resources/" class="nav-link">Resources</a></li><li class="nav-item"><a href="https://learncardano.io/courses/" class="nav-link">Courses</a></li><li cla