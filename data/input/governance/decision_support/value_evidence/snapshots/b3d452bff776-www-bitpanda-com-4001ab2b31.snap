for your wallet, simply spend your assets via your device wherever you see one of these symbols.\",\"type\":\"text\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"image\",\"attrs\":{\"id\":83985359040555,\"alt\":\"apple pay card payment\",\"src\":\"https://a.storyblok.com/f/176646/166x106/100235173d/apple_pay_mark_rgb_041619.svg\",\"title\":\"\",\"source\":\"\",\"copyright\":\"\",\"meta_data\":{\"alt\":\"apple pay card payment\",\"title\":\"\",\"source\":\"\",\"copyright\":\"\"}}}]}]},\"headline\":\"Pay quickly and safely with Apple Pay\",\"alignment\":\"left\",\"component\":\"HeroBanner\",\"ctaButton\":[],\"orientation\":\"right\",\"subHeadline\":\"\",\"headlineSize\":\"medium\",\"fullWidthImage\":false,\"backgroundColor\":\"white\",\"contentDisclaimer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}}}]\n"])</script><script>self.__next_f.push([1,"2b:[\"$\",\"$L25\",\"9a10c246-17b0-47f5-b569-82ef08a3f9fd,9a10c246-17b0-47f5-b569-82ef08a3f9fd\",{\"blok\":{\"_uid\":\"9a10c246-17b0-47f5-b569-82ef08a3f9fd\",\"image\":{\"id\":73726620702121,\"alt\":\"Smartphone screen displaying a Bitpanda card app with linked assets, balance in euros and BTC, expenses, cashback, and recent transactions.\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/176646/1200x1200/6580b0033a/track-your-spending.png\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Smartphone screen displaying a Bitpanda card app with linked assets, balance in euros and BTC, expenses, cashback, and recent transactions.\",\"title\":\"\",\"source\":\"\",\"copyright\":\"\"},\"is_external_url\":false},\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Keep track of your purchases and expenses in real time with the Bitpanda App.\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Access your payment history and view cashback rewards\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Get real-time push notifications with every transaction\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]}]}]}]},\"headline\":\"Track your spending\",\"alignment\":\"left\",\"component\":\"HeroBanner\",\"ctaButton\":[],\"orientation\":\"left\",\"subHeadline\":\"\",\"headlineSize\":\"medium\",\"fullWidthImage\":false,\"backgroundColor\":\"white\"}}]\n"])</script><script>self.__next_f.push([1,"2c:[\"$\",\"$L25\",\"f40ce109-956e-4609-ae46-74e991439827,f40ce109-956e-4609-ae46-74e991439827\",{\"blok\":{\"_uid\":\"f40ce109-956e-4609-ae46-74e991439827\",\"image\":{\"id\":77281132586970,\"alt\":\"Lock floating above green pillar\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/176646/1200x1200/0b77eff801/security_.png\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Lock floating above green pillar\",\"title\":\"\",\"source\":\"\",\"copyright\":\"\"},\"is_external_url\":false},\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"From online shopping to in-store purchases, Bitpanda and Visa keep your transactions safe.\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Backed by Visa security \u0026 fraud prevention\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Block and unblock your card with a tap\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Extra 3DS protection for an added layer of security\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"hard_break\"}]},{\"type\":\"paragraph\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"image\",\"attrs\":{\"id\":null,\"alt\":\"\",\"src\":\"https://a.storyblok.com/f/176646/250x96/d20d1920d4/pci-dss-compliant_resized_final.webp\",\"title\":\"\",\"source\":null,\"copyright\":null,\"meta_data\":[]}}]}]},\"headline\":\"Trusted and secure.\",\"alignment\":\"left\",\"component\":\"HeroBanner\",\"ctaButton\":[],\"orientation\":\"right\",\"subHeadline\":\"\",\"headlineSize\":\"medium\",\"fullWidthImage\":false,\"backgroundColor\":\"white\"}}]\n"])</script><script>self.__next_f.push([1,"2d:[\"$\",\"$L25\",\"ebea3096-c257-4000-b724-67ad6b781b68,ebea3096-c257-4000-b724-67ad6b781b68\",{\"blok\":{\"_uid\":\"ebea3096-c257-4000-b724-67ad6b781b68\",\"items\":[{\"_uid\":\"a9430e93-fcb0-4a46-9b53-d41fe5c51234\",\"title\":\"Am I eligible to order a Bitpanda Card?\",\"content\":[{\"_uid\":\"cc57e9d5-156c-40a9-be8b-41ec1948f66e\",\"items\":[{\"_uid\":\"19e0f7a6-1691-4ad8-8c2e-cca84fa5508d\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"In order to be eligible to order the Bitpanda Card, you have to fulfil the following two requirements: \",\"type\":\"text\"}]},{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"You have a verified Bitpanda account\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"You must be a resident in a country in the euro area. These are countries that have adopted the euro as their primary currency.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We have collected all the data required from you from your signup. At the moment, customers that verify their identity via “Bankident” cannot order a card.\",\"type\":\"text\"}]}]}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"99018f63-c991-4595-973c-f643d76d6673\",\"title\":\"Can I see the transaction history from my previous card?\",\"content\":[{\"_uid\":\"53ec5e9a-61c6-403a-9315-42f5ab90ccd9\",\"items\":[{\"_uid\":\"4f0a943f-cc89-49c9-9b97-f811aa6c85a0\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"We're in the process of moving your transaction history from the old card, and it’ll be available in the Bitpanda app in July.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"f6cb18ae-0034-4860-b18b-3f2141690e54\",\"title\":\"Can I change the connected assets?\",\"content\":[{\"_uid\":\"7b27049f-de88-4ed4-8986-9e53f1452a80\",\"items\":[{\"_uid\":\"364caedc-6b51-4982-9222-1d1f31c7258a\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Yes, at any time. You can use the Bitpanda App to manage your card. For instance, you initially set the Main payment asset to be Bitcoin but now you want to pay with Ethereum instead. No problem – This can be done at any time, instantly. You can also connect your EUR wallet.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"b033b277-cee3-41e2-99c6-acc4e8abc5e6\",\"title\":\"When and how can I activate my Bitpanda Card?\",\"content\":[{\"_uid\":\"64f749fd-4e93-48ee-bd60-03d4a1776369\",\"items\":[{\"_uid\":\"bf7ac462-3eed-46a3-9ff0-98bebaa55e66\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"To start using your card, just update your Bitpanda app, go to the Card section from your Profile, click on “activate” and enter your CVV. You can activate your new card in the Bitpanda app from 01.04.2025. Learn more \",\"type\":\"text\"},{\"text\":\"here\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/XX/activate\",\"uuid\":\"146271e6-0552-4977-8206-ed554f57daa9\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\",\"story\":{\"name\":\"Activate\",\"id\":629045372,\"uuid\":\"146271e6-0552-4977-8206-ed554f57daa9\",\"slug\":\"activate\",\"url\":\"XX/activate\",\"translated_name\":\"Activate\",\"full_slug\":\"en/XX/activate\",\"_stopResolving\":true}}}]},{\"text\":\".\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"6a60d0a1-c4c3-4bcd-91d9-6616f57bb230\",\"title\":\"Are there any minimum payment amounts?\",\"content\":[{\"_uid\":\"6754a0f6-8368-4b0a-8f12-c0453022c202\",\"items\":[{\"_uid\":\"94b371d2-7ab3-453d-8111-ce65e1b79ec1\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The minimum payment amount is €1.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"a5bf148a-feab-4569-b674-decb2011740d\",\"title\":\"What is a \\\"Fallback payment asset\\\"?\",\"content\":[{\"_uid\":\"c6d0f633-7c6d-4f14-b486-64279f004ca4\",\"items\":[{\"_uid\":\"760a1b53-d03f-447a-b82f-c0158b47153a\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"During the card order process, you can select both a Main and an optional Fallback payment asset. These will be used to fund your card payments. The Main payment asset is the default asset to cover your transaction. If the balance of your Main payment asset is too low to fund the transaction, your card would normally be declined. In this case, however, the Fallback asset jumps into action and covers the respective payment to avoid a failed transaction.Note: You can change the main and Fallback asset at any time via the Bitpanda mobile app.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"55ea4fb6-47c8-49cb-8283-cc08b266e776\",\"title\":\"What happens if my payment gets refunded?\",\"content\":[{\"_uid\":\"2b200ac3-09f1-4257-8bf9-7ccd5807da16\",\"items\":[{\"_uid\":\"6c6d620d-3a65-4b1b-9a58-91154231f8ad\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Bitpanda Card is nominated in EUR and all related transactions are processed in EUR. Therefore, refunds of any kind will always be credited in the respective amount to your EUR fiat wallet on Bitpanda.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"d9345a59-30c1-4ae6-a697-6aa66f0f049a\",\"title\":\"Which assets can be used with my Bitpanda Card?\",\"content\":[{\"_uid\":\"a1e901f8-ad7d-4a55-9b8c-e1a17b0028d8\",\"items\":[{\"_uid\":\"b5c81802-ec77-4564-a721-9b18669974bb\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"All cryptocurrencies listed on Bitpanda\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"All precious metals listed on Bitpanda\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Euro (other fiat currencies are currently not supported by the card)\",\"type\":\"text\"}]}]}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"We are constantly adding more assets and currencies to the list, giving you more ways to spend.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"0fcad28b-4e6d-4317-ab02-2239bf2da8cb\",\"title\":\"I lost my card. Can I order a new one?\",\"content\":[{\"_uid\":\"5fb7c4a8-3f78-443e-8350-52a06c3d395d\",\"items\":[{\"_uid\":\"d12448d9-6179-45f4-b083-58a51d798239\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Yes. In the case of damage, loss or theft, you can reorder your card in the Bitpanda mobile app at a cost of €9.90. Please note that you can only have one active Bitpanda Card at a time.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"dff8e09f-4e06-43ea-af58-aa5135707c6b\",\"title\":\"How do you keep my money safe?\",\"content\":[{\"_uid\":\"8599f474-ede6-4156-a7f0-a91d50b2c528\",\"items\":[{\"_uid\":\"91567e82-e48e-4ddf-adcd-d244f4c5f045\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your Bitpanda Card transactions are protected by state-of-the-art Visa anti-fraud detection systems and monitored by Bitpanda to flag any suspicious behaviour. Additionally, you can block and unblock your card at any time using the Bitpanda mobile app. If you want to deactivate your card permanently, please contact our customer support.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"c24b6728-2ec8-4d05-ac5b-8f28dfa46ce4\",\"title\":\"Why did my Bitpanda Card payment fail?\",\"content\":[{\"_uid\":\"996b347a-89ae-453f-b79d-0d9bec88ef44\",\"items\":[{\"_uid\":\"6537cd6b-2426-495d-bae9-cc2d62e00d18\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Most payments fail due to insufficient funds. You should make sure your chosen payment asset has sufficient funds to cover the payment amount. Otherwise, you can switch to a different wallet or asset that has the sufficient amount in it. For other common reasons a payment may fail and what to do if your payments fail, please refer to our Helpdesk articles.Note: If you have been asked to provide \\\"Proof of funds\\\", all payout options including the Bitpanda Card will be disabled until the requested documents have been submitted, processed and approved.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"420d7905-c2e4-4eb0-b87c-c2a03cc0ed6c\",\"title\":\"How do I keep track of my spending?\",\"content\":[{\"_uid\":\"eb464fe5-7655-4412-b126-7338383c8f0f\",\"items\":[{\"_uid\":\"f9b14175-484d-4d6c-add3-6a9ef77bed26\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"You can have the information on your card spending at your fingertips. The moment you spend with your card, you will immediately receive a push notification with a summary of your payment, including the asset used and the credited cashback (more info about cashback is provided below) on the display of your phone. Additionally, you can find an overview of your payment history and trade history in your Bitpanda mobile app.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"b64b9df6-551c-4895-b538-9257f416ca80\",\"title\":\"How do I pay using crypto or metals?\",\"content\":[{\"_uid\":\"5dde6abe-b749-4fcb-9c38-cb49e01d2b84\",\"items\":[{\"_uid\":\"823fe988-8a53-413b-9f70-7829f6e2f317\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"In order to use your Bitpanda card, you need to set up a “Main payment asset”. You can use any asset* you hold on Bitpanda as your Main payment asset, this includes fiat (EUR), all crypto-assets and precious metals. Your card is then connected to your Main payment asset at all times, which is used to fund your card payments. This means at the moment you complete a purchase or cash withdrawal with your card, your asset will instantly and automatically be traded to EUR and deducted from your EUR fiat currency wallet to complete the payment. Of course, you can always switch your Main payment asset via the Bitpanda App at any time.You can also set up a “Fallback payment asset”. The Fallback payment asset is optional but recommended to add. If a payment is too big to be covered by the connected Main payment asset, the full amount will be deducted from the fallback wallet. This helps avoid failed transactions if your main wallet is running low on funds.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"*except the Bitpanda Crypto Indices\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"09a12307-8973-4252-9ad9-4c247e6e2e52\",\"title\":\"How long does it take to get my card? \",\"content\":[{\"_uid\":\"8cda2687-d983-442c-b02f-9e6cf724a668\",\"items\":[{\"_uid\":\"15b113cd-4d3e-4a95-b1df-4490026eec68\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Your card will typically be shipped within 3-7 working days. Shipping times may vary depending on the destination country and the delivery location within each country.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"c5bc1b50-4859-4029-b065-205fb40530e6\",\"title\":\"How do I order a Bitpanda Card?\",\"content\":[{\"_uid\":\"7ac7227a-fde8-4503-81d1-12725f3216e9\",\"items\":[{\"_uid\":\"04bbdf7a-6634-4cba-ad7c-5f505d362c01\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"If you fulfil the above-mentioned criteria, you will be able to order a Bitpanda Card. Just select “Card” in the menu of your Bitpanda account and follow the instructions provided to you on-screen.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"4156e992-8b3e-4b0b-886f-04b1f6c7f3b8\",\"title\":\"Is this a credit or debit card?\",\"content\":[{\"_uid\":\"a43e3997-0a80-4bcc-9a89-7beff28451d7\",\"items\":[{\"_uid\":\"34996602-e491-4ae8-8542-83f95596017d\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Bitpanda Card is a debit card, therefore you cannot create any debt when using it. It is connected to your Bitpanda account and enables you to spend funds directly from any of your wallets - be that fiat, crypto, stocks or metals. You can use it for online payments, to pay for your groceries at the supermarket or to make ATM withdrawals. Since the Bitpanda Card is connected to the Visa payment system, it can be used anywhere in the world where a Visa card is accepted.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"7adf2130-2d2d-4128-8859-41f335261bb7\",\"title\":\"Do I have to pay taxes when I pay with cryptocurrencies?\",\"content\":[{\"_uid\":\"a420b6c1-fa1b-42be-aead-69e15ac66a44\",\"items\":[{\"_uid\":\"79c5cb87-d9a0-4e9a-ba46-c877f0144fa7\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Paying with cryptocurrencies by e.g. using your Bitcoin (BTC) as the default asset for the Bitpanda Card involves a trade from cryptocurrency to euro. Therefore, this is usually a taxable event. However, please note that taxable events depend on your individual tax situation and are country-specific. Therefore, please understand that Bitpanda cannot provide any tax support and we recommend that you get in touch with your local tax advisor for more information. Please note that you can also use your euro wallet with your Bitpanda Card, which doesn't involve a taxable event when a payment is made using the Bitpanda Card.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"89f8e114-aeca-479b-ab84-97b65e8f3ac7\",\"title\":\"Which assets are eligible for cashback?\",\"content\":[{\"_uid\":\"bb352cdf-0aa0-4c85-b0a8-f82aa81aba1f\",\"items\":[{\"_uid\":\"606ea39c-7dcb-4703-83f8-776e62748d6b\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Cashback is available for purchases made using crypto.  Your payments will be excluded from the Cashback programme if fiat (€), Bitpanda Stocks, Metals, stablecoin and other assets other than crypto are your selected payment asset.\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"},{\"_uid\":\"b2e4347f-5df5-4b9a-937a-6141779a1e9e\",\"title\":\"Need more help?\",\"content\":[{\"_uid\":\"82059a11-ce89-4e02-99d8-950e37701381\",\"items\":[{\"_uid\":\"1f62f058-7b14-4109-81f4-d43bd1c6168a\",\"title\":\"\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Find more information in our \",\"type\":\"text\"},{\"text\":\"Helpdesk\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://support.bitpanda.com/hc/en-us\",\"linktype\":\"url\"}}]},{\"text\":\".\",\"type\":\"text\"}]}]},\"component\":\"TextBlock\",\"titleVariant\":\"large\",\"bodyTextVariant\":\"default\"}],\"component\":\"AccordionContent\"}],\"component\":\"AccordionItem\"}],\"title\":\"FAQ\",\"bodyText\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]},\"subtitle\":\"\",\"component\":\"FAQAccordion\",\"background\":\"white\"}}]\n"])</script><script>self.__next_f.push([1,"2e:[\"$\",\"$L25\",\"9c157d45-058c-44a0-a417-044791b58591,9c157d45-058c-44a0-a417-044791b58591\",{\"blok\":{\"cta\":[],\"_uid\":\"9c157d45-058c-44a0-a417-044791b58591\",\"items\":[{\"_uid\":\"a3b6b6ec-8a08-46a7-82b7-3a5b28d1317d\",\"link\":{\"id\":\"\",\"url\":\"https://www.visa.co.uk/products/visa-secure.html\",\"linktype\":\"url\",\"fieldtype\":\"multilink\",\"cached_url\":\"https://www.visa.co.uk/products/visa-secure.html\"},\"image\":{\"id\":72759985694323,\"alt\":\"card payment icon\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/176646/150x150/72b41791fb/33_card_payment_24x24px_green.svg\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"card payment icon\",\"title\":\"\",\"source\":\"\",\"copyright\":\"\"},\"is_external_url\":false},\"label\":\"\",\"title\":\"Visa Secure FAQ\",\"asImage\":false,\"content\":\"\",\"component\":\"BenefitsItem\",\"linkLabel\":\"Read more\",\"backgroundColor\":\"inherit\",\"isCardWithBackground\":false},{\"_uid\":\"92996b99-b526-45af-9525-78ae2a556a82\",\"link\":{\"id\":\"\",\"url\":\"https://support.bitpanda.com/hc/en-us\",\"linktype\":\"url\",\"fieldtype\":\"multilink\",\"cached_url\":\"https://support.bitpanda.com/hc/en-us\"},\"image\":{\"id\":72759971468898,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"contact us chat help icon\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/176646/150x150/149312a41e/05_contactus_chathelp_24x24px_green.svg\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"\",\"title\":\"contact us chat help icon\",\"source\":\"\",\"copyright\":\"\"},\"is_external_url\":false},\"label\":\"\",\"title\":\"Couldn’t find what you were looking for?\",\"asImage\":false,\"content\":\"Just fill out our form and our customer support will get in touch with you as soon as possible.\",\"component\":\"BenefitsItem\",\"linkLabel\":\"Customer support\",\"backgroundColor\":\"inherit\",\"isCardWithBackground\":false}],\"bodyText\":\"\",\"headline\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]},\"alignment\":\"left\",\"component\":\"Benefits\",\"textAsLink\":false,\"itemsPerRow\":\"\",\"subHeadline\":\"\",\"colorVariant\":\"white\",\"headlineAlignment\":\"\"}}]\n"])</script><script>self.__next_f.push([1,"2f:[\"$\",\"div\",\"9343c8b2-4d86-4e03-96b5-acd884b67930,9343c8b2-4d86-4e03-96b5-acd884b67930\",{\"ref\":\"$undefined\",\"className\":\"gnlqYH jTWvec hYZFjI SQKud hArIMZ jjnpvE bWadIU\",\"children\":[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"fPSBzf iRgpoQ kzxJbq\",\"children\":[null,[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"fPSBzf iRgpoQ XLQPD kpXXjj jjvmkP\",\"children\":[[\"$\",\"div\",\"9df5f565-5b1f-4f9