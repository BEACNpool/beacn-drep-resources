ashback on all crypto asset spending\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Choose from 600+ crypto assets to spend\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]}]}]}]},\"autoPlay\":true,\"headline\":\"Spend anything. Anywhere.\",\"pageName\":\"\",\"alignment\":\"left\",\"component\":\"HeroBanner\",\"ctaButton\":[],\"splineLink\":\"\",\"orientation\":\"right\",\"subHeadline\":\"\",\"headlineSize\":\"medium\",\"isUsedAsCard\":true,\"fullWidthImage\":false,\"videoThumbnail\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":[]},\"backgroundColor\":\"white\",\"lottieAnimation\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":[]},\"mediaDisclaimer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]},\"contentDisclaimer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}}}],[\"$\",\"$L25\",\"5728e9a4-ebf3-4125-994a-72ff462a92be,5728e9a4-ebf3-4125-994a-72ff462a92be\",{\"blok\":{\"cta\":[],\"_uid\":\"5728e9a4-ebf3-4125-994a-72ff462a92be\",\"items\":[{\"_uid\":\"7a612ffc-434b-48db-b3a3-250452dd4d45\",\"link\":{\"id\":\"\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"/en/\",\"prep\":true},\"image\":{\"id\":72762434370191,\"alt\":\"free card payment icon\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/176646/150x150/92fa8f2640/91_freecard_payment_56x56px_whiteongreen.svg\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"free card payment icon\",\"title\":\"\",\"source\":\"\",\"copyright\":\"\"},\"is_external_url\":false},\"label\":\"\",\"title\":\"Free card\",\"asImage\":false,\"content\":\"And no monthly costs\",\"component\":\"BenefitsItem\",\"linkLabel\":\"\",\"backgroundColor\":\"inherit\",\"isCardWithBackground\":false},{\"_uid\":\"65fae0b9-fc0c-4a16-aa74-f5b55a6cfc54\",\"link\":{\"id\":\"\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"/en/\",\"prep\":true},\"image\":{\"id\":72762433956462,\"alt\":\"zero fees tag icon\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/176646/150x150/092a2a55ec/92_0_fees_tagoff_56x56px_whiteongreen.svg\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"zero fees tag icon\",\"title\":\"\",\"source\":\"\",\"copyright\":\"\"},\"is_external_url\":false},\"label\":\"\",\"title\":\"0% FX fees\",\"asImage\":false,\"content\":\"For non Euro transactions (VISA mark-up fees apply)\",\"component\":\"BenefitsItem\",\"linkLabel\":\"\",\"backgroundColor\":\"inherit\",\"isCardWithBackground\":false},{\"_uid\":\"26048ba0-1f5e-435b-9e16-08f2e1c4d6f9\",\"link\":{\"id\":\"\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"/en/\",\"prep\":true},\"image\":{\"id\":72762434013811,\"alt\":\"In app card management icon\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/176646/150x150/6229704820/93_in-appcardmanagement_appsaddin_56x56px_whiteongreen.svg\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"In app card management icon\",\"title\":\"\",\"source\":\"\",\"copyright\":\"\"},\"is_external_url\":false},\"label\":\"\",\"title\":\"In-app card management\",\"asImage\":false,\"content\":\"Choose main \u0026 fallback payment assets\",\"component\":\"BenefitsItem\",\"linkLabel\":\"\",\"backgroundColor\":\"inherit\",\"isCardWithBackground\":false}],\"bodyText\":\"\",\"headline\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"t