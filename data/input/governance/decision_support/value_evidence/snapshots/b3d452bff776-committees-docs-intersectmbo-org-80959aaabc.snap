-start\",\"children\":[[\"$\",\"$3\",\"sC4x0LMIhxkd\",{\"children\":[[\"$\",\"$3\",\"0\",{\"children\":\"The proposed Governance Support Budget is ₳ 13,170,500.  This is to be managed by one Treasury withdrawal action using a smart contract:\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"85:[\"$\",\"$L7b\",\"o86tLqcluyVX\",{\"records\":[],\"children\":[\"$\",\"div\",null,{\"className\":\"decoration-primary/6 max-w-3xl layout-wide:max-w-6xl mx-auto w-full print:break-inside-avoid flex flex-col gap-3\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"decoration-primary/6 max-w-3xl layout-wide:max-w-6xl print:break-inside-avoid relative mx-auto grid w-full min-w-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-full min-w-0 overflow-x-auto overflow-y-hidden overscroll-x-none border-tint-subtle\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col min-w-full w-fit\",\"role\":\"table\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"flex flex-col min-w-full w-fit\",\"children\":[\"$\",\"div\",null,{\"role\":\"rowgroup\",\"className\":\"flex flex-col min-w-full w-fit [\u0026\u003e*+*]:border-t\",\"children\":[[\"$\",\"$L9e\",\"H8yD6IbZIjCF\",{\"role\":\"row\",\"recordId\":\"H8yD6IbZIjCF\",\"visibleClassName\":\"flex\",\"className\":\"group/row border-tint-subtle transition-colors hover:bg-tint-hover\",\"children\":[[\"$\",\"div\",\"KVLkmtw6qCrl\",{\"role\":\"cell\",\"className\":\"relative flex flex-1 border-r px-3 py-2 align-middle text-sm last:border-r-0 border-tint-subtle\",\"style\":{\"width\":\"clamp(100px, calc((100% - 0px) / 2), 100%)\",\"minWidth\":\"clamp(100px, calc((100% - 0px) / 2), 100%)\"},\"children\":\"$Lbe\"}],[\"$\",\"div\",\"ffjcUBa8Kzc2\",{\"role\":\"cell\",\"className\":\"relative flex flex-1 border-r px-3 py-2 align-middle text-sm last:border-r-0 border-tint-subtle\",\"style\":{\"width\":\"clamp(100px, calc((100% - 0px) / 2), 100%)\",\"minWidth\":\"clamp(100px, calc((100% - 0px) / 2), 100%)\"},\"children\":\"$L