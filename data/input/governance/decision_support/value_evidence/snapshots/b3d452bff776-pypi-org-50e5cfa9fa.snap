{"info":{"author":"Felipe Gonzalez","author_email":"felipe@txpipe.io","bugtrack_url":null,"classifiers":["License :: OSI Approved :: Apache Software License","Programming Language :: Python :: 3","Programming Language :: Python :: 3.10","Programming Language :: Python :: 3.11","Programming Language :: Python :: 3.12","Programming Language :: Python :: 3.8","Programming Language :: Python :: 3.9"],"description":"# python-sdk\nPython SDK for the UTxO RPC interface\n\n\n# Setup\n\n`utxorpc` requires `Python3.8>,<4.0`. To setup a local environment you can run:\n\n```sh\njust init\n```\n\nThis will use your system's `python3`, whichever it may be. If you wish to setup a particular Python executable (for example, `python3.12`) you should do:\n\n```sh\njust init python3.12\n```\n\nTo run the examples, you require an Demeter API Key for the UtxoRPC service. To get your API key, you can check the documentation at (https://docs.demeter.run/cli)[https://docs.demeter.run/cli]:\n\n```sh\njust run-examples YOUR_DMTR_API_KEY\n```\n\n# Contributing\n\nBefore commiting, make sure to run the following to format and lint the code.\n\n```sh\njust format\njust lint\n```\n","description_content_type":"text/markdown","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":null,"home_page":"https://github.com/utxorpc/python-sdk","keywords":null,"license":"Apache-2.0","license_expression":null,"license_files":null,"maintainer":null,"maintainer_email":null,"name":"utxorpc","package_url":"https://pypi.org/project/utxorpc/","platform":null,"project_url":"https://pypi.org/project/utxorpc/","project_urls":{"Homepage":"https://github.com/utxorpc/python-sdk","Repository":"https://github.com/utxorpc/python-sdk"},"provides_extra":null,"release_url":"https://pypi.org/project/utxorpc/0.1.0/","requires_dist":["utxorpc-spec==0.5.1","typing-extensions<5.0.0,>=4.12.2"],"requires_python":"<4.0,>=3.8","summary":"UTxO RPC SDK.","version":"0.1.0","yanked":false,"yanked_reason":null},"last_serial":24108900,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"txpipe"}]},"releases":{"0.1.0":[{"comment_text":"","core-metadata":{"sha256":"b861fa38038bcf8840c3a0488e5e7c049aa9c138d584e593a7e319af4c842919"},"digests":{"blake2b_256":"4c642d53566cb4b2ac2b749d8028a738a4756283d1152b2045a5eb19a448c255","md5":"12acaf0d87ce8de79801689d74c590d5","sha256":"1da8de7d0de1e6d3f0e9d671077e0884cfbf7ca711d978a001006b6eaf593e1e"},"downloads":-1,"filename":"utxorpc-0.1.0-py3-none-any.whl","has_sig":false,"md5_digest":"12acaf0d87ce8de79801689d74c590d5","packagetype":"bdist_wheel","python_version":"py3","requires_python":"<4.0,>=3.8","size":9271,"upload_time":"2024-07-12T19:49:45","upload_time_iso_8601":"2024-07-12T19:49:45.570737Z","url":"https://files.pythonhosted.org/packages/4c/64/2d53566cb4b2ac2b749d8028a738a4756283d1152b2045a5eb19a448c255/utxorpc-0.1.0-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"789ad7d5499537170ec188df7e556072c16a3d5f7826bcc9daaae3b0bf0cf7f8","md5":"176a2e4f056e362ed8235e8e28a1f16a","sha256":"1436b3e855702bef04d338ae64a2f003288584cf1cffb0f334714badaa6a96dd"},"downloads":-1,"filename":"utxorpc-0.1.0.tar.gz","has_sig":false,"md5_digest":"176a2e4f056e362ed8235e8e28a1f16a","packagetype":"sdist","python_version":"source","requires_python":"<4.0,>=3.8","size":7735,"upload_time":"2024-07-12T19:49:46","upload_time_iso_8601":"2024-07-12T19:49:46.811559Z","url":"https://files.pythonhosted.org/packages/78/9a/d7d5499537170ec188df7e556072c16a3d5f7826bcc9daaae3b0bf0cf7f8/utxorpc-0.1.0.tar.gz","yanked":false,"yanked_reason":null}],"0.1.0rc1":[{"comment_text":"","core-metadata":{"sha256":"fe4485ab8fcf5ee5f6d65fad8c0d1b015c7b59dc302087c1e1213bfcb1cdb94b"},"digests":{"blake2b_256":"e3e90eccb3d7e35e7a476457cff2a1d6ce139b464727a4f40dfe61143a763b12","md5":"1d49c24e18a609af28859e62080058b5","sha256":"bd2e9f4759477ce76f709ee7fccdcaabe4ebb2bb7d5f0a5afd315f78a0