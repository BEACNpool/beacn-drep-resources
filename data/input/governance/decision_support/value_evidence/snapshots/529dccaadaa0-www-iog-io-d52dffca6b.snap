<!DOCTYPE html><html lang="en" dir="ltr"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" href="/_next/static/media/1d1b08f03f635dc8-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" href="/_next/static/media/60c9b95e8d9e49be-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" href="/_next/static/media/61d96c4884191721-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" href="/_next/static/media/6ad0344ed98ac2e9-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" href="/_next/static/media/7442bf736b95a473-s.p.woff" as="font" crossorigin="" type="font/woff"/><link rel="preload" href="/_next/static/media/b0bb26939bb40fdb-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" as="image" href="https://cdn.sanity.io/images/5ro2r81m/production/32c511b59ab45ccca55486b018514412422e9177-240x31.svg" fetchPriority="high"/><link rel="preload" as="image" imageSrcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F5ro2r81m%2Fproduction%2Fa4db9f4c041e3d0db43192df4a8710fa12b9695a-1920x1080.jpg%3Frect%3D1%2C0%2C1919%2C1080%26w%3D1100%26h%3D619%26q%3D85%26auto%3Dformat%26dpr%3D2&amp;w=1200&amp;q=75&amp;dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F5ro2r81m%2Fproduction%2Fa4db9f4c041e3d0db43192df4a8710fa12b9695a-1920x1080.jpg%3Frect%3D1%2C0%2C1919%2C1080%26w%3D1100%26h%3D619%26q%3D85%26auto%3Dformat%26dpr%3D2&amp;w=3840&amp;q=75&amp;dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc 2x" fetchPriority="high"/><link rel="stylesheet" href="/_next/static/css/53759162380015ff.css?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/d0d3e5df4a28a9f7.css?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/cc7c1c14b07fcd47.css?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/webpack-0c98e90d872962fd.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc"/><script src="/_next/static/chunks/1dd3208c-e155c594ab2e0c3d.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/1528-92399f9eeeb69d98.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/main-app-420abd7798f6e175.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/1e75d386-4f1e634683d1ef5e.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/8bb4d8db-68ab191f11682664.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/9330-e98fa26b6266d337.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/6614-0f44969ce4855ef0.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/992-b1650194cb785a43.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/3676-e0e7c07d577c2766.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/3700-58060dc6837b00a5.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/1129-55942bc0aa37e79e.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/237-586b063426e29a0d.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/8316-d0ee4da8262dc579.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/6354-dad27cdf05d32b2b.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/4696-190c08a04e38fa65.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/7436-c95bbcf82ffe9216.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/7649-9fa73dc79e9abd71.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/app/%5Blocale%5D/(main-layout)/news/%5Bslug%5D/page-954658d6228c70f3.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/4922-1d859531bf4b2f28.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/app/%5Blocale%5D/layout-a760c8a6f0ef8672.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/app/%5Blocale%5D/error-32120b24a690c970.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/app/%5Blocale%5D/(main-layout)/layout-e3bbdae928a96559.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><script src="/_next/static/chunks/app/%5Blocale%5D/not-found-71b786b066e4e725.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc" async=""></script><link rel="preload" href="https://cmp.osano.com/AzZXI3TYiFWNB5yus/7b252940-6107-43ba-911b-d49d0d4ce6f8/osano.js" as="script"/><link rel="preload" href="https://www.googletagmanager.com/gtag/js?id=G-KJKXMPL63Y" as="script"/><link rel="preload" href="https://js.hsforms.net/forms/embed/v2.js" as="script"/><link rel="preload" href="https://www.googletagmanager.com/gtm.js?id=GTM-PZXTZH37" as="script"/><title>IO treasury proposals: the 5-minute overview - Input | Output</title><meta name="description" content="An overview of Input Output’s 2026 treasury funding proposals, with a focus on their deliverables"/><meta name="keywords" content="Input | Output, iohk, iog, cascading disruptions"/><meta property="og:title" content="IO treasury proposals: the 5-minute overview - Input | Output"/><meta property="og:description" content="An overview of Input Output’s 2026 treasury funding proposals, with a focus on their deliverables"/><meta property="og:url" content="https://www.iog.io/news/io-treasury-proposals-the-5-minute-