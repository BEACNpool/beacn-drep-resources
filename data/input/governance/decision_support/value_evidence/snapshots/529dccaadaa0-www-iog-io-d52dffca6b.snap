hsy59xdMn8i7WRSTSSU3bot1Bc\",\"8316\",\"static/chunks/8316-d0ee4da8262dc579.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"4696\",\"static/chunks/4696-190c08a04e38fa65.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"7436\",\"static/chunks/7436-c95bbcf82ffe9216.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"6082\",\"static/chunks/app/%5Blocale%5D/not-found-71b786b066e4e725.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\"],\"Page404\"]\n25:I[91021,[\"1828\",\"static/chunks/1e75d386-4f1e634683d1ef5e.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"6705\",\"static/chunks/8bb4d8db-68ab191f11682664.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"9330\",\"static/chunks/9330-e98fa26b6266d337.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"6614\",\"static/chunks/6614-0f44969ce4855ef0.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"992\",\"static/chunks/992-b1650194cb785a43.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"3676\",\"static/chunks/3676-e0e7c07d577c2766.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"3700\",\"static/chunks/3700-58060dc6837b00a5.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"1129\",\"static/chunks/1129-55942bc0aa37e79e.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"237\",\"static/chunks/237-586b063426e29a0d.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"8316\",\"static/chunks/8316-d0ee4da8262dc579.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"6354\",\"static/chunks/6354-dad27cdf05d32b2b.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"4696\",\"static/chunks/4696-"])</script><script>self.__next_f.push([1,"190c08a04e38fa65.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"7436\",\"static/chunks/7436-c95bbcf82ffe9216.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"7649\",\"static/chunks/7649-9fa73dc79e9abd71.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\",\"3757\",\"static/chunks/app/%5Blocale%5D/(main-layout)/news/%5Bslug%5D/page-954658d6228c70f3.js?dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc\"],\"LinkButton\"]\n1b:[\"$\",\"$L23\",null,{\"pages\":[{\"_type\":\"page.404\",\"language\":\"en\",\"heading\":\"404\",\"text\":[{\"_type\":\"block\",\"_key\":\"b475282f9220\",\"children\":[{\"_key\":\"2341c92e0a57\",\"_type\":\"span\",\"text\":\"Sorry, this page could not be found.\",\"marks\":[]}],\"markDefs\":[],\"style\":\"normal\",\"listItem\":null,\"level\":null}],\"logo\":{\"_key\":\"\",\"_type\":\"component.image.alt\",\"asset\":{\"_id\":\"image-cb293b55357c7c774f1f4ec8c391a2cdc2410f2e-520x68-png\",\"_type\":\"sanity.imageAsset\",\"_rev\":\"5T44j2uOpapkQlSeHkXpk8\",\"extension\":\"png\",\"mimeType\":\"image/png\",\"originalFilename\":\"Input Output Full Logo.png\",\"path\":\"images/5ro2r81m/production/cb293b55357c7c774f1f4ec8c391a2cdc2410f2e-520x68.png\",\"sha1hash\":\"cb293b55357c7c774f1f4ec8c391a2cdc2410f2e\",\"size\":9985,\"url\":\"https://cdn.sanity.io/images/5ro2r81m/production/cb293b55357c7c774f1f4ec8c391a2cdc2410f2e-520x68.png\",\"_updatedAt\":\"2025-11-12T17:07:17Z\",\"metadata\":{\"dimensions\":{\"_type\":\"sanity.imageDimensions\",\"aspectRatio\":7.647058823529412,\"height\":68,\"width\":520},\"lqip\":\"data:image/png;base64,\"}},\"crop\":null,\"hotspot\":null,\"alt\":\"Input | Output Logo\",\"caption\":null,\"width\":null},\"backLink\":{\"label\":\"Back to homepage\",\"link\":\"/\"},\"footer\":{\"links\":[{\"_key\":\"3ab820fdf7aa\",\"label\":\"Privacy policy\",\"url\":\"/privacy-policy\"},{\"_key\":\"177e5c5c6b77\",\"label\":\"Terms and con"])</script><script>self.__next_f.push([1,"ditions\",\"url\":\"/terms-and-conditions\"},{\"_key\":\"f15a5bd02c9a\",\"label\":\"Cookie policy\",\"url\":\"/cookie-policy\"}]}}]}]\n"])</script><script>self.__next_f.push([1,"c:[[\"$\",\"article\",null,{\"itemScope\":true,\"itemType\":\"https://schema.org/BlogPosting\",\"className\":\"section-light\",\"children\":[[\"$\",\"header\",null,{\"className\":\"section-dark padding-section !pb-12 flex overflow-hidden relative\",\"children\":[null,[[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-noise opacity-40\"}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-dark-gradient\"}]],[\"$\",\"div\",null,{\"className\":\"container flex-1 flex relative\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute left-0 top-0 w-[200vw] -translate-x-1/2 h-px bg-white/15\"}],[\"$\",\"div\",null,{\"className\":\"flex-1 container-padding flex\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative flex-1 flex items-end sm:items-center\",\"children\":[[\"$\",\"div\",null,{\"style\":{\"backgroundPosition\":\"right 0px  top -2px\"},\"className\":\"w-screen absolute top-[1px] right-[3.25rem] sm:right-20 opacity-50 post-hero-bg-graphic-positioning texture-dot-grid\"}],\"$undefined\",[\"$\",\"div\",null,{\"className\":\"absolute inset-0 negate-padding-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"absolute right-[3.25rem] sm:right-20 top-0 h-full w-px bg-white/15\"}]}],[\"$\",\"div\",null,{\"className\":\"relative flex-1 mt-6 md:my-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-8\",\"children\":[\"$L24\",[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4 max-w-[750px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-x-8 gap-y-4\",\"children\":[false,[\"$\",\"time\",null,{\"itemProp\":\"datePublished\",\"dateTime\":\"2026-04-23T15:29:07.294Z\",\"className\":\"t-14 opacity-60\",\"children\":\"April 23 2026\"}],\"$undefined\"]}]}],null]}]}]]}]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"padding-section-xsmall container container-628\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-padding\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col w-full gap-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"expand-block\",\"children\":[\"$\",\"$L20\",null,{\"priority\":true,\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/a4db9f4c041e3d0db43192df4a8710fa12b9695a-1920x1080.jpg?rect=1,0,1919,1080\u0026w=1100\u0026h=619\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"w-full rounded\",\"alt\":\"\",\"fill\":\"$undefined\",\"width\":1100,\"height\":1100,\"quality\":\"$undefined\"}]}],null,[\"$\",\"div\",null,{\"className\":\"rich-content news-post-rich-content rich-content-list-styles\",\"itemProp\":\"articleBody\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Nine IO treasury proposals are now with the community for governance review. Each supports a specific body of work with clear ownership, timelines, and a direct link to Cardano’s 2030 vision.\"]}],[\"$\",\"p\",null,{\"children\":[\"Taken together, they reflect two priorities that define this year’s slate: scalability and decentralization. IO is asking for significantly less funding than last year - $46.8m this year, compared with $97.5m last year - while focusing on delivering the final pieces needed to help Cardano scale and transition to a broader, more self-sufficient contributor ecosystem.\"]}],[\"$\",\"p\",null,{\"children\":[\"These proposals also reflect an evolving delivery model. IO is leading and funding this work in 2026 while actively exploring collaboration with selected specialist partners to broaden participation in maintaining and advancing Cardano’s core infrastructure. This approach supports a decentralized, resilient ecosystem in which multiple teams contribute with shared accountability.\"]}],[\"$\",\"p\",null,{\"children\":[\"This is not intended to be a permanent funding model. Each year, the goal is to ask for less from the treasury as more delivery capability moves into a wider network of organizations. \",[\"$\",\"strong\",null,{\"children\":[\"Voting this year helps fund final delivery and supports Cardano’s continued decentralization.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"What follows provides an overview of each proposal and the outcomes it is designed to deliver.\"]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"1. Developer experience\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Led by Robertino Martinez\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"A six-month program to streamline Cardano’s developer tooling, documentation, and onboarding, targeting a 30%+ improvement in developer growth rate.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Cardano’s security model and native asset support have always attracted serious builders. However, its powerful (yet challenging) UTXO model and fragmented tooling ecosystem have never made Cardano the easiest of lifts for new developers.\"]}],[\"$\",\"p\",null,{\"children\":[\"As Cardano's governance model continues to mature and new critical integrations (like USDCx, Pyth, and more) become available, more developers are taking notice. And what turns that interest into shipped products – and the potential for growth these bring – is the experience between 'I want to build here' and 'my DApp is live.'\"]}],[\"$\",\"p\",null,{\"children\":[\"This proposal funds a focused program to address exactly that: improved SDK tooling, consolidated documentation, better error handling and diagnostics, and smoother pathways from prototype to production. The work connects directly to \",[\"$\",\"$L1f\",null,{\"href\":\"https://cbor.io/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"CBOR\"}],\" standardization and contract specification languages.\"]}],[\"$\",\"p\",null,{\"children\":[\"CBOR makes data smaller, faster, and more reliable for computers to process. This helps developers build and run applications on Cardano more efficiently and at lower cost, improving their experience throughout the entire build lifecycle.\"]}],[\"$\",\"p\",null,{\"children\":[\"The goal is measurable: reduced time to first DApp, improved developer satisfaction, and higher conversion from onboarding to active deployment. Consolidating tooling, strengthening documentation, and shortening the path from first contact to a working application will compound across the ecosystem. Each successful deployment becomes a signal that encourages the next developer to build.\"]}],[\"$\",\"p\",null,{\"children\":[\"To further streamline and smooth the developer journey, primary stewardship of developer relations will transition to the Cardano Foundation by the end of 2026. The Foundation's deep community reach and global presence make it the natural long-term home for this work. IO is delivering this year's program while ensuring a strong expansion of relationships, processes, and institutional knowledge.\"]}],[\"$\",\"p\",null,{\"children\":[\"Each developer who ships successfully becomes a signal to the next one.\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/264296fa65097e62b5405cc4fc69815969409d50-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"We talk to developers every week. The ones who stay tell us the same thing: once you understand Cardano, it is the best platform to build on. Our job is to make that 'once you understand' part happen faster.\\\" — Robertino Martinez\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/developer-experience\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"2. Cardano Upgrades\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Led by Alexey Kuleshevich\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Three platform-level enhancements that expand Cardano's economic models and remove onboarding friction: account address upgrades, multi-asset treasury, and Babel Fees.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Three platform-level upgrades aim to expand what builders can do on Cardano: native micro-fee support lets wallets and DApps monetize lightweight user actions at negligible cost, a multi-asset treasury diversifies the protocol's financial reserves beyond ada, and Babel fees complete the picture by letting users pay transaction fees in any native token. Together, these upgrades open up product categories and revenue models that are not yet possible on the network.\"]}],[\"$\",\"p\",null,{\"children\":[\"Multi-asset micro fees (CIP-159) enable wallets and DApps to charge for lightweight user actions in any native asset at negligible cost. The work includes prerequisite LedgerHD changes and targets delivery by Q4 of 2026.\"]}],[\"$\",\"p\",null,{\"children\":[\"The multi-asset treasury (CPS-23) enables the on-chain treasury to hold diversified assets beyond ada, strengthening the protocol's long-term financial sustainability.\"]}],[\"$\",\"p\",null,{\"children\":[\"Babel fees build on the nested transactions framework being delivered in the 2025 proposal cycle, enabling transaction fees to be paid in native tokens other than ada and opening the door to seamless onboarding.\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/a155871a5d26274ef471a6b12665ffb4bab0f3f1-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"CIP-159 is one of those changes where you flip the switch and suddenly a whole generation of product ideas becomes viable. Micro fees sound small. The impact will be anything but.\\\" — Alexey Kuleshevich\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/cardano-upgrades\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"3. Consensus\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Led by Carlos Lopez De Lara and delivered in collaboration with Intersect and a multi-vendor consortium\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Delivering sustainable throughput capacity at the consensus layer. Ships Leios.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"This is the largest technical initiative in the portfolio. It delivers two consensus-layer upgrades that together address Cardano's throughput and settlement speed at the protocol level.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://www.iog.io/news/advancing-ouroboros-leios-as-the-next-leap-in-scalability\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Leios\"}],\" is the primary layer 1 scaling solution. It delivers sustainable throughput capacity through a new consensus mechanism. \",[\"$\",\"strong\",null,{\"children\":[\"The Leios testnet is shipping soon, with mainnet targeted by the end of 2026\"]}],\", and it is considered essential for meeting the 2030 monthly transaction targets. The consortium includes \",[\"$\",\"$L1f\",null,{\"href\":\"https://www.tweag.io/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Tweag\"}],\" (specialized engineering), \",[\"$\",\"$L1f\",null,{\"href\":\"https://txpipe.io/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"TxPipe\"}],\" (infrastructure and tooling), and \",[\"$\",\"$L1f\",null,{\"href\":\"https://www.intersectmbo.org/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Intersect\"}],\" (coordination and governance oversight for the hard fork process). It also reflects the broader delivery direction for Cardano: collaborating with specialist partners to deliver critical infrastructure in a more decentralized way.\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/552cb9af245a2681d51d5b79a081dd1c0f1fe89e-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"We have been researching and prototyping Leios for years. The science is done. Now we deliver it. When this ships, Cardano's throughput story changes permanently.\\\" — Carlos Lopez De Lara\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/consensus\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"4. Layer 2 scalability\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Jointly led by Sharan Koneria and Midgard Labs\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Delivering production-ready L2 infrastructure through Hydra production hardening, Midgard mainnet launch, and shared L2-agnostic primitives, in partnership with Input Output and Midgard Labs.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Cardano's layer 1 excels in security and decentralization, but high-performance use cases like real-time DeFi, AI micropayments, and gaming demand sub-second finality and throughput beyond the capacity of any single base layer. Builders are already choosing platforms based on these capabilities, making layer 2 infrastructure an immediate competitive necessity rather than a future nice-to-have. Layer 2 solutions don't compete with the base layer — they unlock applications that are technically impossible on-chain, keeping that activity within Cardano's ecosystem instead of losing it to competitors.\"]}],[\"$\",\"h3\",null,{\"id\":\"pillar-1-l2-agnostic-infrastructure\",\"children\":[\"Pillar 1: L2-agnostic infrastructure\"]}],[\"$\",\"p\",null,{\"children\":[\"The shared infrastructure every Cardano L2 needs: a data availability strategy that benefits all current and future Cardano L2s. Investing in shared primitives prevents ecosystem fragmentation and solves technical bottlenecks once for the whole ecosystem rather than once per project. This work benefits Hydra, Midgard, and any future Cardano L2.\"]}],[\"$\",\"h3\",null,{\"id\":\"pillar-2-hydra-production-hardening\",\"children\":[\"Pillar 2: Hydra production hardening\"]}],[\"$\",\"p\",null,{\"children\":[\"Hydra has crossed from research to market validation. Delta DeFi, Masumi, and Midgard itself are building on it now. This pillar funds the critical engineering needed to move from a well-tested research protocol to production infrastructure: memory optimization, network performance under load, operational tooling, and pre-built reference stacks for DeFi use cases.\"]}],[\"$\",\"h3\",null,{\"id\":\"pillar-3-midgard-optimistic-rollup\",\"children\":[\"Pillar 3: Midgard optimistic rollup\"]}],[\"$\",\"p\",null,{\"children\":[\"Midgard is Cardano's first truly permissionless optimistic rollup, made uniquely possible by the EUTXO architecture. Unlike Ethereum layer 2 solutions that still operate as custodial multisigs without working fraud proofs, Midgard uses Cardano's local UTXO state to enable single-party fraud proofs in a single layer 1 transaction. The testnet is targeting a release in Q3/Q4 2026.\"]}],[\"$\",\"p\",null,{\"children\":[\"Hydra and Midgard are powerful complementary solutions. They do not ‘compete’. Hydra is purpose-built for known-party, high-frequency environments. Midgard is purpose-built for open, permissionless applications. Together, they give Cardano a credible answer across the full range of high-performance use cases.\"]}],[\"$\",\"p\",null,{\"children\":[\"A dedicated layer 2 scaling entity is being established to take on long-term stewardship of Cardano's layer 2 infrastructure by the end of 2026. IO is looking for funding to deliver and ensure a seamless expansion of engineering, codebases, and roadmaps.\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/636137302a69c44d814597e0be0d8bb22f6d3397-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"The gap between Hydra and Midgard is not an overlap. It is a clean division. Hydra handles known-party, high-frequency use cases. Midgard handles open, permissionless applications. Only with both does Cardano have a credible layer 2 story.\\\" — Sharan Koneria\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/l2-scalability\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"5. Cardano High Assurance\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Led by Stefano Leone\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Delivering automated formal verification and a unified developer toolkit for secure, verifiable smart contract development on Cardano.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Cardano leads the blockchain industry in formal verification: the ability to prove mathematically that a smart contract does exactly what it is supposed to do. This proposal extends that capability from a specialist discipline to an everyday part of building on Cardano.\"]}],[\"$\",\"p\",null,{\"children\":[\"The outcome is compounding. Developers can ship faster with greater confidence and fewer vulnerabilities. Fewer exploits means less lost capital, stronger user trust, and a platform that serious teams and institutions are more willing to build on. Over time, this shifts Cardano from being perceived as ‘high assurance in theory’ to ‘high assurance in practice’ at scale.\"]}],[\"$\",\"p\",null,{\"children\":[\"Four workstreams will deliver it: a universal annotation language connected to CIP-57 and EasySM, a DApp-level verification tooling, an AI-assisted annotation that automates what was previously a manual process, and a pre-configured containerized development environment that removes the setup barrier entirely.\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/51cd63cd57e02b9bbd260f246f1b54035df6027b-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"Cardano's edge has always been correctness. This proposal makes it the default, not an expensive exception. One click, every developer, five languages.\\\" — Stefano Leone\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/cardano-high-assurance\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"6. Maintenance\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Led by Michael Karg, IO\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Core platform maintenance, support, and operational infrastructure for the Cardano network.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Cardano runs billions of dollars in value across thousands of applications globally. This proposal funds the sustained engineering that keeps it performing.\"]}],[\"$\",\"p\",null,{\"children\":[\"Bug fixes, security patches, performance tuning, node operator support, reduced node footprint, and blueprints implementation. Partnership discussions are underway with Bcryptic, Dquadrant, and Quviq for additional engineering and quality assurance capacity.\"]}],[\"$\",\"p\",null,{\"children\":[\"It is the largest line item in the portfolio because every other proposal depends on it. Every stake pool operator, every DApp, every transaction on Cardano runs on what this team delivers.\"]}],[\"$\",\"p\",null,{\"children\":[\"A new dedicated entity will gain stewardship of Cardano's Haskell engineering capability by the end of 2026. The codebase, roadmap, and engineering continuity are preserved. IO is funding this year's work and ensuring a strong foundation for the new entity.\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/ecb90ec607063127843489e67f25824c3608e5cd-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"People ask why maintenance is the biggest line item. The answer is simple: everything else depends on it. Every stake pool operator, every DApp, every transaction on Cardano runs on the work this team does every day.\\\" — Michael Karg\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/cardano-maintenance\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"7. Plutus\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Led by Ziyang Liu and delivered in partnership with VacuumLabs\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Making Cardano's smart-contract platform easier to build on, cheaper to run, and more rigorously verified, delivered as a co-venture between Input Output and VacuumLabs.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Advancing the Plutus platform through developer experience improvements, execution efficiency, and formal specification is a key part of finishing the job on Cardano’s core smart contract layer — ensuring it can scale while remaining secure and accessible to a broader set of developers.\"]}],[\"$\",\"p\",null,{\"children\":[\"Plutus is Cardano's smart contract platform. Three workstreams within a Plutus proposal define the enhancements that are coming next, with a focus on performance, security, and usability.\"]}],[\"$\",\"p\",null,{\"children\":[\"Three areas matter most for governance review.\"]}],[\"$\",\"ul\",null,{\"className\":\"list-disc\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Plutus capabilities and primitives: \"]}],\"casing on the built-in Data type, a set of new powerful primitives enabling cross-chain interoperability, ZK proofs, and efficient list and value operations; investigation into removal of scope check and laziness in UPLC. Together, these changes reduce execution costs and expand what developers can build on Cardano.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Formal specification, correctness, and security: \"]}],\"a property-based conformance testing framework that extends the current test suite, which supports node diversity by enabling alternative Plutus evaluators to verify correctness against the canonical implementation; a systematic security and correctness audit of the security-critical code (such as the Plutus evaluator and costing); and formalization of programmatic built-in types and functions in the Plutus metatheory.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Developer tooling and security: \"]}],\"a new compiler and optimizer architecture that improves code optimization, provides clearer source-level error messages, and reduces boilerplate. It also simplifies setting up the development environment, removing the need for tools like Nix or manual dependency installation, and shortening the path from first contact to a working application.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Stewardship of the Plutus smart contract stack will transition to VacuumLabs by the end of 2026. This reflects the broader direction for Cardano: \",[\"$\",\"strong\",null,{\"children\":[\"moving from a single delivery organization to a network of specialist partners contributing to core infrastructure\"]}],\".\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/aec39e54d90a0f9742803b71e694a23cbb2ce67d-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"We are improving Plutus where it matters most: cheaper execution, more capable primitives, better expressiveness, and easier usability for developers. Strengthening the conformance test suite and the metatheory lets us ship those changes with confidence, especially as alternative node implementations come online.\\\" — Ziyang Liu\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/plutus\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"8. Pogun\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Led by Omer Husain\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"The end-to-end Bitcoin DeFi solution for Cardano.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Bitcoin is the world's most valuable digital asset, and it is almost entirely idle. Pogun positions Cardano to capture the largest open market opportunity in crypto: becoming the dominant credit and liquidity layer for bitcoin.\"]}],[\"$\",\"p\",null,{\"children\":[\"Three integrated components form a single economic engine. A non-margin credit market launches on mainnet in Q2 2026: fully on-chain, oracle-free, with transferable bond tokens that lay the foundation for the first secondary debt market on Cardano. A yield DApp follows in Q3, opening Cardano's credit infrastructure to liquid capital. A BitVM-powered trust-minimized bridge completes the stack in Q4, with a 1-of-N security model for institutional-grade Bitcoin custody.\"]}],[\"$\",\"p\",null,{\"children\":[\"The bridge launches last on purpose: by the time it is live, a working credit market and yield layer are already operational.\"]}],[\"$\",\"p\",null,{\"children\":[\"The treasury ask is structured as an investment, not a grant. 20% of earnings return to the Cardano treasury until full repayment, followed by 5% in perpetuity on Cardano-related products.\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/27f49182a6b44dbdc05de0456cc38dd34e57b5b9-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"We are building the infrastructure that allows Bitcoin to finally operate under the same economic logic that governs mature credit markets: on-chain, non-custodial, and without surrendering the asset.\\\" — Omer Husain\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/pogun\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"9. Blockfrost\"]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":[\"Delivered by the Blockfrost team\"]}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Decentralized data infrastructure that scales with Cardano.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Blockfrost serves approximately 90% of all free-tier API traffic on Cardano. For most builders in the ecosystem, it is simply a matter of how they access blockchain data.\"]}],[\"$\",\"p\",null,{\"children\":[\"This proposal has two components:\"]}],[\"$\",\"ul\",null,{\"className\":\"list-disc\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Project Cayley \"]}],\"is a next-generation decentralized indexing architecture. Rather than requiring every data provider to index the entire blockchain, Cayley enables SPOs and node operators to participate by indexing only the slices they need. Its modular architecture extends to Bitcoin and other ecosystems, positioning Cardano's data infrastructure as a cross-chain utility. Deliverables are dated: Mandoline indexer MVP in Q2 2026, GraphQL API layer in Q3, Bitcoin extension in Q4.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"The operational subsidy \"]}],\"funds the continued running of Blockfrost's community free tier. It covers the engineering team, 24/7 incident response, and the infrastructure required to hold 99.9% uptime.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Open access to blockchain data is a public good. This proposal asks the treasury to share the cost of sustaining it.\"]}],[\"$\",\"figure\",null,{\"className\":\"pt-figure flex flex-col w-full items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-y-2\",\"children\":[[\"$\",\"$L20\",null,{\"src\":\"https://cdn.sanity.io/images/5ro2r81m/production/9d41f47ef3aa9b12d4a5415fbf5d603abf6499d1-3168x1191.jpg?w=3168\u0026h=1191\u0026q=85\u0026auto=format\u0026dpr=2\",\"className\":\"rounded\",\"alt\":\"\\\"We have absorbed the cost of free-tier infrastructure for years because we believe open access to blockchain data is a public good. This proposal asks the treasury to share that responsibility, while we build the decentralized architecture that makes the question of 'who pays' irrelevant.\\\" — Beatrice Anihiri, Blockfrost community manager\",\"fill\":\"$undefined\",\"width\":3168,\"height\":1191,\"quality\":\"$undefined\"}],null]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L1f\",null,{\"href\":\"https://momentum.cardano.iog.io/proposals/blockfrost\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"children\":\"Read the full proposal.\"}]]}],[\"$\",\"h2\",null,{\"id\":\"object-object\",\"children\":[[\"$\",\"strong\",null,{\"children\":[\"What comes next is up to the community\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"These nine proposals are about more than delivery in 2026. Together, they represent a push to finish key pieces of Cardano’s roadmap while moving toward a more decentralized and self-sufficient model for long-term development.\"]}],[\"$\",\"p\",null,{\"children\":[\"Every proposal links to a full treasury submission and an open governance discussion thread. Read the details, ask your questions, and vote informed.\"]}]]}]]}]}]}],null]}],[\"$\",\"section\",null,{\"className\":\"section-light padding-section !pt-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-padding\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-8 sm:gap-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-6 flex-row items-end\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex-1 flex items-end gap-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"tc-title t-46-32-power translate-y-2\",\"children\":\"Related articles\"}],[\"$\",\"div\",null,{\"className\":\"tc-divider hidden flex-1 h-px bg-black/25 min-w-20 md:block\"}]]}],[\"$\",\"div\",null,{\"children\":[\"$\",\"$L1f\",null,{\"className\":\"btn-outline mode-light btn--small\",\"href\":\"/news?type=article\",\"children\":[\"$undefined\",\"$undefined\",[\"$\",\"div\",null,{\"className\":\"btn__wrapper\",\"children\":[[\"$\",\"span\",null,{\"className\":\"btn__text\",\"children\":\"More\"}],[\"$\",\"span\",null,{\"className\":\"btn__text\",\"aria-hidden\":\"tr