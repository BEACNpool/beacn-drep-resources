dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F5ro2r81m%2Fproduction%2Fae4c023b1d949d09c428af4e1626ba2c9271b7f8-3024x1368.jpg%3Fq%3D85%26auto%3Dformat%26dpr%3D2&amp;w=3840&amp;q=75&amp;dpl=dpl_8Hhsy59xdMn8i7WRSTSSU3bot1Bc"/><div class="container"><div class="container-padding padding-section"><div class="border border-white/25 relative z-10 rounded overflow-hidden flex items-center flex-col justify-end md:grid md:grid-rows-1 md:grid-cols-2 [&amp;&gt;div:first-child]:border-white/25 max-md:[&amp;&gt;div:first-child]:border-b max-md:[&amp;&gt;div:only-child]:border-none max-md:[&amp;:has(.tbi-image)&gt;div:not(.tbi-image)]:border-0 max-md:[&amp;:has(.tbi-empty)&gt;div:not(.tbi-empty)]:border-0 max-md:[&amp;:has(.tbi-empty):has(.tbi-image)&gt;div:first-child]:!border-b md:[&amp;&gt;div:first-child]:border-r"><div class="w-full h-full px-6 pt-7 pb-8 xl:p-10 z-10 bg-black/40 backdrop-blur-[25px]"><div class="flex flex-col gap-8 justify-between md:max-w-[34rem] md:min-h-[20rem]"><div class="grid gap-4 text-white"><h2 class="t-46-32-power">Evolving the future</h2><div class="rich-content t-16"><p>Where the world sees broken systems, we see opportunity. Input Output Group was created to rebuild trust with science, purpose, and scale. Our mission has never been about chasing short-term wins. From the beginning, it has been about designing systems that endure.</p></div></div><div class="flex flex-col w-full gap-4"><div><a class="btn-outline mode-dark w-full" href="/about"><span class="sr-only">Our story</span><div class="btn__wrapper"><span class="btn__text">Our story</span><span class="btn__text" aria-hidden="true">Our story</span></div><div class="btn__right-slot"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="-rotate-90"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 1v14m0 0L1 8m7 7 7-7"></path></svg></div></a></