ltiplatform-lib-nodejs":"6.2.0-1","@anastasia-labs/cardano-multiplatform-lib-browser":"6.2.0-1"},"publishConfig":{"access":"public"},"_hasShrinkwrap":false,"devDependencies":{"tsup":"^8.0.2","vitest":"^2.0.4","typescript":"^5.4.5","@types/node":"^20.12.8"},"_npmOperationalInternal":{"tmp":"tmp/scalus-uplc_0.1.0_1780108121478_0.7196074955571752","host":"s3://npm-registry-packages-npm-production"}},"0.1.1":{"name":"@lucid-evolution/scalus-uplc","version":"0.1.1","description":"Scalus-backed local UPLC evaluator adapter for Lucid Evolution","main":"./dist/index.js","types":"./dist/index.d.ts","type":"module","exports":{".":{"types":"./dist/index.d.ts","require":"./dist/index.cjs","import":"./dist/index.js"}},"publishConfig":{"access":"public"},"browser":{"@anastasia-labs/cardano-multiplatform-lib-nodejs":"@anastasia-labs/cardano-multiplatform-lib-browser"},"keywords":["cardano","lucid","scalus","uplc","evaluator"],"author":"","license":"MIT","dependencies":{"@anastasia-labs/cardano-multiplatform-lib-browser":"6.2.0-1","@anastasia-labs/cardano-multiplatform-lib-nodejs":"6.2.0-1","cbor-x":"^1.6.0","scalus":"^0.18.0","@lucid-evolution/core-types":"0.2.1","@lucid-evolution/core-utils":"0.1.16"},"devDependencies":{"@types/node":"^20.12.8","tsup":"^8.0.2","typescript":"^5.4.5","vitest":"^2.0.4"},"scripts":{"build":"tsup src/index.ts --format esm,cjs --dts --clean","lint":"tsc --noEmit","test":"vitest run","clean":"rm -rf .turbo && rm -rf node_modules && rm -rf dist"},"_id":"@lucid-evolution/scalus-uplc@0.1.1","_integrity":"sha512-l7b3s+8WGsKiO42VR1ur9Sm1ZShuwabAkwDRVN1N4r7+rtDS2exHQ8Zecc3bVucHj6mgOsiKQIyX93IWZMKF7A==","_resolved":"/tmp/9655203eebafed68c31e29340393793c/lucid-evolution-scalus-uplc-0.1.1.tgz","_from":"file:lucid-evolution-scalus-uplc-0.1.1.tgz","_nodeVersion":"20.20.2","_npmVersion":"10.8.2","dist":{"integrity":"sha512-l7b3s+8WGsKiO42VR1ur9Sm1ZShuwabAkwDRVN1N4r7+rtDS2exHQ8Zecc3bVucHj6mgOsiKQIyX93IWZMKF7A==","shasum":"1f18c0a1b5e1ed3e942c4950e22f2edaab16056b","tarball":"https://registry.npmjs.org/@lucid-evolution/scalus-uplc/-/scalus-uplc-0.1.1.tgz","fileCount":7,"unpackedSize":20509,"signatures":[{"keyid":"SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U","sig":"MEUCIQC847/wMstjq0FYtfbXt4f5kMTzIUIrm0hWzeTOlS18lgIgM4xpQOy9bWFc/tMNbpbXpHUk83fXcqxsFz20ofWitRs="}]},"_npmUser":{"name":"anastasia-labs","email":"info@anastasialabs.com"},"directories":{},"maintainers":[{"name":"anastasia-labs","email":"info@anastasialabs.com"}],"_npmOperationalInternal":{"host":"s3://npm-registry-packages-npm-production","tmp":"tmp/scalus-uplc_0.1.1_1781375981305_0.8822647851386609"},"_hasShrinkwrap":false}},"time":{"created":"2026-05-30T02:28:41.281Z","modified":"2026-06-13T18:39:41.609Z","0.1.0":"2026-05-30T02:28:41.614Z","0.1.1":"2026-06-13T18:39:41.457Z"},"license":"MIT","keywords":["cardano","lucid","scalus","uplc","evaluator"],"description":"Scalus-backed local UPLC evaluator adapter for Lucid Evolution","maintainers":[{"name":"anastasia-labs","email":"info@anastasialabs.com"}],"readme":"# @lucid-evolution/scalus-uplc\n\nScalus-backed local UPLC evaluator adapter for Lucid Evolution.\n\n```ts\nimport { Lucid } from \"@lucid-evolution/lucid\";\nimport { createScalusEvaluator } from \"@lucid-evolution/scalus-uplc\";\n\nconst lucid = await Lucid(provider, \"Mainnet\", {\n  evaluator: createScalusEvaluator(),\n});\n```\n\nThe configured evaluator is used for local script evaluation. Passing\n`localUPLCEval: false` to `complete` still bypasses every local evaluator and\nforces provider evaluation.\n\n```ts\nconst tx = await lucid\n  .newTx()\n  .collectFrom(utxos, redeemer)\n  .complete({ localUPLCEval: false });\n```\n\nLucid validates adapter results against the transaction's expected redeemer\nset before applying execution units. Missing, duplicate, or unexpected redeemer\nresults fail the build instead of partially mutating the transaction builder.\n","readmeFilename":"README.md"}