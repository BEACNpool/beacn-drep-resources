9T18:02:43Z","browser_download_url":"https://github.com/txpipe/oura/releases/download/v2.0.0/source.tar.gz"},{"url":"https://api.github.com/repos/txpipe/oura/releases/assets/298577755","id":298577755,"node_id":"RA_kwDOGc0B384Ry-9b","name":"source.tar.gz.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":81,"digest":"sha256:cb9d36f20793f949fe2b96672cb585b1eea4c02d919dd43424e6fad83adfbed9","download_count":18,"created_at":"2025-09-29T18:02:43Z","updated_at":"2025-09-29T18:02:43Z","browser_download_url":"https://github.com/txpipe/oura/releases/download/v2.0.0/source.tar.gz.sha256"}],"tarball_url":"https://api.github.com/repos/txpipe/oura/tarball/v2.0.0","zipball_url":"https://api.github.com/repos/txpipe/oura/zipball/v2.0.0","body":"## Release Notes\n\n### 🚀 Features\n\n- Support all record types in terminal sink (#839)\n- Support env filters for tracing output (#877)\n- Introduce ZeroMQ sink (#872)\n- Update mithril-client and aws dependencies (#897)\n\n### 🐛 Bug Fixes\n\n- Make select filter artifacs public for library mode (#892)\n- Support reset events in rollback buffer (#894)\n\n### 🚜 Refactor\n\n- Make config struct fields public (#899)\n\n### 📚 Documentation\n\n- Improve utxorpc source section (#867)\n\n### ⚙️ Miscellaneous Tasks\n\n- Update Pallas to v0.33.0 (#875)\n- Update readme for v2 release (#880)\n- Update readme badges (#881)\n- Tidy up release procedure\n\n## Install oura 2.0.0\n\n### Install prebuilt binaries via shell script\n\n```sh\ncurl --proto '=https' --tlsv1.2 -LsSf https://github.com/txpipe/oura/releases/download/v2.0.0/oura-installer.sh | sh\n```\n\n### Install prebuilt binaries via powershell script\n\n```sh\npowershell -ExecutionPolicy Bypass -c \"irm https://github.com/txpipe/oura/releases/download/v2.0.0/oura-installer.ps1 | iex\"\n```\n\n### Install prebuilt binaries via Homebrew\n\n```sh\nbrew install txpipe/tap/oura\n```\n\n## Download oura 2.0.0\n\n|  File  | Platform | Checksum |\n|--------|----------|----------|\n| [oura-aarch64-apple-darwin.tar.xz](https://github.com/txpipe/oura/releases/download/v2.0.0/oura-aarch64-apple-darwin.tar.xz) | Apple Silicon macOS | [checksum](https://github.com/txpipe/oura/releases/download/v2.0.0/oura-aarch64-apple-darwin.tar.xz.sha256) |\n| [oura-x86_64-pc-windows-msvc.zip](https://github.com/txpipe/oura/releases/download/v2.0.0/oura-x86_64-pc-windows-msvc.zip) | x64 Windows | [checksum](https://github.com/txpipe/oura/releases/download/v2.0.0/oura-x86_64-pc-windows-msvc.zip.sha256) |\n| [oura-aarch64-unknown-linux-gnu.tar.xz](https://github.com/txpipe/oura/releases/download/v2.0.0/oura-aarch64-unknown-linux-gnu.tar.xz) | ARM64 Linux | [checksum](https://github.com/txpipe/oura/releases/download/v2.0.0/oura-aarch64-unknown-linux-gnu.tar.xz.sha256) |\n| [oura-x86_64-unknown-linux-gnu.tar.xz](https://github.com/txpipe/oura/releases/download/v2.0.0/oura-x86_64-unknown-linux-gnu.tar.xz) | x64 Linux | [checksum](https://github.com/txpipe/oura/releases/download/v2.0.0/oura-x86_64-unknown-linux-gnu.tar.xz.sha256) |\n\n\n","reactions":{"url":"https://api.github.com/repos/txpipe/oura/releases/250890700/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0}},{"url":"https://api.github.com/repos/txpipe/oura/releases/227146495","assets_url":"https://api.github.com/repos/txpipe/oura/releases/227146495/assets","upload_url":"https://uploads.github.com/repos/txpipe/oura/releases/227146495/assets{?name,label}","html_url":"https://github.com/txpipe/oura/releases/tag/v1.9.4","id":227146495,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOGc0B384Nifr_","tag_name":"v1.9.4","target_commitish":"main","name":"v1.9.4","draft":false,"immutable":false,"prerelease":false,"created_at":"2025-06-23T16:52:25Z","updated