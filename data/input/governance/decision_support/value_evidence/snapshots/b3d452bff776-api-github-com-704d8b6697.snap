DM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":65,"digest":null,"download_count":5,"created_at":"2023-03-24T23:52:40Z","updated_at":"2023-03-24T23:52:40Z","browser_download_url":"https://github.com/txpipe/oura/releases/download/v2.0.0-alpha.1/oura-x86_64-unknown-linux-gnu.tar.gz.sha256"}],"tarball_url":"https://api.github.com/repos/txpipe/oura/tarball/v2.0.0-alpha.1","zipball_url":"https://api.github.com/repos/txpipe/oura/zipball/v2.0.0-alpha.1","body":"> **Warning**\r\n> this is an _alpha_ pre-release for tech-preview. Don't use in production!\r\n\r\n## [v2.0.0-alpha.1](https://github.com/txpipe/oura/compare/v1.8.1...v2.0.0-alpha.1) (2023-03-23)\r\n\r\n### Features\r\n\r\n* Introduce Deno mapper stage ([#560](https://github.com/txpipe/oura/issues/560))\r\n* Include noop sink\r\n* Implement legacy v1 mapper ([#554](https://github.com/txpipe/oura/issues/554))\r\n* Introduce RabbitMQ sink ([#550](https://github.com/txpipe/oura/issues/550))\r\n* Add filtering by witnesses ([#544](https://github.com/txpipe/oura/issues/544))\r\n* Migrate to new SEDA-based sources ([#481](https://github.com/txpipe/oura/issues/481))\r\n\r\n### Docs\r\n\r\n* Add execution steps to cip68 example\r\n\r\n### Chore\r\n\r\n* Add CIP68 Deno example ([#562](https://github.com/txpipe/oura/issues/562))\r\n* Merge filters and mappers into a single stage ([#561](https://github.com/txpipe/oura/issues/561))\r\n* Unify ops count metric\r\n* Connect full v2 pipeline ([#557](https://github.com/txpipe/oura/issues/557))\r\n* Connect minimal v2 pipeline\r\n* Migrate blockfetch stage to new SEDA version ([#502](https://github.com/txpipe/oura/issues/502))\r\n* Migrate to new SEDA-based chainsync stage ([#501](https://github.com/txpipe/oura/issues/501))\r\n* Migrate new gasket plexer ([#500](https://github.com/txpipe/oura/issues/500))\r\n* Start migration to gasket framework ([#493](https://github.com/txpipe/oura/issues/493))\r\n* Refactor bin entry point ([#483](https://github.com/txpipe/oura/issues/483))\r\n* Re-organize mapper module structure ([#482](https://github.com/txpipe/oura/issues/482))\r\n\r\n"},{"url":"https://api.github.com/repos/txpipe/oura/releases/91362347","assets_url":"https://api.github.com/repos/txpipe/oura/releases/91362347/assets","upload_url":"https://uploads.github.com/repos/txpipe/oura/releases/91362347/assets{?name,label}","html_url":"https://github.com/txpipe/oura/releases/tag/v1.8.1","id":91362347,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-act