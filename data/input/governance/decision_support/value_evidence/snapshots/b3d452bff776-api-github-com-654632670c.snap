s_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":5912880,"digest":"sha256:a3d5a46483112d14e900e5df058099744fcbf6cc497b1991bf4a0cde04e185ee","download_count":6,"created_at":"2025-06-16T13:06:50Z","updated_at":"2025-06-16T13:06:51Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2524.0/mithril-signer_0.2.249%2B7bf7033-1_amd64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/264407806","id":264407806,"node_id":"RA_kwDOGBJN7M4Pwor-","name":"public-key.gpg","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":673,"digest":"sha256:721c119881ac53d65b76654f04bd0176a21dab607fe8a8dae7b8e1e10bdc0835","download_count":9,"created_at":"2025-06-16T13:06:50Z","updated_at":"2025-06-16T13:06:50Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2524.0/public-key.gpg"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/264407811","id":264407811,"node_id":"RA_kwDOGBJN7M4PwosD","name":"VERSION","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":7,"digest":"sha256:3c019ebdcbe9627a4d31a71912787934367218c747df785163e9f8130428af57","download_count":2,"created_at":"2025-06-16T13:06:50Z","updated_at":"2025-06-16T13:06:50Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2524.0/VERSION"}],"tarball_url":"https://api.github.com/repos/input-output-hk/mithril/tarball/2524.0","zipball_url":"https://api.github.com/repos/input-output-hk/mithril/zipball/2524.0","body":"## Highlights\r\n- Support for `Cardano node` `10.4.1` in the signer and the aggregator\r\n- Support for recording client types origin (library, CLI and WASM) in the aggregator metrics.\r\n- **Unstable** support for UTxO-HD snapshot converter `tools utxo-hd snapshot-converter` command in client CLI.\r\n- **Unstable** support for partial cardano database restoration in `cardano-database` command with `--backend v2` parameter.\r\n- Bug fixes and performance improvements.\r\n\r\n## What's Changed\r\n* Fix: websites vulnerabilities by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2453\r\n* test(ci): add ancillary verification key and include ancillary option in `Mithril Client multi-platform test` workflow by @dlachaume in https://github.com/input-output-hk/mithril/pull/2457\r\n* Chore: cleanup `snapshot_store_type` by @dlachaume in https://github.com/input-output-hk/mithril/pull/2456\r\n* Optimize signer and aggregator state machines run interval by @Alenar in https://github.com/input-output-hk/mithril/pull/2454\r\n* Fix: better error handling for era reader adapter parameters in infra by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2452\r\n* Docs: rotate documentation for `2517` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2445\r\n* Docs: final CHANGELOG for `2517.0` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2462\r\n* Docs: add dev blog post for distribution `2517` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2463\r\n* Update examples with separate ancillary download & fix post cdbv2 immutables restored statistic by @Alenar in https://github.com/input-output-hk/mithril/pull/2449\r\n* Feat: extend documentation tool for subcommand configurations by @dlachaume in https://github.com/input-output-hk/mithril/pull/2455\r\n* Fix: Apply hot fix for client restoration by @dlachaume in https://github.com/input-output-hk/mithril/pull/2466\r\n* Set correct package name for mithril-client-cli by @noonio in https://github.com/input-output-hk/mithril/pull/2465\r\n* Docs: add dev blog post for client breaking changes in `2517` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2467\r\n* Docs: add dev blog post for client security advisory by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2469\r\n* Feat: implement signature publisher decorators in signer by @dlachaume in https://github.com/input-output-hk/mithril/pull/2468\r\n* Aggregator: Re-implement the CloudBackendUploader with gcloud-storage crate by @Alenar in https://github.com/input-output-hk/mithril/pull/2475\r\n* Add warning in client about ancillary files by @turmelclem in https://github.com/input-output-hk/mithril/pull/2473\r\n* Chore: update testing ssh keys by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2479\r\n* aggregator: fix setting public access to files uploaded to GCP storage by @Alenar in https://github.com/input-output-hk/mithril/pull/2480\r\n* Docs: update dev blog post for `Cardano DB v2` activation by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2482\r\n* Test: add Cardano node startup check to `Mithril Client multi-platform test` workflow by @dlachaume in https://github.com/input-output-hk/mithril/pull/2476\r\n* Fix: improve error handling in `mithril-install` script by @dlachaume in https://github.com/input-output-hk/mithril/pull/2481\r\n* chore: anticipate rust `1.87` by @Alenar in https://github.com/input-output-hk/mithril/pull/2483\r\n* Feat: implement a signature processor for DMQ by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2477\r\n* Fix: include the two latest ledger state snapshots in the ancillary archive by @dlachaume in https://github.com/input-output-hk/mithril/pull/2484\r\n* Organize STM - Module participant by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2412\r\n* Test: execute full workspace tests on macOS/Windows excluding unsupported packages by @dlachaume in https://github.com/input-output-hk/mithril/pull/2485\r\n* Docs: clarify networks supported Cardano node versions by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2496\r\n* Record signatures origin in the signature processor by @turmelclem in https://github.com/input-output-hk/mithril/pull/2489\r\n* Fix: Simplify `TestHttpServer` `Drop` logic to prevent test flakiness by @dlachaume in https://github.com/input-output-hk/mithril/pull/2495\r\n* Fix: chain reader client cache drop on error by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2501\r\n* feat: read ancillary verification key from both clap arguments and configuration files by @turmelclem in https://github.com/input-output-hk/mithril/pull/2499\r\n* feat: add ancillary verification key in client-cli configuration files by @turmelclem in https://github.com/input-output-hk/mithril/pull/2512\r\n* feat: cleanup unexpected files in immutable folder after download by @Alenar in https://github.com/input-output-hk/mithril/pull/2502\r\n* Fix: display missing logs in `Mithril Client multi-platform test` by @dlachaume in https://github.com/input-output-hk/mithril/pull/2513\r\n* fix(client-cli): improve message format about fast boostrap by @turmelclem in https://github.com/input-output-hk/mithril/pull/2514\r\n* fix: check of unexpected file too eager on all network except devnet by @Alenar in https://github.com/input-output-hk/mithril/pull/2517\r\n* fix: missing `00000` immutable files with Cardano DB v2 by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2520\r\n* feat: support in memory UTxO-HD ledger state snapshots by @Alenar in https://github.com/input-output-hk/mithril/pull/2521\r\n* Feat: support Cardano node `10.4` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2498\r\n* fix(ci): reactivate Darwin `x86_64` build in Hydra CI by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2538\r\n* Chore: update dependencies for distribution `2524` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2544\r\n* Organize STM - Module Single Signature by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2545\r\n* Organize STM - Module Aggregate Signature by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2548\r\n* Feat: add `mithril-client` CLI command for UTxO-HD ledger state snapshot conversion by @dlachaume in https://github.com/input-output-hk/mithril/pull/2518\r\n* Record usage of client type in metrics by @turmelclem in https://github.com/input-output-hk/mithril/pull/2546\r\n* chore(infra): update ssh key for 'testing' by @turmelclem in https://github.com/input-output-hk/mithril/pull/2555\r\n* client-cli: merge cardano-database-v2 command into 'v1' command by @Alenar in https://github.com/input-output-hk/mithril/pull/2547\r\n* fix(ci): temporary enforce `softprops/action-gh-release` v2.2.2 by @Alenar in https://github.com/input-output-hk/mithril/pull/2559\r\n* Allow new header client type by @turmelclem in https://github.com/input-output-hk/mithril/pull/2558\r\n* Feat: documentation and CI tests for UTxO-HD ledger state snapshot conversion `mithril-client` CLI command by @dlachaume in https://github.com/input-output-hk/mithril/pull/2554\r\n* client-lib/client-cli: calibrate max parallel dl by @Alenar in https://github.com/input-output-hk/mithril/pull/2561\r\n* docs: update CHANGELOG for `2524.0` distribution release by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2562\r\n\r\n## New Contributors\r\n* @noonio made their first contribution in https://github.com/input-output-hk/mithril/pull/2465\r\n\r\n**Full Changelog**: https://github.com/input-output-hk/mithril/compare/2517.1...2524.0\r\n\r\n## Crates Versions\r\n|  Crate  |  Version  |\r\n|---------- |-------------|\r\n| mithril-aggregator | `0.7.58` |\r\n| mithril-client | `0.12.11` |\r\n| mithril-client-cli | `0.12.11` |\r\n| mithril-client-wasm | `0.9.1` |\r\n| mithril-common | `0.5.35` |\r\n| mithril-signer | `0.2.249` |\r\n| mithril-stm | `0.4.2` |\r\n\r\n## Networks Compatibility :warning:\r\n|  Network  |  Compatible  |\r\n|---------- |:-------------:|\r\n| release-mainnet | ✔ |\r\n| release-preprod | ✔ |\r\n| pre-release-preview | ✔ |\r\n| testing-preview | ⛔ |\r\n\r\n## Distributions Compatibility :warning:\r\n| Compatibility | mithril-signer | mithril-client |\r\n| --- | :---: | :---: |\r\n| `2517.1` | :heavy_check_mark: | :heavy_check_mark: |\r\n| `2517.0` | :heavy_check_mark: | :heavy_check_mark: |\r\n| `2513.0` | :heavy_check_mark: | :no_entry: |\r\n| `2506.0` | :heavy_check_mark: | :no_entry: |\r\n| `2450.0` | :heavy_check_mark: | :no_entry: |\r\n\r\n## Linux Requirements\r\nThe Linux binaries target `glibc`: to run them or install the `.deb` packages you must have `glibc` version `2.35+` installed.\r\nCompatible systems include, but are not limited to, `Ubuntu 22.04+` or `Debian 12+` (Bookworm)).\r\n\r\n## Verify the authenticity of a downloaded asset\r\n<details><summary>Detailed procedure to verify an asset</summary>\r\n<p>\r\n\r\n* **Step 1**: Identify the downloaded asset on your computer ***YOUR_ASSET_FILE***\r\n* **Step 2**: Download the signed checksum file from this link [CHECKSUM.asc](https://github.com/input-output-hk/mithril/releases/download/2524.0/CHECKSUM.asc) and save it in the same folder as the asset\r\n* **Step 3**: In your terminal, go to the asset folder by running:\r\n```\r\ncd ***YOUR_ASSET_FOLDER***\r\n```\r\n* **Step 4**: Then verify the checksum of the asset by running:\r\n```\r\nsha256sum -c ./CHECKSUM.asc 2>/dev/null | grep ***YOUR_ASSET_FILE***\r\n```\r\nYou must see:\r\n```\r\n./***YOUR_ASSET_FILE***: OK\r\n```\r\n* **Step 5**: Download the public key file from this link [public-key.gpg](https://github.com/input-output-hk/mithril/releases/download/2524.0/public-key.gpg) and save it in the same folder as the asset\r\n* **Step 6**: Then import the GPG public key:\r\n```\r\ngpg --import ./public-key.gpg\r\n```\r\nYou must see something like:\r\n```\r\ngpg: key : public key \"Input Output / Mithril <mithril@iohk.io>\" imported\r\ngpg: Total number processed: 1\r\ngpg:               imported: 1\r\n```\r\n* **Step 7**: Then verify the GPG signature of the checksum file:\r\n```\r\ngpg --verify ./CHECKSUM.asc\r\n```\r\nYou must see something like:\r\n```\r\ngpg: Signature made Mon 05 Dec 2022 04:53:54 PM CET\r\ngpg:                using RSA key 35EDE9D47BBA62A2F388E655899ACD26B8BCA0D2\r\ngpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\" [unknown]\r\ngpg: WARNING: This key is not certified with a trusted signature!\r\ngpg:          There is no indication that the signature belongs to the owner.\r\nPrimary key fingerprint: 35ED E9D4 7BBA 62A2 F388  E655 899A CD26 B8BC A0D2\r\n```\r\nThe signature is valid if and only if:\r\n- there is a line with `gpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\"`\r\n- there is a line with `Primary key fingerprint: 73FC 4C3D FD55 DBDC 428A D2B5 BE04 3B79 FDA4 C2EE`\r\n* **Step 8**:\r\nIf you successfully validated all the steps of this process, then you have successfully verified the authenticity of the asset :heavy_check_mark:\r\nIf not, contact us at [mithril@iohk.io] and let us know of the outcome of your run of this process :warning:\r\n\r\n</p>\r\n</details>\r\n\r\n","reactions":{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/225559459/reactions","total_count":3,"+1":1,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"mentions_count":6},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/224529331","assets_url":"https://api.github.com/repos