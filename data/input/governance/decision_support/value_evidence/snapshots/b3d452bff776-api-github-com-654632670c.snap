bot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":673,"digest":null,"download_count":9,"created_at":"2025-02-14T09:18:36Z","updated_at":"2025-02-14T09:18:36Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2506.0/public-key.gpg"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/229091191","id":229091191,"node_id":"RA_kwDOGBJN7M4Np6d3","name":"VERSION","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":7,"digest":null,"download_count":4,"created_at":"2025-02-14T09:18:36Z","updated_at":"2025-02-14T09:18:36Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2506.0/VERSION"}],"tarball_url":"https://api.github.com/repos/input-output-hk/mithril/tarball/2506.0","zipball_url":"https://api.github.com/repos/input-output-hk/mithril/zipball/2506.0","body":"## Highlights:\r\n- ⚠️ **Security**:\r\n  - This distribution embeds a fix for the **Mithril certificate chain could be manipulated by an adversarial signer** security advisory [GHSA-724h-fpm5-4qvr](https://github.com/input-output-hk/mithril/security/advisories/GHSA-724h-fpm5-4qvr)\r\n  - All users running a **client library, client CLI or client WASM** are **strongly encouraged** to update them to the latest version.\r\n- Stable support for **Cardano node** `10.1.4` in the signer and the aggregator\r\n- Dropped support for `Thales` era in the signer and the aggregator\r\n- Stable support for traffic compression in signer, aggregator and client\r\n- Bug fixes and performance improvements.\r\n\r\n## What's Changed\r\n* feat(ci): include explorer in packaged releases by @Alenar in https://github.com/input-output-hk/mithril/pull/2167\r\n* Fix: recompute certificate chain hash by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2168\r\n* Refactor: rework `snapshot_uploaders` module to improve genericity by @dlachaume in https://github.com/input-output-hk/mithril/pull/2165\r\n* Fix explorer packaging in releases by @Alenar in https://github.com/input-output-hk/mithril/pull/2170\r\n* Docs: enhance recompute certificates hash runbook by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2171\r\n* Feat: retryable `devnet` bootstrap errors in e2e tests by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2179\r\n* Docs: rotate documentation for `2450` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2162\r\n* Docs: final CHANGELOG for '2450.0' distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2182\r\n* Dev blog copy review main branch by @oduameh in https://github.com/input-output-hk/mithril/pull/2169\r\n* Docs: add dev blog post for distribution `2450` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2183\r\n* Build and publish an unstable explorer version by @Alenar in https://github.com/input-output-hk/mithril/pull/2181\r\n* Feat: implement the Ancillary sub builder for Incremental Cardano DB by @dlachaume in https://github.com/input-output-hk/mithril/pull/2180\r\n* Docs: add dev blog post for era switch to `Pythagoras` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2184\r\n* ci: publish packaged explorer in latest release by @Alenar in https://github.com/input-output-hk/mithril/pull/2185\r\n* ci: fix downloading of stable explorer when publishing to pages by @Alenar in https://github.com/input-output-hk/mithril/pull/2186\r\n* Experimental: Cache in client certificate verification (lib and wasm) by @Alenar in https://github.com/input-output-hk/mithril/pull/2166\r\n* Feat: implement `CardanoDatabase` artifact routes by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2187\r\n* feat: extend `Snapshotter` to archive only specific files and directories by @dlachaume in https://github.com/input-output-hk/mithril/pull/2189\r\n* Fix: `CardanoDatabase` artifacts verification in e2e test by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2194\r\n* Feat: add workflows to `Nightly Dispatcher` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2188\r\n* Chore: upgrade dependencies by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2195\r\n* Fix: `CardanoDatabase` artifact identifier collisions by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2198\r\n* Refactor: enhance inputs for nightly workflows by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2200\r\n* Feat: ancillary archive creation by @dlachaume in https://github.com/input-output-hk/mithril/pull/2191\r\n* Fix: nightly dispatcher workflow  by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2201\r\n* Chore: update SSH keys in infra by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2203\r\n* Threat model analysis and blog post review PR by @oduameh in https://github.com/input-output-hk/mithril/pull/2202\r\n* Feat: immutable file digests route for `CardanoDatabase` artifacts aggregator by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2204\r\n* Fix: execute Wasm tests on node in CI by @dlachaume in https://github.com/input-output-hk/mithril/pull/2205\r\n* Chore: clean TODOs in repository by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2206\r\n* Feat: Support Cardano node `10.1.4` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2210\r\n* Docs: dev blog post for activation of the Cardano stake distribution certification  by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2219\r\n* Chore: clean TODOs in repository (second round) by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2220\r\n* Align messages golden master tests by @Alenar in https://github.com/input-output-hk/mithril/pull/2221\r\n* doc: add windows powershell commands in client cli documentation by @Alenar in https://github.com/input-output-hk/mithril/pull/2228\r\n* Fix: missing `DEBUG` logs release builds by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2231\r\n* Feat: Create immutable builder for incremental Cardano DB by @sfauvel in https://github.com/input-output-hk/mithril/pull/2223\r\n* Fix: Signer node properly handles `/register-signatures` responses when the message has expired by @dlachaume in https://github.com/input-output-hk/mithril/pull/2232\r\n* Feat: `GcpUploader` implements synchronization for Cardano database artifacts by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2233\r\n* Fix: support trailing whitespace in protocol key files by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2236\r\n* Chore: upgrade `release-preprod` VM by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2224\r\n* Feat(tests): integration testing for `CardanoDatabase` certification by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2237\r\n* Incremental Cardano DB artifact production enhancements by @Alenar in https://github.com/input-output-hk/mithril/pull/2239\r\n* aggregator: fix flakiness of tests that uses the snapshotter and simplify http server tests by @Alenar in https://github.com/input-output-hk/mithril/pull/2243\r\n* Openapi examples check by @sfauvel in https://github.com/input-output-hk/mithril/pull/2240\r\n* refactor(aggregator): better url sanitization process by using a value object by @Alenar in https://github.com/input-output-hk/mithril/pull/2241\r\n* Feat: compress aggregator HTTP responses by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2226\r\n* split snapshotter by @Alenar in https://github.com/input-output-hk/mithril/pull/2245\r\n* Feat: implement client for `CardanoDatabase` in client library (`list` and `get`) by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2255\r\n* Implement a retry mechanism for the FileUploader by @sfauvel in https://github.com/input-output-hk/mithril/pull/2244\r\n* Permanent storage of immutables trio archives by @Alenar in https://github.com/input-output-hk/mithril/pull/2256\r\n* Feat: implement `CardanoDatabase` in `mithril-client` WASM by @dlachaume in https://github.com/input-output-hk/mithril/pull/2258\r\n* Use tls vendored from reqwest by @Alenar in https://github.com/input-output-hk/mithril/pull/2260\r\n* Do not delete an already existing archive on error by @sfauvel in https://github.com/input-output-hk/mithril/pull/2257\r\n* Refactor: improve variable and function names in fake aggregator by @dlachaume in https://github.com/input-output-hk/mithril/pull/2261\r\n* chore(ci): upgrade workflows running on ubuntu 22.04 to 24.04 by @Alenar in https://github.com/input-output-hk/mithril/pull/2259\r\n* CI: move `notify-on-failure` to a dedicated workflow by @dlachaume in https://github.com/input-output-hk/mithril/pull/2262\r\n* Fix: add missing `workflow_call` trigger on Test Notify on Failure workflow by @dlachaume in https://github.com/input-output-hk/mithril/pull/2267\r\n* docs: update `Pythagoras` era switch dev blog post by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2268\r\n* Monitoring for incremental cardano db by @sfauvel in https://github.com/input-output-hk/mithril/pull/2265\r\n* Feat: Implement `cardano-db-v2` command in client CLI (`list` and `show`) by @dlachaume in https://github.com/input-output-hk/mithril/pull/2266\r\n* explorer: Add cardano db v2 support & rework tabs layout by @Alenar in https://github.com/input-output-hk/mithril/pull/2270\r\n* Fix: use `unstable` Docker image ID in `test-client` workflow instead… by @dlachaume in https://github.com/input-output-hk/mithril/pull/2272\r\n* Chore: add Mithril client CLI version in debug logs by @dlachaume in https://github.com/input-output-hk/mithril/pull/2273\r\n* Remove mithril common circular dependencies and `random` feature by @sfauvel in https://github.com/input-output-hk/mithril/pull/2269\r\n* Add warning for linux requirements upgrade by @Alenar in https://github.com/input-output-hk/mithril/pull/2275\r\n* Add an `era` subcommand to create keypair by @sfauvel in https://github.com/input-output-hk/mithril/pull/2274\r\n* Feat: certify protocol parameters and epoch in certificate chain by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2276\r\n* Restore `release` option for build in Makefile for `aggregator` … by @sfauvel in https://github.com/input-output-hk/mithril/pull/2278\r\n* Chore: upgrade dependencies by @Alenar in https://github.com/input-output-hk/mithril/pull/2279\r\n* Fix: prevent aggregator test conflicts by using unique temporary directories by @dlachaume in https://github.com/input-output-hk/mithril/pull/2280\r\n* Docs: bump minor versions of crates for `2506.0` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2285\r\n* Feat: support compression in HTTP clients by @dlachaume in https://github.com/input-output-hk/mithril/pull/2282\r\n* docs: update era switch dev blog post by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2290\r\n* Fix aggregator stress test by @dlachaume in https://github.com/input-output-hk/mithril/pull/2287\r\n* Docs: update CHANGELOG for `2506.0` distribution release by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2284\r\n\r\n## New Contributors\r\n* @oduameh made their first contribution in https://github.com/input-output-hk/mithril/pull/2169\r\n\r\n**Full Changelog**: https://github.com/input-output-hk/mithril/compare/2450.0...2506.0\r\n\r\n## Crates Versions\r\n|  Crate  |  Version  |\r\n|---------- |-------------|\r\n| mithril-aggregator | `0.7.1` |\r\n| mithril-client | `0.11.1` |\r\n| mithril-client-cli | `0.11.0` |\r\n| mithril-client-wasm | `0.8.1` |\r\n| mithril-common | `0.5.0` |\r\n| mithril-signer | `0.2.228` |\r\n| mithril-stm | `0.3.37` |\r\n\r\n## Networks Compatibility :warning:\r\n|  Network  |  Compatible  |\r\n|---------- |:-------------:|\r\n| release-mainnet | ✔ |\r\n| release-preprod | ✔ |\r\n| pre-release-preview | ✔ |\r\n| testing-preview | ⛔ |\r\n| testing-sanchonet | ⛔ |\r\n\r\n## Distributions Compatibility :warning:\r\n| Compatibility | mithril-signer | mithril-client |\r\n| --- | :---: | :---: |\r\n| `2450.0` | :heavy_check_mark: | :heavy_check_mark: |\r\n| `2445.0` | :heavy_check_mark: | :no_entry: |\r\n| `2442.0` | :heavy_check_mark: | :no_entry: |\r\n\r\n## Linux Requirements\r\nThe Linux binaries target `glibc`: to run them or install the `.deb` packages you must have `glibc` version `2.31+` installed.\r\nCompatible systems include, but are not limited to, `Ubuntu 20.04+` or `Debian 11+` (Bullseye)).\r\n\r\n> [!WARNING]\r\n> From March 2025 onwards, released Linux binaries will have their minimum required  `glibc` version raised to `2.35`.\r\n> Compatible systems include, but are not limited to, `Ubuntu 22.04+` or `Debian 12+` (Bookworm)).\r\n>\r\n> If you are using a system with an older version of `glibc`, you will need to compile the binaries from source.\r\n\r\n## Verify the authenticity of a downloaded asset\r\n<details><summary>Detailed procedure to verify an asset</summary>\r\n<p>\r\n\r\n* **Step 1**: Identify the downloaded asset on your computer ***YOUR_ASSET_FILE***\r\n* **Step 2**: Download the signed checksum file from this link [CHECKSUM.asc](https://github.com/input-output-hk/mithril/releases/download/2506.0/CHECKSUM.asc) and save it in the same folder as the asset\r\n* **Step 3**: In your terminal, go to the asset folder by running:\r\n```\r\ncd ***YOUR_ASSET_FOLDER***\r\n```\r\n* **Step 4**: Then verify the checksum of the asset by running:\r\n```\r\nsha256sum -c ./CHECKSUM.asc 2>/dev/null | grep ***YOUR_ASSET_FILE***\r\n```\r\nYou must see:\r\n```\r\n./***YOUR_ASSET_FILE***: OK\r\n```\r\n* **Step 5**: Download the public key file from this link [public-key.gpg](https://github.com/input-output-hk/mithril/releases/download/2506.0/public-key.gpg) and save it in the same folder as the asset\r\n* **Step 6**: Then import the GPG public key:\r\n```\r\ngpg --import ./public-key.gpg\r\n```\r\nYou must see something like:\r\n```\r\ngpg: key : public key \"Input Output / Mithril <mithril@iohk.io>\" imported\r\ngpg: Total number processed: 1\r\ngpg:               imported: 1\r\n```\r\n* **Step 7**: Then verify the GPG signature of the checksum file:\r\n```\r\ngpg --verify ./CHECKSUM.asc\r\n```\r\nYou must see something like:\r\n```\r\ngpg: Signature made Mon 05 Dec 2022 04:53:54 PM CET\r\ngpg:                using RSA key 35EDE9D47BBA62A2F388E655899ACD26B8BCA0D2\r\ngpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\" [unknown]\r\ngpg: WARNING: This key is not certified with a trusted signature!\r\ngpg:          There is no indication that the signature belongs to the owner.\r\nPrimary key fingerprint: 35ED E9D4 7BBA 62A2 F388  E655 899A CD26 B8BC A0D2\r\n```\r\nThe signature is valid if and only if:\r\n- there is a line with `gpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\"`\r\n- there is a line with `Primary key fingerprint: 73FC 4C3D FD55 DBDC 428A D2B5 BE04 3B79 FDA4 C2EE`\r\n* **Step 8**:\r\nIf you successfully validated all the steps of this process, then you have successfully verified the authenticity of the asset :heavy_check_mark:\r\nIf not, contact us at [mithril@iohk.io] and let us know of the outcome of your run of this process :warning:\r\n\r\n</p>\r\n</details>\r\n\r\n","mentions_count":5},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/199390930","assets_url":"https://api.github.com/repos/input-output-hk/mithril/releases/199390930/assets","upload_url":"https://uploads.github.com/repos/input-output-hk/mithril/releases/199390930/assets{?name,label}","html_url":"https://github.com/input-output-hk/mithril/releases/tag/2506.0-pre","id":199390930,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-