ub.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":5743872,"digest":null,"download_count":3,"created_at":"2024-12-17T08:50:26Z","updated_at":"2024-12-17T08:50:26Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2450.0/mithril-relay_0.1.30%2Bc6c7eba-1_amd64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/213886672","id":213886672,"node_id":"RA_kwDOGBJN7M4Mv6bQ","name":"mithril-signer_0.2.221+c6c7eba-1_amd64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":5589260,"digest":null,"download_count":7,"created_at":"2024-12-17T08:50:26Z","updated_at":"2024-12-17T08:50:26Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2450.0/mithril-signer_0.2.221%2Bc6c7eba-1_amd64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/213886670","id":213886670,"node_id":"RA_kwDOGBJN7M4Mv6bO","name":"public-key.gpg","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":673,"digest":null,"download_count":19,"created_at":"2024-12-17T08:50:26Z","updated_at":"2024-12-17T08:50:26Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2450.0/public-key.gpg"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/213886677","id":213886677,"node_id":"RA_kwDOGBJN7M4Mv6bV","name":"VERSION","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":7,"digest":null,"download_count":4,"created_at":"2024-12-17T08:50:26Z","updated_at":"2024-12-17T08:50:26Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2450.0/VERSION"}],"tarball_url":"https://api.github.com/repos/input-output-hk/mithril/tarball/2450.0","zipball_url":"https://api.github.com/repos/input-output-hk/mithril/zipball/2450.0","body":"## Highlights:\r\n- :fire: **BREAKING** changes in Mithril client library, CLI, and WASM:\r\n  - Remove deprecated `network` field from the internal `CardanoDbBeacon`.\r\n  - The Mithril certificates of type `CardanoImmutableFilesFull` can't be verified anymore with the previous clients.\r\n  - Clients from distribution `2445` and earlier must be updated.\r\n- Stable support for **Cardano node** `10.1.3` in the signer and the aggregator.\r\n- Stable support for one line shell installation script of the Mithril nodes pre-built binaries.\r\n- Bug fixes and performance improvements.\r\n\r\n## What's Changed\r\n* Feat: custom signed entity types in backward compatibility test in CI by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2087\r\n* Do not add unfollow files when commit with upgrade_crates_and_openapi_versions.sh by @sfauvel in https://github.com/input-output-hk/mithril/pull/2088\r\n* Simplify tests by @Alenar in https://github.com/input-output-hk/mithril/pull/2090\r\n* Refactor event message creation by @sfauvel in https://github.com/input-output-hk/mithril/pull/2089\r\n* Feat: add Cardano era retrieval in chain observer implementations by @dlachaume in https://github.com/input-output-hk/mithril/pull/2094\r\n* Docs: rotate documentation for `2445` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2079\r\n* Docs: final CHANGELOG for '2445.0' distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2096\r\n* Docs: dev blog post for aggregator prometheus endpoint by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2095\r\n* chore: add build target nodejs by @fabianbormann in https://github.com/input-output-hk/mithril/pull/2082\r\n* Prepare network removal from `CardanoDbBeacon` by @Alenar in https://github.com/input-output-hk/mithril/pull/2097\r\n* Feat: enhance certificate chain verification by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2098\r\n* Docs: enhance runbook for aggregator metrics and signer registrations by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2099\r\n* Feat: record informations in epoch service for status route by @dlachaume in https://github.com/input-output-hk/mithril/pull/2100\r\n* Docs: reorganize user manual section in docs website by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2102\r\n* Refactor aggregator pruning with upkeep service by @sfauvel in https://github.com/input-output-hk/mithril/pull/2103\r\n* Refactor signer pruning with upkeep service by @sfauvel in https://github.com/input-output-hk/mithril/pull/2108\r\n* Feat: add `genesis generate-keypair` command in aggregator by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2106\r\n* Feat: implement `/status` route to expose aggregator information by @dlachaume in https://github.com/input-output-hk/mithril/pull/2107\r\n* Remove network from `CardanoDbBeacon` by @Alenar in https://github.com/input-output-hk/mithril/pull/2110\r\n* Fix: adjust era offset in `PallasChainObserver` for correct display name by @dlachaume in https://github.com/input-output-hk/mithril/pull/2112\r\n* Add a database migration to remove `network` from cardano immutable files full beacons by @Alenar in https://github.com/input-output-hk/mithril/pull/2113\r\n* Docs: update Protocol Insights Dashboard links by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2119\r\n* Display aggregator status information in explorer by @Alenar in https://github.com/input-output-hk/mithril/pull/2128\r\n* Fix for Failing STM Proptests by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2125\r\n* fix(aggregator): properly handle `404` errors in http server by @Alenar in https://github.com/input-output-hk/mithril/pull/2130\r\n* Docs: dev blog post about new `Protocol Insights Dashboard` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2127\r\n* Explorer: Easier, more cohesive, aggregator controls by @Alenar in https://github.com/input-output-hk/mithril/pull/2132\r\n* CI: add workflow dispatcher for nightly GitHub workflows by @dlachaume in https://github.com/input-output-hk/mithril/pull/2131\r\n* Get rid of store adapter in signer by @sfauvel in https://github.com/input-output-hk/mithril/pull/2126\r\n* Docs: protocol security page on documentation website by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2133\r\n* Feat: one line installation script for Mithril nodes by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2136\r\n* Client wasm multiple targets by @Alenar in https://github.com/input-output-hk/mithril/pull/2135\r\n* Docs: dev blog post for one line installer by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2139\r\n* Also bump versions of js packages in upgrade version script by @Alenar in https://github.com/input-output-hk/mithril/pull/2137\r\n* fix(ci): fix generation of swagger-ui page by @Alenar in https://github.com/input-output-hk/mithril/pull/2141\r\n* Feat: create new signed entity type for Incremental Cardano DB by @dlachaume in https://github.com/input-output-hk/mithril/pull/2142\r\n* Get rid of store adapter in aggregator by @sfauvel in https://github.com/input-output-hk/mithril/pull/2143\r\n* Fix Rust 1.83 clippy warnings by @Alenar in https://github.com/input-output-hk/mithril/pull/2148\r\n* Cardano network on aggregator status and explorer by @Alenar in https://github.com/input-output-hk/mithril/pull/2149\r\n* Chore: update aggregator in examples by @dlachaume in https://github.com/input-output-hk/mithril/pull/2150\r\n* Feat: support retries in e2e tests in CI by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2145\r\n* Feat: implement signable builder for incremental Cardano DB by @dlachaume in https://github.com/input-output-hk/mithril/pull/2146\r\n* Fix: GPG verification command of released artifact by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2155\r\n* Chore: upgrade to cardano node `10.1.3` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2158\r\n* Feat: add execute rights on pre-built binaries in CI by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2156\r\n* Feat: implement artifact builder for `CardanoDatabase` by @dlachaume in https://github.com/input-output-hk/mithril/pull/2159\r\n* Docs: reorganize `About Mithril` section in docs website by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2160\r\n* Chore: update dependencies for distribution `2450` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2157\r\n* Accelerate signer fixtures creation in tests by @sfauvel in https://github.com/input-output-hk/mithril/pull/2161\r\n* Chore: update dependencies for distribution `2450` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2164\r\n* Docs: update CHANGELOG for `2450.0` distribution release by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2163\r\n\r\n## New Contributors\r\n* @fabianbormann made their first contribution in https://github.com/input-output-hk/mithril/pull/2082\r\n\r\n**Full Changelog**: https://github.com/input-output-hk/mithril/compare/2445.0...2450.0\r\n\r\n## Crates Versions\r\n|  Crate  |  Version  |\r\n|---------- |-------------|\r\n| mithril-aggregator | `0.6.0` |\r\n| mithril-client | `0.10.4` |\r\n| mithril-client-cli | `0.10.5` |\r\n| mithril-client-wasm | `0.7.2` |\r\n| mithril-common | `0.4.96` |\r\n| mithril-signer | `0.2.221` |\r\n| mithril-stm | `0.3.34` |\r\n\r\n## Networks Compatibility :warning:\r\n|  Network  |  Compatible  |\r\n|---------- |:-------------:|\r\n| release-mainnet | ✔ |\r\n| release-preprod | ✔ |\r\n| pre-release-preview | ✔ |\r\n| testing-preview | ⛔ |\r\n| testing-sanchonet | ⛔ |\r\n\r\n## Distributions Compatibility :warning:\r\n| Compatibility | mithril-signer | mithril-client |\r\n| --- | :---: | :---: |\r\n| `2445.0` | :heavy_check_mark: | :no_entry: |\r\n| `2442.0` | :heavy_check_mark: | :no_entry: |\r\n| `2437.1` | :heavy_check_mark: | :no_entry: |\r\n\r\n## Linux Requirements\r\nThe Linux binaries target `glibc`: to run them or install the `.deb` packages you must have `glibc` version `2.31+` installed.\r\nCompatible systems include, but are not limited to, `Ubuntu 20.04+` or `Debian 11+` (Bullseye)).\r\n\r\n## Verify the authenticity of a downloaded asset\r\n> [!WARNING]\r\n> `mithril-explorer-2450.0.tar.gz` checksum isn't included in the provided `CHECKSUM.asc`, it will be added with the next distribution.\r\n\r\n<details><summary>Detailed procedure to verify an asset</summary>\r\n<p>\r\n\r\n* **Step 1**: Identify the downloaded asset on your computer ***YOUR_ASSET_FILE***\r\n* **Step 2**: Download the signed checksum file from this link [CHECKSUM.asc](https://github.com/input-output-hk/mithril/releases/download/2450.0/CHECKSUM.asc) and save it in the same folder as the asset\r\n* **Step 3**: In your terminal, go to the asset folder by running:\r\n```\r\ncd ***YOUR_ASSET_FOLDER***\r\n```\r\n* **Step 4**: Then verify the checksum of the asset by running:\r\n```\r\nsha256sum -c ./CHECKSUM.asc 2>/dev/null | grep ***YOUR_ASSET_FILE***\r\n```\r\nYou must see:\r\n```\r\n./***YOUR_ASSET_FILE***: OK\r\n```\r\n* **Step 5**: Download the public key file from this link [public-key.gpg](https://github.com/input-output-hk/mithril/releases/download/2450.0/public-key.gpg) and save it in the same folder as the asset\r\n* **Step 6**: Then import the GPG public key:\r\n```\r\ngpg --import ./public-key.gpg\r\n```\r\nYou must see something like:\r\n```\r\ngpg: key : public key \"Input Output / Mithril <mithril@iohk.io>\" imported\r\ngpg: Total number processed: 1\r\ngpg:               imported: 1\r\n```\r\n* **Step 7**: Then verify the GPG signature of the checksum file:\r\n```\r\ngpg --verify ./CHECKSUM.asc\r\n```\r\nYou must see something like:\r\n```\r\ngpg: Signature made Mon 05 Dec 2022 04:53:54 PM CET\r\ngpg:                using RSA key 35EDE9D47BBA62A2F388E655899ACD26B8BCA0D2\r\ngpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\" [unknown]\r\ngpg: WARNING: This key is not certified with a trusted signature!\r\ngpg:          There is no indication that the signature belongs to the owner.\r\nPrimary key fingerprint: 35ED E9D4 7BBA 62A2 F388  E655 899A CD26 B8BC A0D2\r\n```\r\nThe signature is valid if and only if:\r\n- there is a line with `gpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\"`\r\n- there is a line with `Primary key fingerprint: 73FC 4C3D FD55 DBDC 428A D2B5 BE04 3B79 FDA4 C2EE`\r\n* **Step 8**:\r\nIf you successfully validated all the steps of this process, then you have successfully verified the authenticity of the asset :heavy_check_mark:\r\nIf not, contact us at [mithril@iohk.io] and let us know of the outcome of your run of this process :warning:\r\n\r\n</p>\r\n</details>\r\n\r\n","reactions":{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/191109545/reactions","total_count":5,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":2,"eyes":0},"mentions_count":6},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/190153091","assets_url":"https://api.github.com/repos/input-output-hk/mithril/releases/190153091/assets","upload_url":"https://uploads.github.com/repos/input-output-hk/mithril/releases/190153091/assets{?name,label}","html_url":"https://github.com/input-output-hk/mithril/releases/tag/2450.0-pre","id":190153091,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://a