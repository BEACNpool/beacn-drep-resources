},"content_type":"application/gzip","state":"uploaded","size":6474371,"digest":"sha256:3842b199c7cdf610df56d6ac235b590182a3e45f2f58da5088ee0a2a22e06169","download_count":1,"created_at":"2025-06-16T13:06:50Z","updated_at":"2025-06-16T13:06:51Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2524.0/mithril-2524.0-windows-x64.tar.gz"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/264407815","id":264407815,"node_id":"RA_kwDOGBJN7M4PwosH","name":"mithril-aggregator_0.7.58+7bf7033-1_amd64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":8878340,"digest":"sha256:117685ea04c5b10e138adc87d48b3474d35a0531d0f283e1baa082fd8936f4bc","download_count":4,"created_at":"2025-06-16T13:06:50Z","updated_at":"2025-06-16T13:06:51Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2524.0/mithril-aggregator_0.7.58%2B7bf7033-1_amd64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/264407807","id":264407807,"node_id":"RA_kwDOGBJN7M4Pwor_","name":"mithril-client-cli_0.12.11+7bf7033-1_amd64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":5542572,"digest":"sha256:654b50de191b9984a5b37687b72c7ad27ac5aea101c2396bd68fd981f654ddf9","download_count":35,"created_at":"2025-06-16T13:06:50Z","updated_at":"2025-06-16T13:06:51Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2524.0/mithril-client-cli_0.12.11%2B7bf7033-1_amd64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/264407816","id":264407816,"node_id":"RA_kwDOGBJN7M4PwosI","name":"mithril-explorer-2524.0.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/gzip","state":"uploaded","size":1379495,"digest":"sha256:6b08df38eae3ab242b5fcfb835f3027b1bc3554835f7a92a604ab945847db6e2","download_count":79,"created_at":"2025-06-16T13:06:50Z","updated_at":"2025-06-16T13:06:50Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2524.0/mithril-explorer-2524.0.tar.gz"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/264407809","id":264407809,"node_id":"RA_kwDOGBJN7M4PwosB","name":"mithril-relay_0.1.43+7bf7033-1_amd64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5