ons_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-debian-package","state":"uploaded","size":5988732,"digest":"sha256:ebe40c83396d4557085339e41c19b3165301004c2b584cb07e17ccdf6f4d4ce0","download_count":60,"created_at":"2026-01-29T14:13:37Z","updated_at":"2026-01-29T14:13:38Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2603.1/mithril-signer_0.3.7%2B567a8e8-1_amd64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/347698330","id":347698330,"node_id":"RA_kwDOGBJN7M4UuXSa","name":"mithril-signer_0.3.7+567a8e8-1_arm64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-debian-package","state":"uploaded","size":5763288,"digest":"sha256:6740fac2a18b0a2d3fa1a34c05f4b43c7905c8edfd782dd59af55765a01f8e2a","download_count":5,"created_at":"2026-01-29T14:13:37Z","updated_at":"2026-01-29T14:13:38Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2603.1/mithril-signer_0.3.7%2B567a8e8-1_arm64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/347698322","id":347698322,"node_id":"RA_kwDOGBJN7M4UuXSS","name":"public-key.gpg","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":673,"digest":"sha256:721c119881ac53d65b76654f04bd0176a21dab607fe8a8dae7b8e1e10bdc0835","download_count":15,"created_at":"2026-01-29T14:13:37Z","updated_at":"2026-01-29T14:13:37Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2603.1/public-key.gpg"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/347698335","id":347698335,"node_id":"RA_kwDOGBJN7M4UuXSf","name":"VERSION","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":7,"digest":"sha256:453129ff97f6cbde79dd5f9580090fd98bd28d10c24052f2fc320b25903c791a","download_count":5,"created_at":"2026-01-29T14:13:37Z","updated_at":"2026-01-29T14:13:37Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2603.1/VERSION"}],"tarball_url":"https://api.github.com/repos/input-output-hk/mithril/tarball/2603.1","zipball_url":"https://api.github.com/repos/input-output-hk/mithril/zipball/2603.1","body":"## Highlights\r\n- **Breaking Changes**: Progress bars and spinners now output to `stderr` instead of `stdout` in Mithril client CLI\r\n- **Deprecations**: Deprecated `cardano_db` function in library/WASM; removed `snapshot` function from `Client` struct; deprecated `--backend v1` flag in CLI (use `--backend v2` instead)\r\n- **Decentralization Support**: New `/protocol-configuration/{epoch}` route for fetching aggregator configuration; refactored signer and aggregator to read network configurations from `MithrilNetworkConfigurationProvider`; follower aggregators can now read configurations from leader aggregator\r\n- **Miscellaneous**: Replaced CExplorer API with Blockfrost API for pool names/tickers discovery; support for new Lagrange Mithril era; bug fixes and performance improvements\r\n- **Unstable**: DMQ protocol support in signer, aggregator and relay; aggregator discovery mechanism in client library and CLI.\r\n\r\n## What's Changed\r\n* Decentralization of configuration parameters phase 1 - new aggregator route by @turmelclem in https://github.com/input-output-hk/mithril/pull/2741\r\n* fix: Rust `1.91` clippy warnings by @Alenar in https://github.com/input-output-hk/mithril/pull/2757\r\n* refactor: use shared aggregator client for signer and aggregrator by @Alenar in https://github.com/input-output-hk/mithril/pull/2755\r\n* docs: rotate documentation for `2543` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2748\r\n* docs: final CHANGELOG for '2543.0' distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2751\r\n* docs: add dev blog posts for distribution `2543` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2752\r\n* ci: enhance npm publish workflow by @Alenar in https://github.com/input-output-hk/mithril/pull/2753\r\n* docs: update blog post distribution 2543 by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2774\r\n* fix: apply hotfix of `2345.1-hotfix` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2773\r\n* fix: install on aarch64 by @SupernaviX in https://github.com/input-output-hk/mithril/pull/2776\r\n* fix: syntax error in shell script by @SupernaviX in https://github.com/input-output-hk/mithril/pull/2777\r\n* refactor(signer): split signer aggregator client into several small business services by @Alenar in https://github.com/input-output-hk/mithril/pull/2775\r\n* Decentralization of configuration parameters phase 1 - Aggregator local parameters by @turmelclem in https://github.com/input-output-hk/mithril/pull/2736\r\n* chore: remove uneeded crates type from most `Cargo.toml` by @Alenar in https://github.com/input-output-hk/mithril/pull/2783\r\n* ci(test-client): check fast bootstrap after lmdb conversion by @Alenar in https://github.com/input-output-hk/mithril/pull/2778\r\n* chore(ci): upgrade actions versions by @Alenar in https://github.com/input-output-hk/mithril/pull/2784\r\n* fix(ci): support hotfix branches in backcompat workflow by @Alenar in https://github.com/input-output-hk/mithril/pull/2787\r\n* fix: docs and explorer websites vulnerabilities by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2788\r\n* Stm error handling with anyhow by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2765\r\n* refactor: support optional cardano transaction signing config by @Alenar in https://github.com/input-output-hk/mithril/pull/2789\r\n* Implementation of Schnorr signature module for mithril-stm. by @damrobi in https://github.com/input-output-hk/mithril/pull/2761\r\n* ci: add a backward compatibility checks to the end-to-end runner by @Alenar in https://github.com/input-output-hk/mithril/pull/2816\r\n* feat: stabilize cardano database v2 - phase4 by @Alenar in https://github.com/input-output-hk/mithril/pull/2819\r\n* SNARK-friendly STM: Re-organize modules by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2804\r\n* chore: update signed entity type timeouts by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2829\r\n* fix: websites vulnerabilities by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2834\r\n* feat: stabilize cardano database v2 - phase4 - wasm client by @Alenar in https://github.com/input-output-hk/mithril/pull/2821\r\n* fix: client wasm ci-test using removed `snapshot` function by @Alenar in https://github.com/input-output-hk/mithril/pull/2840\r\n* feat: create new `Lagrange` Mithril era by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2839\r\n* fix: explorer dependency vulnerability by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2841\r\n* feat: prepare aggregator client usage in mithril client and publication by @Alenar in https://github.com/input-output-hk/mithril/pull/2842\r\n* fix: wrong output type for `GetCardanoDatabaseListQuery` by @Alenar in https://github.com/input-output-hk/mithril/pull/2843\r\n* feat: simple aggregator discovery by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2779\r\n* fix: add missing published crates in CI by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2846\r\n* refactor(mithril-client-library): switch http backend to new shared `mithril-aggregator-client` by @Alenar in https://github.com/input-output-hk/mithril/pull/2847\r\n* ci: Check external crates licenses compatibility by @Alenar in https://github.com/input-output-hk/mithril/pull/2848\r\n* fix(ci): crates already published guard was not working by @Alenar in https://github.com/input-output-hk/mithril/pull/2849\r\n* ci: accelerate hydra ci by @Alenar in https://github.com/input-output-hk/mithril/pull/2851\r\n* fix: Rust `1.92` clippy warnings by @Alenar in https://github.com/input-output-hk/mithril/pull/2853\r\n* feat(client-cli): add cardano docker run command to snapshot converter output by @Alenar in https://github.com/input-output-hk/mithril/pull/2852\r\n* ci(client multiplatform test): add a new download + conversion case for conversion to legacy legder snapshot by @Alenar in https://github.com/input-output-hk/mithril/pull/2854\r\n* Moving mithril-stm errors into corresponding module by @damrobi in https://github.com/input-output-hk/mithril/pull/2850\r\n* chore: enhance and align usage of the anyhow across crates by @Alenar in https://github.com/input-output-hk/mithril/pull/2858\r\n* feat: support Haskell DMQ node pool id authentication by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2859\r\n* feat: activate DMQ protocol by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2862\r\n* enhance errors context by @Alenar in https://github.com/input-output-hk/mithril/pull/2863\r\n* SNARK-friendly STM: Remove basic verifier by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2845\r\n* feat: add \"total successful\" metrics for signature and signer registrations by @Alenar in https://github.com/input-output-hk/mithril/pull/2865\r\n* fix: avoid DMQ node flooding on consumer error by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2868\r\n* SNARK-friendly STM: Revise Generic Digest to support multiple hash functions by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2864\r\n* fix: KES signer period by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2867\r\n* SNARK-friendly STM: jubjub wrapper by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2828\r\n* Golden Tests for Merkle Tree Batch Commitment by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2874\r\n* SNARK-friendly STM: Support multiple Merkle Tree leaves by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2866\r\n* Golden Tests for Single Signature by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2877\r\n* fix: better support for signature registration errors in aggregator signature processor by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2873\r\n* doc: add DMQ node setup in Mithril signer guide by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2872\r\n* doc: add aggregator setup guide by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2876\r\n* refactor: introduce `KesEvolutions` type by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2869\r\n* SNARK-friendly STM: Remove Deprecated Items by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2881\r\n* SNARK-friendly STM: Single signature of concatenation proof by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2875\r\n* feat: use final DMQ magic numbers by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2885\r\n* docs: add dev blog post for multiple aggregators testing program by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2884\r\n* docs: add dev blog post for DMQ testing program with SPOs by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2883\r\n* ci: fix aggregator stress test parameters handling by @Alenar in https://github.com/input-output-hk/mithril/pull/2900\r\n* Golden test for Closed Key Registration by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2901\r\n* feat: use released Haskell DMQ node in e2e tests by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2902\r\n* fix(cli): handle file write errors in verification report by @leepl37 in https://github.com/input-output-hk/mithril/pull/2899\r\n* ci: optimize rust test disk space usage by @Alenar in https://github.com/input-output-hk/mithril/pull/2916\r\n* feat(aggregator): replace cexplorer pools ticker retriever with a blockfrost based implementation by @Alenar in https://github.com/input-output-hk/mithril/pull/2896\r\n* feat: add `ConfigSecret` type and use it for aggregator blockfrost configuration by @Alenar in https://github.com/input-output-hk/mithril/pull/2919\r\n* Golden test for avk by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2904\r\n* chore: update dependencies for distribution `2603` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2920\r\n* Rename mithril-stm schnorr module by @damrobi in https://github.com/input-output-hk/mithril/pull/2903\r\n* refactor(client): optimize uncompressed file download using io::copy by @leepl37 in https://github.com/input-output-hk/mithril/pull/2921\r\n* feat: add debug DMQ message ids by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2923\r\n* feat: add new `CardanoBlocksTransactions` to `SignedEntityTypes` by @Alenar in https://github.com/input-output-hk/mithril/pull/2922\r\n* feat: DMQ node infrastructure  by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2870\r\n* fix: activation of P2P DMQ protocol in infra by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2927\r\n* chore: enhance DMQ messages and Single Signature logs in aggregator by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2928\r\n* refactor(signer): add test module by @Alenar in https://github.com/input-output-hk/mithril/pull/2929\r\n* Change jubjub and poseidon backend from Dusk to MidnightZK by @damrobi in https://github.com/input-output-hk/mithril/pull/2898\r\n* chore: enhance Docker logs rotation in infra by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2931\r\n* refactor(aggregator/relay): enhance json body parsing by @Alenar in https://github.com/input-output-hk/mithril/pull/2933\r\n* fix: anticipate Rust `1.93` clippy warnings by @Alenar in https://github.com/input-output-hk/mithril/pull/2934\r\n* refactor: Shared transaction importer for signer and aggregator by @Alenar in https://github.com/input-output-hk/mithril/pull/2930\r\n* feat: update protocol parameters for dev networks by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2926\r\n* chore(ci): activate `future_snark` testing for `mithril-stm` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2935\r\n* fix: add DMQ client abort after submission in publisher by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2939\r\n* fix(infra): do not delete the `ipc` folder of DMQ node by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2941\r\n* docs: update CHANGELOG with `2603.0` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2925\r\n* chore(ci): update protocol parameters of `testing-preview` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2937\r\n* fix(signer): does not send its api version header by @Alenar in https://github.com/input-output-hk/mithril/pull/2949\r\n* docs: update CHANGELOG with `2603.1` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2950\r\n\r\n## New Contributors\r\n* @SupernaviX made their first contribution in https://github.com/input-output-hk/mithril/pull/2776\r\n\r\n**Full Changelog**: https://github.com/input-output-hk/mithril/compare/2543.1-hotfix...2603.1\r\n\r\n## Crates Versions\r\n|  Crate  |  Version  |\r\n|---------- |-------------|\r\n| mithril-aggregator | `0.8.14` |\r\n| mithril-client | `0.13.2` |\r\n| mithril-client-cli | `0.12.38` |\r\n| mithril-client-wasm | `0.9.11` |\r\n| mithril-common | `0.6.43` |\r\n| mithril-signer | `0.3.7` |\r\n| mithril-stm | `0.9.5` |\r\n\r\n## Networks Compatibility :warning:\r\n|  Network  |  Compatible  |\r\n|---------- |:-------------:|\r\n| release-mainnet | ✔ |\r\n| release-preprod | ✔ |\r\n| pre-release-preview | ✔ |\r\n| testing-preview | ⛔ |\r\n\r\n## Cardano Node Compatibility\r\n\r\n| Network | Mithril Aggregator | Mithril Signer |\r\n|---------- |:-------------: |:-------------: |\r\n| release-mainnet | Cardano `10.4.1+`<sup>(*)</sup> | Cardano `10.4.1+`<sup>(*)</sup> |\r\n| release-preprod | Cardano `10.4.1+`<sup>(*)</sup> | Cardano `10.4.1+`<sup>(*)</sup> |\r\n| pre-release-preview | Cardano `10.4.1+`<sup>(*)</sup> | Cardano `10.4.1+`<sup>(*)</sup> |\r\n| testing-preview | Cardano `10.4.1+`<sup>(*)</sup> | Cardano `10.4.1+`<sup>(*)</sup> |\r\n\r\n<sup>*</sup>: Up to the latest Cardano node version released at the time of this release.\r\n\r\n## Distributions Compatibility :warning:\r\n| Compatibility | mithril-signer | mithril-client |\r\n| --- | :---: | :---: |\r\n| `2543.1-hotfix` | :heavy_check_mark: | :heavy_check_mark: |\r\n| `25374.0` | :heavy_check_mark: | :heavy_check_mark: |\r\n| `2524.0` | :heavy_check_mark: | :heavy_check_mark: |\r\n| `2517.1` | :heavy_check_mark: | :heavy_check_mark: |\r\n\r\n## Platform Support\r\n\r\nSummary of the platforms for which pre-built binaries are provided.\r\n\r\n| Binary             | Linux x64 | Linux arm64 | macOS arm64 | Windows x64 |\r\n| ------------------ | :-------: | :---------: | :---------: | :---------: |\r\n| mithril-aggregator |     ✔     |   ✔ ⁽\\*⁾    |     ⛔      |     ⛔      |\r\n| mithril-signer     |     ✔     |   ✔ ⁽\\*⁾    |     ⛔      |     ⛔      |\r\n| mithril-client     |     ✔     |   ✔ ⁽\\*⁾    |      ✔      |      ✔      |\r\n\r\n⁽\\*⁾⚠️ Linux arm64 builds are provided on a best-effort basis and are not officially supported.\r\n\r\n### Linux Requirements\r\nThe Linux binaries target `glibc`: to run them or install the `.deb` packages you must have `glibc` version `2.35+` installed.\r\nCompatible systems include, but are not limited to, `Ubuntu 22.04+` or `Debian 12+` (Bookworm)).\r\n\r\n## Download a binary asset\r\nTo simplify the installation and updating of Mithril binaries, we have created a one line installer that downloads and installs the Mithril binaries for you.\r\nThis installer is available for Linux and macOS and supports the Mithril signer, Mithril aggregator, and Mithril client CLI.\r\n\r\nUse the following commands to install the Mithril nodes:\r\n\r\n- Download the **Mithril signer** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-signer -d 2603.1 -p $(pwd)\r\n```\r\n\r\n- Download the **Mithril client CLI** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-client -d 2603.1 -p $(pwd)\r\n```\r\n\r\n- Download the **Mithril aggregator** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-aggregator -d 2603.1 -p $(pwd)\r\n```\r\n\r\n## Verify the authenticity of a downloaded asset\r\n<details><summary>Detailed procedure to verify an asset</summary>\r\n<p>\r\n\r\n* **Step 1**: Identify the downloaded asset on your computer ***YOUR_ASSET_FILE***\r\n* **Step 2**: Download the signed checksum file from this link [CHECKSUM.asc](https://github.com/input-output-hk/mithril/releases/download/2603.1/CHECKSUM.asc) and save it in the same folder as the asset\r\n* **Step 3**: In your terminal, go to the asset folder by running:\r\n```\r\ncd ***YOUR_ASSET_FOLDER***\r\n```\r\n* **Step 4**: Then verify the checksum of the asset by running:\r\n```\r\nsha256sum -c ./CHECKSUM.asc 2>/dev/null | grep ***YOUR_ASSET_FILE***\r\n```\r\nYou must see:\r\n```\r\n./***YOUR_ASSET_FILE***: OK\r\n```\r\n* **Step 5**: Download the public key file from this link [public-key.gpg](https://github.com/input-output-hk/mithril/releases/download/2603.1/public-key.gpg) and save it in the same folder as the asset\r\n* **Step 6**: Then import the GPG public key:\r\n```\r\ngpg --import ./public-key.gpg\r\n```\r\nYou must see something like:\r\n```\r\ngpg: key : public key \"Input Output / Mithril <mithril@iohk.io>\" imported\r\ngpg: Total number processed: 1\r\ngpg:               imported: 1\r\n```\r\n* **Step 7**: Then verify the GPG signature of the checksum file:\r\n```\r\ngpg --verify ./CHECKSUM.asc\r\n```\r\nYou must see something like:\r\n```\r\ngpg: Signature made Mon 05 Dec 2022 04:53:54 PM CET\r\ngpg:                using RSA key 35EDE9D47BBA62A2F388E655899ACD26B8BCA0D2\r\ngpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\" [unknown]\r\ngpg: WARNING: This key is not certified with a trusted signature!\r\ngpg:          There is no indication that the signature belongs to the owner.\r\nPrimary key fingerprint: 35ED E9D4 7BBA 62A2 F388  E655 899A CD26 B8BC A0D2\r\n```\r\nThe signature is valid if and only if:\r\n- there is a line with `gpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\"`\r\n- there is a line with `Primary key fingerprint: 73FC 4C3D FD55 DBDC 428A D2B5 BE04 3B79 FDA4 C2EE`\r\n* **Step 8**:\r\nIf you successfully validated all the steps of this process, then you have successfully verified the authenticity of the asset :heavy_check_mark:\r\nIf not, contact us at [mithril@iohk.io] and let us know of the outcome of your run of this process :warning:\r\n\r\n</p>\r\n</details>\r\n\r\n\r\n## Download a Docker image\r\nYou can directly pull prebuilt Mithril Docker images:\r\n\r\n| Binary             |              Image name              |                             URL                              |\r\n| ------------------ | :----------------------------------: | :----------------------------------------------------------: |\r\n| mithril-aggregator | mithril-aggregator:2603.1-567a8e8 | ghcr.io/input-output-hk/mithril-aggregator:2603.1-567a8e8 |\r\n| mithril-signer     |   mithril-signer:2603.1-567a8e8   |   ghcr.io/input-output-hk/mithril-signer:2603.1-567a8e8   |\r\n| mithril-client     |   mithril-client:2603.1-567a8e8   |   ghcr.io/input-output-hk/mithril-client:2603.1-567a8e8   |\r\n","reactions":{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/281130737/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"mentions_count":7},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/279297699","assets_url":"ht