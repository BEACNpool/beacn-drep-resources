2cfb263669f024e2d96167b6a86664d2733a9a3f92aadb53ada22f777be0d8","download_count":16,"created_at":"2026-04-23T07:56:08Z","updated_at":"2026-04-23T07:56:09Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2617.0/mithril-signer_1.0.0%2B2478748-1_amd64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/403227109","id":403227109,"node_id":"RA_kwDOGBJN7M4YCMHl","name":"mithril-signer_1.0.0+2478748-1_arm64.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-debian-package","state":"uploaded","size":4568264,"digest":"sha256:aacc68ec634c02bc02575487d9ce931d894ca7cf8f589860f5dfc094cf2e313d","download_count":5,"created_at":"2026-04-23T07:56:08Z","updated_at":"2026-04-23T07:56:09Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2617.0/mithril-signer_1.0.0%2B2478748-1_arm64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/403227094","id":403227094,"node_id":"RA_kwDOGBJN7M4YCMHW","name":"public-key.gpg","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":673,"digest":"sha256:721c119881ac53d65b76654f04bd0176a21dab607fe8a8dae7b8e1e10bdc0835","download_count":20,"created_at":"2026-04-23T07:56:08Z","updated_at":"2026-04-23T07:56:08Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2617.0/public-key.gpg"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/403227106","id":403227106,"node_id":"RA_kwDOGBJN7M4YCMHi","name":"VERSION","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":7,"digest":"sha256:c019585d7a8315d3b39ec4cc9cfbe2e4b30cf40ea6f11bf9446ea14c375db282","download_count":3,"created_at":"2026-04-23T07:56:08Z","updated_at":"2026-04-23T07:56:08Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2617.0/VERSION"}],"tarball_url":"https://api.github.com/repos/input-output-hk/mithril/tarball/2617.0","zipball_url":"https://api.github.com/repos/input-output-hk/mithril/zipball/2617.0","body":"## Highlights\r\n- ⚠️ **Warning**: this distribution will reset the `cardano-transaction` database of the signer and the aggregator, and a new full scan of the Cardano chain will be triggered\r\n- **Breaking Changes**: Removed the `v1` backend of Cardano database from the Mithril client CLI and library (use `v2` backend instead)\r\n- **Cardano Node Support**: Added support for Cardano node `10.6.2` and `10.7.1` in the signer, aggregator, and client. Cardano node `11.0.1` is also supported\r\n- **Stable Signer Release**: Bumped the Mithril signer to version `1.0.0`, marking it as production-ready on the `release-mainnet` network\r\n- **Static Builds**: All nodes are now statically built using the `musl` target on GitHub and Hydra CI pipelines (`glibc` no longer required).\r\n\r\n## What's Changed\r\n* fix(signer): avoid panic on invalid signed_beacon id by @leepl37 in https://github.com/input-output-hk/mithril/pull/2940\r\n* core(stm/snark): integrate certificate circuit prototype as it is (future_snark) by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/2938\r\n* feat(stm): Implementation of the digest trait for the Poseidon hash from Midnight by @damrobi in https://github.com/input-output-hk/mithril/pull/2936\r\n* SNARK-friendly STM: New Key Registration by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2880\r\n* refactor: SNARK-friendly version of Aggregate Verification Key  by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2951\r\n* fix(signer): avoid sqlite bind panic by @leepl37 in https://github.com/input-output-hk/mithril/pull/2953\r\n* feat(stm): Merkle Tree Leaf for Snark proof by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2957\r\n* docs: rotate documentation for `2603` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2924\r\n* docs: final CHANGELOG for `2603.1` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2962\r\n* docs: add dev blog posts for distribution `2603` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2965\r\n* feat: also import blocks into cardano database when importing data from chain by @Alenar in https://github.com/input-output-hk/mithril/pull/2960\r\n* refactor(stm): Remove possibility of panic during conversion from `KeyRegistration` to `MerkleTree`  by @damrobi in https://github.com/input-output-hk/mithril/pull/2959\r\n* feat(stm): Implementing pre-aggregation primitives and fixes by @damrobi in https://github.com/input-output-hk/mithril/pull/2964\r\n* docs(website): fix `k` protocol parameter description by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2975\r\n* feat: optional throttling when reading blocks from the chain  by @Alenar in https://github.com/input-output-hk/mithril/pull/2966\r\n* Implement artifacts builder for cardano blocks and transactions by @turmelclem in https://github.com/input-output-hk/mithril/pull/2963\r\n* Update 2026-01-29-distribution-2603.md by @olgahryniuk in https://github.com/input-output-hk/mithril/pull/2986\r\n* fix: synchronization from incomplete certificate chain in follower aggregator by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2978\r\n* feat: implement a DMQ consumer deduplicator by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2977\r\n* test(snark): Golden tests for the STM Halo2 circuit by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/2968\r\n* implement artifact rest api routes for cardano blocks and transactions by @turmelclem in https://github.com/input-output-hk/mithril/pull/2980\r\n* refactor: preliminary works before addition of `CardanoBlocksTransactions` signable builder by @Alenar in https://github.com/input-output-hk/mithril/pull/2992\r\n* fix: DMQ publisher error on rejected local submission response by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2972\r\n* fix(devnet): Docker images by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2996\r\n* fix(stm): Fix the implementation difference for schnorr signature between cpu and circuit by @damrobi in https://github.com/input-output-hk/mithril/pull/2994\r\n* feat: add Copilot review guidelines in CI by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2999\r\n* feat: compute and persist blocks transactions block range roots by @Alenar in https://github.com/input-output-hk/mithril/pull/2995\r\n* implement signing configuration for cardano blocks and transactions by @turmelclem in https://github.com/input-output-hk/mithril/pull/2991\r\n* feat(stm): SNARK Key registration by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2976\r\n* feat: support Cardano node `10.6` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2838\r\n* fix(ci): correct file name for Copilot review instructions by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3006\r\n* ci: fix publish to crates and package promote to npm by @Alenar in https://github.com/input-output-hk/mithril/pull/3007\r\n* feat: add cardano blocks transactions signable builder by @Alenar in https://github.com/input-output-hk/mithril/pull/3003\r\n* refactor(snark): remove halo2/off-circuit and switch to STM types by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3002\r\n* feat(stm): Computation of the target value for the SNARK lottery by @damrobi in https://github.com/input-output-hk/mithril/pull/2979\r\n* fix:  snapshot converter breaking change since cardano version 10.6.2 by @turmelclem in https://github.com/input-output-hk/mithril/pull/3014\r\n* feat: update protocol parameters for release/pre-release networks by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3019\r\n* chore: update dependencies for distribution `2608` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3018\r\n* fix: panic at startup in aggregator by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3024\r\n* fix: panic at startup in aggregator v2 by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3025\r\n* feat(stm): Add from_raw conversion function for BaseFieldElement by @damrobi in https://github.com/input-output-hk/mithril/pull/3027\r\n* fix(persistence): avoid hitting SQLite limits when doing blocks and transactions bulk storage by @Alenar in https://github.com/input-output-hk/mithril/pull/3045\r\n* Remove legacy db restauration message for version 10.6.2 and upper by @turmelclem in https://github.com/input-output-hk/mithril/pull/3044\r\n* perf: tune cardano blocks and transactions import throttling by @Alenar in https://github.com/input-output-hk/mithril/pull/3048\r\n* fix: flakiness in STM tests with `future_snark` in CI by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3026\r\n* fix: add timeout to Pallas `chainsync` calls in Pallas chain reader by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3052\r\n* perf: optimize blocks and transactons retrieval from sqlite by @Alenar in https://github.com/input-output-hk/mithril/pull/3057\r\n* feat(aggregator): implement v2 routes for cardano transaction and block proofs(#2988) by @leepl37 in https://github.com/input-output-hk/mithril/pull/3005\r\n* refactor(stm): Fix the number of iterations for lottery target computation by @damrobi in https://github.com/input-output-hk/mithril/pull/3046\r\n* feat: authenticated SNARK signer registration by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3016\r\n* feat: support aggregator capabilities in aggregator discovery by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2844\r\n* test(stm): add negative single-signature tests by @leepl37 in https://github.com/input-output-hk/mithril/pull/2985\r\n* feat(ci): manually trigger `Pre-Release` and `Release` workflows by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3059\r\n* refactor(stm): align circuit domain separation tags by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3051\r\n* refactor: rework sqlite connection pool by @Alenar in https://github.com/input-output-hk/mithril/pull/3060\r\n* fix: apply `cargo sort -w` formatting following its 2.1 version by @Alenar in https://github.com/input-output-hk/mithril/pull/3064\r\n* docs: fix DMQ setup documentation by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3063\r\n* feat(stm): Signer and Signature for SNARK Proof System by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3009\r\n* refactor(stm): error handling by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3055\r\n* fix: apply `cargo sort -w` following release of version `2.1.1` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3077\r\n* refactor(stm): Ensuring type consistency for SNARK circuit by @damrobi in https://github.com/input-output-hk/mithril/pull/3071\r\n* refactor+test: prover preparatory work by @Alenar in https://github.com/input-output-hk/mithril/pull/3072\r\n* perf: fix cardano blocks with transactions retrieval in `mainnet` network by @Alenar in https://github.com/input-output-hk/mithril/pull/3081\r\n* refactor(halo2): Decouple circuit from Midnight types by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3076\r\n* feat(stm): Compute the Lottery Target Value in `MerkleTreeSnarkLeaf` by @damrobi in https://github.com/input-output-hk/mithril/pull/3082\r\n* refactor(halo2): align circuit's naming to STM by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3084\r\n* feat: SNARK-friendly certificate chain by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3073\r\n* feat: add \"v2\" prover for blocks and transactions by @Alenar in https://github.com/input-output-hk/mithril/pull/3085\r\n* docs: add dev blog post about new mainnet protocol parameters by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3087\r\n* feat(stm): Prepare Prover Witness by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3075\r\n* infra: upgrade `pre-release-preview` and `dev-preview` VM by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3092\r\n* feat: upgrade DMQ node to `0.3.0.0-pre` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3086\r\n* refactor(halo2): modularity enhancement by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3089\r\n* feat: implement static builds for Mithril nodes in CI by @turmelclem in https://github.com/input-output-hk/mithril/pull/2998\r\n* perf: add prover v2 benchmark script by @Alenar in https://github.com/input-output-hk/mithril/pull/3094\r\n* feat(stm): Create SNARK proof with circuit by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3093\r\n* feat(halo2): switch Halo2 transcript hash to Poseidon by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3096\r\n* feat: avoid storage and diffusion of unconsistent network configuration and epoch settings by @Alenar in https://github.com/input-output-hk/mithril/pull/3095\r\n* implement list of transactions proofs and artifacts v2 in client by @turmelclem in https://github.com/input-output-hk/mithril/pull/3083\r\n* feat(stm): Verify SNARK proof by @damrobi in https://github.com/input-output-hk/mithril/pull/3090\r\n* feat(client): decommission Cardano DB v1 backend in client library and CLI by @leepl37 in https://github.com/input-output-hk/mithril/pull/3088\r\n* fix: diffusion of inconsistents network configs from leader aggregator by @Alenar in https://github.com/input-output-hk/mithril/pull/3111\r\n* feat: upgrade DMQ node to `0.3.0.1` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3108\r\n* fix(stm): fixed `compute_snark_avk` test taking too long by @damrobi in https://github.com/input-output-hk/mithril/pull/3109\r\n* Implement examples for block and transactions by @turmelclem in https://github.com/input-output-hk/mithril/pull/3102\r\n* feat: wire SNARK proof in aggregate signature by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3103\r\n* feat: deploy SNARK prover in `dev` networks by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3105\r\n* feat: upgrade release process by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3113\r\n* implement cardano blocks and transaction in client CLI by @turmelclem in https://github.com/input-output-hk/mithril/pull/3112\r\n* chore: upgrade reqwest to `0.13` by @Alenar in https://github.com/input-output-hk/mithril/pull/3117\r\n* support backward compatilibity for cardano-transaction command in end-to-end test by @turmelclem in https://github.com/input-output-hk/mithril/pull/3118\r\n* feat: support SNARK proof generation by @damrobi in https://github.com/input-output-hk/mithril/pull/3115\r\n* explorer: upgrade, fix lints and most vulnerabilities by @Alenar in https://github.com/input-output-hk/mithril/pull/3166\r\n* feat: upgrade DMQ node to `0.4.1.0` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3170\r\n* feat: support partial block ranges for blocks transactions certifications by @Alenar in https://github.com/input-output-hk/mithril/pull/3116\r\n* Sign security parameter offset by @turmelclem in https://github.com/input-output-hk/mithril/pull/3168\r\n* feat: add feature-gated halo2_ivc prototype module by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3171\r\n* refactor: add versioned CBOR codec to STM by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3169\r\n* Fix block depth in certify subcommands table result and JSON by @turmelclem in https://github.com/input-output-hk/mithril/pull/3175\r\n* feat: Mithril/Cardano bundle Docker image by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3177\r\n* feat(client-cli): add feedbacks for blocks and transactions certification commands by @Alenar in https://github.com/input-output-hk/mithril/pull/3182\r\n* refactor: remove minimal `-1` offset from blocks transactions beacon computation by @Alenar in https://github.com/input-output-hk/mithril/pull/3176\r\n* fix(nix): nix check CA certificates failures by @Alenar in https://github.com/input-output-hk/mithril/pull/3184\r\n* feat(explorer): add support for cardano blocks transactions without certification by @Alenar in https://github.com/input-output-hk/mithril/pull/3181\r\n* fix: unstable signed entity hash computation by @Alenar in https://github.com/input-output-hk/mithril/pull/3185\r\n* refactor(stm): Sync non-recursive circuit, reduce bit length of `lower_than` by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3174\r\n* feat(nix): add Windows x86_64 cross-compilation by @disassembler in https://github.com/input-output-hk/mithril/pull/3167\r\n* Implement cardano blocks and transactions in WASM client by @turmelclem in https://github.com/input-output-hk/mithril/pull/3179\r\n* docs: update Cardano Docker bundle runbook by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3188\r\n* feat: support for Cardano `10.7` snapshot converter by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3186\r\n* feat: upgrade DMQ node to `0.4.2.0` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3197\r\n* feat: support for Cardano `10.7` ledger state snapshot structure by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3180\r\n* fix: anticipate Rust `1.95` clippy warnings by @Alenar in https://github.com/input-output-hk/mithril/pull/3201\r\n* Run cardano transaction v2 and cardano block commands in CI by @turmelclem in https://github.com/input-output-hk/mithril/pull/3198\r\n* feat: support for Cardano `10.7` configuration by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3187\r\n* docs: add documentation for Cardano Blocks and Transactions in website by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3203\r\n* feature: cardano blocks transactions certification in explorer by @Alenar in https://github.com/input-output-hk/mithril/pull/3207\r\n* fix: e2e compatibility rules for Cardano `10.7` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3209\r\n* chore: update dependencies for distribution `2617` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3214\r\n* refactor(end-to-end): read transaction and block hashes from immutables files by @turmelclem in https://github.com/input-output-hk/mithril/pull/3208\r\n* chore: make signer stable with `1.0.0` version by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3219\r\n* fix: conversion of ledger state snapshot to LSM flavour by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3220\r\n* refactor(stm): Enhance selection in witness prep by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3190\r\n* Add golden tests for IVC by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3204\r\n* docs: update CHANGELOG with `2617.0` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3021\r\n\r\n## New Contributors\r\n* @hjeljeli32 made their first contribution in https://github.com/input-output-hk/mithril/pull/2938\r\n* @disassembler made their first contribution in https://github.com/input-output-hk/mithril/pull/3167\r\n\r\n**Full Changelog**: https://github.com/input-output-hk/mithril/compare/2603.1...2617.0\r\n\r\n## Crates Versions\r\n|  Crate  |  Version  |\r\n|---------- |-------------|\r\n| mithril-aggregator | `0.8.47` |\r\n| mithril-client | `0.14.5` |\r\n| mithril-client-cli | `0.13.9` |\r\n| mithril-client-wasm | `0.10.4` |\r\n| mithril-common | `0.6.67` |\r\n| mithril-signer | `1.0.0` |\r\n| mithril-stm | `0.10.5` |\r\n\r\n## Networks Compatibility :warning:\r\n|  Network  |  Compatible  |\r\n|---------- |:-------------:|\r\n| release-mainnet | ✔ |\r\n| release-preprod | ✔ |\r\n| pre-release-preview | ✔ |\r\n| testing-preview | ⛔ |\r\n\r\n## Cardano Node Compatibility\r\n\r\n| Network | Mithril Aggregator | Mithril Signer |\r\n|---------- |:-------------: |:-------------: |\r\n| release-mainnet | Cardano `10.6.2+`<sup>(*)</sup> | Cardano `10.6.2+`<sup>(*)</sup> |\r\n| release-preprod | Cardano `10.6.2+`<sup>(*)</sup> | Cardano `10.6.2+`<sup>(*)</sup> |\r\n| pre-release-preview | Cardano `10.6.2+`<sup>(*)</sup> | Cardano `10.6.2+`<sup>(*)</sup> |\r\n| testing-preview | Cardano `10.6.2+`<sup>(*)</sup> | Cardano `10.6.2+`<sup>(*)</sup> |\r\n\r\n<sup>*</sup>: Up to the latest Cardano node version released at the time of this release.\r\n\r\n## Platform Support\r\n\r\nSummary of the platforms for which pre-built binaries are provided.\r\n\r\n| Binary             | Linux x64 | Linux arm64 | macOS arm64 | Windows x64 |\r\n| ------------------ | :-------: | :---------: | :---------: | :---------: |\r\n| mithril-aggregator |     ✔     |   ✔ ⁽\\*⁾    |     ⛔      |     ⛔      |\r\n| mithril-signer     |     ✔     |   ✔ ⁽\\*⁾    |     ⛔      |     ⛔      |\r\n| mithril-client     |     ✔     |   ✔ ⁽\\*⁾    |      ✔      |      ✔      |\r\n\r\n⁽\\*⁾⚠️ Linux arm64 builds are provided on a best-effort basis and are not officially supported.\r\n\r\n\r\n## Download a binary asset\r\nTo simplify the installation and updating of Mithril binaries, we have created a one line installer that downloads and installs the Mithril binaries for you.\r\nThis installer is available for Linux and macOS and supports the Mithril signer, Mithril aggregator, and Mithril client CLI.\r\n\r\nUse the following commands to install the Mithril nodes:\r\n\r\n- Download the **Mithril signer** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-signer -d 2617.0 -p $(pwd)\r\n```\r\n\r\n- Download the **Mithril client CLI** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-client -d 2617.0 -p $(pwd)\r\n```\r\n\r\n- Download the **Mithril aggregator** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-aggregator -d 2617.0 -p $(pwd)\r\n```\r\n\r\n## Verify the authenticity of a downloaded asset\r\n<details><summary>Detailed procedure to verify an asset</summary>\r\n<p>\r\n\r\n* **Step 1**: Identify the downloaded asset on your computer ***YOUR_ASSET_FILE***\r\n* **Step 2**: Download the signed checksum file from this link [CHECKSUM.asc](https://github.com/input-output-hk/mithril/releases/download/2617.0/CHECKSUM.asc) and save it in the same folder as the asset\r\n* **Step 3**: In your terminal, go to the asset folder by running:\r\n```\r\ncd ***YOUR_ASSET_FOLDER***\r\n```\r\n* **Step 4**: Then verify the checksum of the asset by running:\r\n```\r\nsha256sum -c ./CHECKSUM.asc 2>/dev/null | grep ***YOUR_ASSET_FILE***\r\n```\r\nYou must see:\r\n```\r\n./***YOUR_ASSET_FILE***: OK\r\n```\r\n* **Step 5**: Download the public key file from this link [public-key.gpg](https://github.com/input-output-hk/mithril/releases/download/2617.0/public-key.gpg) and save it in the same folder as the asset\r\n* **Step 6**: Then import the GPG public key:\r\n```\r\ngpg --import ./public-key.gpg\r\n```\r\nYou must see something like:\r\n```\r\ngpg: key : public key \"Input Output / Mithril <mithril@iohk.io>\" imported\r\ngpg: Total number processed: 1\r\ngpg:               imported: 1\r\n```\r\n* **Step 7**: Then verify the GPG signature of the checksum file:\r\n```\r\ngpg --verify ./CHECKSUM.asc\r\n```\r\nYou must see something like:\r\n```\r\ngpg: Signature made Mon 05 Dec 2022 04:53:54 PM CET\r\ngpg:                using RSA key 35EDE9D47BBA62A2F388E655899ACD26B8BCA0D2\r\ngpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\" [unknown]\r\ngpg: WARNING: This key is not certified with a trusted signature!\r\ngpg:          There is no indication that the signature belongs to the owner.\r\nPrimary key fingerprint: 35ED E9D4 7BBA 62A2 F388  E655 899A CD26 B8BC A0D2\r\n```\r\nThe signature is valid if and only if:\r\n- there is a line with `gpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\"`\r\n- there is a line with `Primary key fingerprint: 73FC 4C3D FD55 DBDC 428A D2B5 BE04 3B79 FDA4 C2EE`\r\n* **Step 8**:\r\nIf you successfully validated all the steps of this process, then you have successfully verified the authenticity of the asset :heavy_check_mark:\r\nIf not, contact us at [mithril@iohk.io] and let us know of the outcome of your run of this process :warning:\r\n\r\n</p>\r\n</details>\r\n\r\n\r\n## Download a Docker image\r\nYou can directly pull prebuilt Mithril Docker images:\r\n\r\n| Binary             |              Image name              |                             URL                              |\r\n| ------------------ | :----------------------------------: | :----------------------------------------------------------: |\r\n| mithril-aggregator | mithril-aggregator:2617.0-2478748 | ghcr.io/input-output-hk/mithril-aggregator:2617.0-2478748 |\r\n| mithril-signer     |   mithril-signer:2617.0-2478748   |   ghcr.io/input-output-hk/mithril-signer:2617.0-2478748   |\r\n| mithril-client     |   mithril-client:2617.0-2478748   |   ghcr.io/input-output-hk/mithril-client:2617.0-2478748   |\r\n","reactions":{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/312600690/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"mentions_count":9},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/281130737","assets_url":"https://api.github.com/repos/input-output-hk/mithril/releases/281130737/assets","upload_url":"https://uploads.github.com/repos/input-output-hk/mithril/releases/281130737/assets{?name,label}","html_url":"https://github.com/input-output-hk/mithril/releases/tag/2603.1","id":281130737,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"htt