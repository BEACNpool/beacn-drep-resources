size":5786464,"digest":"sha256:9772144f11f631664298bab78c9a4be72b52c2f34ab034d887909d561da40aa4","download_count":2,"created_at":"2025-09-11T08:52:48Z","updated_at":"2025-09-11T08:52:49Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2537.0-pre/mithril-signer_0.2.268%2B6a7107e-1_arm64.deb"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/292071900","id":292071900,"node_id":"RA_kwDOGBJN7M4RaKnc","name":"public-key.gpg","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":673,"digest":"sha256:721c119881ac53d65b76654f04bd0176a21dab607fe8a8dae7b8e1e10bdc0835","download_count":73,"created_at":"2025-09-11T08:52:48Z","updated_at":"2025-09-11T08:52:48Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2537.0-pre/public-key.gpg"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/292071901","id":292071901,"node_id":"RA_kwDOGBJN7M4RaKnd","name":"VERSION","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":11,"digest":"sha256:d4b5dd3df638948455049cfaf123ee4ed08ee0e70d7aa256b777321c7ba78280","download_count":69,"created_at":"2025-09-11T08:52:48Z","updated_at":"2025-09-11T08:52:48Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/2537.0-pre/VERSION"}],"tarball_url":"https://api.github.com/repos/input-output-hk/mithril/tarball/2537.0-pre","zipball_url":"https://api.github.com/repos/input-output-hk/mithril/zipball/2537.0-pre","body":"## Highlight\r\n- Support for `Cardano node` `10.5.1` in the signer and the aggregator\r\n- Support for stable `cardano_database_v2` backend in the `mithril-client` library\r\n- Support for stable `v2` backend of `cardano-db` command and decommission of  `cardano-db-v2` command in client CLI\r\n- Support for stable `verify` command to verify an existing Cardano database in the client CLI\r\n- Support for stable UTxO-HD snapshot converter `tools utxo-hd snapshot-converter` command in client CLI\r\n- Support for pre-built Linux ARM binaries for the signer, client CLI, and aggregator\r\n- Support for the Rust `2024` edition (from `2021` edition)\r\n- Bug fixes and performance improvements.\r\n\r\n## What's Changed\r\n* Organize STM - Module Parameters by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2553\r\n* fix: rename artifact on wasm test failure in `Mithril Client multi-platform test` workflow. by @dlachaume in https://github.com/input-output-hk/mithril/pull/2566\r\n* fix: bytes codec in STM library by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2556\r\n* feat(mithril-client lib): stabilize cardano-database-v2 by @Alenar in https://github.com/input-output-hk/mithril/pull/2563\r\n* Split `mithril-common` phase 2: extract Mithril ticker by @Alenar in https://github.com/input-output-hk/mithril/pull/2565\r\n* Split `mithril-common` phase 2: extract Mithril era by @Alenar in https://github.com/input-output-hk/mithril/pull/2569\r\n* Split `mithril-common` phase 2: extract Mithril cardano node chain by @Alenar in https://github.com/input-output-hk/mithril/pull/2570\r\n* ci: add `--locked` to clippy in check step by @Alenar in https://github.com/input-output-hk/mithril/pull/2573\r\n* feat: revise OpenAPI compatibility enforcement by @dlachaume in https://github.com/input-output-hk/mithril/pull/2572\r\n* docs: rotate documentation for `2524` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2564\r\n* docs: final CHANGELOG for '2524.0' distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2575\r\n* docs: add dev blog post for distribution `2524` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2576\r\n* Docs: add blog post for UTxO-HD ledger state snapshot conversion by @dlachaume in https://github.com/input-output-hk/mithril/pull/2560\r\n* chore: bump `mithril-stm` dependency version constraint in `mithril-common` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2584\r\n* fix: add missing `.md` file extension by @dlachaume in https://github.com/input-output-hk/mithril/pull/2587\r\n* Docs: dev blog post for Cardano database backend switch by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2583\r\n* fix(ci): publish of wasm packages to npm when Cargo.toml version dont match package.json by @Alenar in https://github.com/input-output-hk/mithril/pull/2588\r\n* docs: update post for UTxO-HD ledger state snapshot converter by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2591\r\n* feat: support bytes codec in `ProtocolKey` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2557\r\n* feat: enhance `tools utxo-hd snapshot-converter` Mithril client CLI command by @dlachaume in https://github.com/input-output-hk/mithril/pull/2589\r\n* ci: split Cardano DB download and ledger state snapshot conversion in `test-docker` job by @dlachaume in https://github.com/input-output-hk/mithril/pull/2592\r\n* Adding command to verify cardano database by @turmelclem in https://github.com/input-output-hk/mithril/pull/2574\r\n* Split `mithril-common` phase 2: extract Mithril cardano node internal database by @Alenar in https://github.com/input-output-hk/mithril/pull/2586\r\n* Split `mithril-common` phase 2: extract Mithril api spec by @Alenar in https://github.com/input-output-hk/mithril/pull/2593\r\n* Split `mithril-common` phase 2: extract Mithril test http server by @Alenar in https://github.com/input-output-hk/mithril/pull/2594\r\n* Remove cardano-db-v2 and make cardano-db --backend v2 stable by @turmelclem in https://github.com/input-output-hk/mithril/pull/2595\r\n* prettier 3.6 by @Alenar in https://github.com/input-output-hk/mithril/pull/2601\r\n* filip(feat): docs site redesign by @fstoqnov-iohk in https://github.com/input-output-hk/mithril/pull/2597\r\n* aggregator: add `/certificate/genesis` endpoint by @Alenar in https://github.com/input-output-hk/mithril/pull/2600\r\n* ci: reactivate `action-gh-release` v2 in CI and pre-release workflows by @dlachaume in https://github.com/input-output-hk/mithril/pull/2603\r\n* chore: anticipate rust `1.88` by @Alenar in https://github.com/input-output-hk/mithril/pull/2604\r\n* remove batch verify aggr and rename gen to generate by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2598\r\n* filip(fix): add client side wrapper to homepage by @fstoqnov-iohk in https://github.com/input-output-hk/mithril/pull/2605\r\n* filip(fix): force re-render to initialise scrollY framer motion hooks by @fstoqnov-iohk in https://github.com/input-output-hk/mithril/pull/2607\r\n* feat: abstract KES signature process by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2606\r\n* docsite & explorer: add `serve_static` makefile target by @Alenar in https://github.com/input-output-hk/mithril/pull/2611\r\n* Prepare project upgrade to Rust `2024` edition by @dlachaume in https://github.com/input-output-hk/mithril/pull/2608\r\n* filip(fix): rewrite scroll-based animation with pure css/js to exclude framer by @fstoqnov-iohk in https://github.com/input-output-hk/mithril/pull/2612\r\n* ci: improve `test-mithril-client-wasm` job debugging by uploading logs as artifacts by @dlachaume in https://github.com/input-output-hk/mithril/pull/2614\r\n* Enhance STM library readability - Rename Structs by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2602\r\n* test:enhance certificate chain builder and mock build by @Alenar in https://github.com/input-output-hk/mithril/pull/2615\r\n* feat: add DMQ publisher/consumer in signer/aggregator by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2599\r\n* ci: replace Sendgrid usage in `Test Notify on Failure` GitHub workflow by @dlachaume in https://github.com/input-output-hk/mithril/pull/2626\r\n* Stabilization of cardano db v2 (aggregator) by @turmelclem in https://github.com/input-output-hk/mithril/pull/2610\r\n* Upgrade to Rust `2024` edition by @dlachaume in https://github.com/input-output-hk/mithril/pull/2613\r\n* ci: add Linux arm64 support by @dlachaume in https://github.com/input-output-hk/mithril/pull/2628\r\n* fix: formatting issues with `cargo fmt` by @dlachaume in https://github.com/input-output-hk/mithril/pull/2631\r\n* Enhance STM library readability - Deprecate Old Structs by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2629\r\n* Add print in output of the client CLI version at each command execution by @turmelclem in https://github.com/input-output-hk/mithril/pull/2630\r\n* feat: add support for Mithril era transition in clients by @dlachaume in https://github.com/input-output-hk/mithril/pull/2633\r\n* Enhance STM library readability - Rename functions by @curiecrypt in https://github.com/input-output-hk/mithril/pull/2632\r\n* feat: Add `CertificateChainSynchronizer` and make follower aggregators start their chain by synchronising with their leader by @Alenar in https://github.com/input-output-hk/mithril/pull/2634\r\n* fix(dmq): add missing KES period in 'DmqMsg' by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2636\r\n* make website more future-proof by @Alenar in https://github.com/input-output-hk/mithril/pull/2641\r\n* refactor: unify and extend `CardanoNetwork` implementation by @dlachaume in https://github.com/input-output-hk/mithril/pull/2643\r\n* Chore: update dependencies for distribution `2530` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2644\r\n* ci: add extra information to release notes by @dlachaume in https://github.com/input-output-hk/mithril/pull/2646\r\n* fix: escape `$(pwd)` and format installation commands by @dlachaume in https://github.com/input-output-hk/mithril/pull/2648\r\n* refactor: rethink dummies test doubles by @Alenar in https://github.com/input-output-hk/mithril/pull/2647\r\n* chore: replace `serde_yaml` with `serde_yml` by @dlachaume in https://github.com/input-output-hk/mithril/pull/2649\r\n* refactor: common test utils by @Alenar in https://github.com/input-output-hk/mithril/pull/2650\r\n* fix: mithril metric tests build by @Alenar in https://github.com/input-output-hk/mithril/pull/2654\r\n* chore: add a link to the CI badge and Crates by @Olexandr88 in https://github.com/input-output-hk/mithril/pull/2645\r\n* refactor: use `TryFrom` for `Certificate` and `CertificateRecord` conversions by @dlachaume in https://github.com/input-output-hk/mithril/pull/2652\r\n* chore: add and unify badges to all published projects by @Alenar in https://github.com/input-output-hk/mithril/pull/2655\r\n* Document immutables folder discovery is recursive by @turmelclem in https://github.com/input-output-hk/mithril/pull/2656\r\n* fix: restore missing section in unstable release notes by @dlachaume in https://github.com/input-output-hk/mithril/pull/2659\r\n* ci: add support for testing a specific release in `Backward compatibility` workflow by @dlachaume in https://github.com/input-output-hk/mithril/pull/2658\r\n* fix: add write access check for install path in one-line installer by @dlachaume in https://github.com/input-output-hk/mithril/pull/2660\r\n* add shared aggregator client by @Alenar in https://github.com/input-output-hk/mithril/pull/2661\r\n* chore: update nightly workflow schedule by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2663\r\n* fix: Rust `1.89` clippy warnings by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2665\r\n* feat: support Cardano node `10.5` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2664\r\n* fix: infra for Cardano node `10.5` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2666\r\n* chore: add dev adr for guidelines on writting test utilities + remove `test_tools` and `full` features from `mithril-common` by @Alenar in https://github.com/input-output-hk/mithril/pull/2653\r\n* fix: block producer infrastructure configuration by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2667\r\n* fix: Operational Certificate circular dependency in KES signature by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2669\r\n* feat: implement fake DMQ node by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2635\r\n* List invalid or tampered immutable files in verify command by @turmelclem in https://github.com/input-output-hk/mithril/pull/2637\r\n* refactor: listing of invalid or missing immutable files in verify command by @turmelclem in https://github.com/input-output-hk/mithril/pull/2671\r\n* chore: rollback binary encoding for single signature by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2676\r\n* Chore: update dependencies for distribution `2537` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2677\r\n* feat: stable `tools utxo-hd` commands in client CLI by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2681\r\n* chore: update SSH keys by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2675\r\n* chore: bump STM minor to `0.5.0` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2684\r\n* docs: update CHANGELOG for `2537.0` distribution release by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2683\r\n* chore: fix SSH keys by @jpraynaud in https://github.com/input-output-hk/mithril/pull/2686\r\n\r\n## New Contributors\r\n* @fstoqnov-iohk made their first contribution in https://github.com/input-output-hk/mithril/pull/2597\r\n* @Olexandr88 made their first contribution in https://github.com/input-output-hk/mithril/pull/2645\r\n\r\n**Full Changelog**: https://github.com/input-output-hk/mithril/compare/2524.0...2537.0-pre\r\n\r\n## Crates Versions\r\n|  Crate  |  Version  |\r\n|---------- |-------------|\r\n| mithril-aggregator | `0.7.84` |\r\n| mithril-client | `0.12.30` |\r\n| mithril-client-cli | `0.12.30` |\r\n| mithril-client-wasm | `0.9.5` |\r\n| mithril-common | `0.6.17` |\r\n| mithril-signer | `0.2.268` |\r\n| mithril-stm | `0.5.0` |\r\n\r\n## Networks Compatibility :warning:\r\n|  Network  |  Compatible  |\r\n|---------- |:-------------:|\r\n| release-mainnet | ⛔ |\r\n| release-preprod | ⛔ |\r\n| pre-release-preview | ✔ |\r\n| testing-preview | ⛔ |\r\n\r\n## Platform Support\r\n\r\nSummary of the platforms for which pre-built binaries are provided.\r\n\r\n| Binary             | Linux x64 | Linux arm64 | macOS arm64 | Windows x64 |\r\n| ------------------ | :-------: | :---------: | :---------: | :---------: |\r\n| mithril-aggregator |     ✔     |   ✔ ⁽\\*⁾    |     ⛔      |     ⛔      |\r\n| mithril-signer     |     ✔     |   ✔ ⁽\\*⁾    |     ⛔      |     ⛔      |\r\n| mithril-client     |     ✔     |   ✔ ⁽\\*⁾    |      ✔      |      ✔      |\r\n\r\n⁽\\*⁾⚠️ Linux arm64 builds are not guaranteed, use at your own risk.\r\n\r\n### Linux Requirements\r\nThe Linux binaries target `glibc`: to run them or install the `.deb` packages you must have `glibc` version `2.35+` installed.\r\nCompatible systems include, but are not limited to, `Ubuntu 22.04+` or `Debian 12+` (Bookworm)).\r\n\r\n## Download a binary asset\r\nTo simplify the installation and updating of Mithril binaries, we have created a one line installer that downloads and installs the Mithril binaries for you.\r\nThis installer is available for Linux and macOS and supports the Mithril signer, Mithril aggregator, and Mithril client CLI.\r\n\r\nUse the following commands to install the Mithril nodes:\r\n\r\n- Download the **Mithril signer** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-signer -d 2537.0-pre -p $(pwd)\r\n```\r\n\r\n- Download the **Mithril client CLI** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-client -d 2537.0-pre -p $(pwd)\r\n```\r\n\r\n- Download the **Mithril aggregator** in the current directory:\r\n```bash\r\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-aggregator -d 2537.0-pre -p $(pwd)\r\n```\r\n\r\n## Verify the authenticity of a downloaded asset\r\n<details><summary>Detailed procedure to verify an asset</summary>\r\n<p>\r\n\r\n* **Step 1**: Identify the downloaded asset on your computer ***YOUR_ASSET_FILE***\r\n* **Step 2**: Download the signed checksum file from this link [CHECKSUM.asc](https://github.com/input-output-hk/mithril/releases/download/2537.0-pre/CHECKSUM.asc) and save it in the same folder as the asset\r\n* **Step 3**: In your terminal, go to the asset folder by running:\r\n```\r\ncd ***YOUR_ASSET_FOLDER***\r\n```\r\n* **Step 4**: Then verify the checksum of the asset by running:\r\n```\r\nsha256sum -c ./CHECKSUM.asc 2>/dev/null | grep ***YOUR_ASSET_FILE***\r\n```\r\nYou must see:\r\n```\r\n./***YOUR_ASSET_FILE***: OK\r\n```\r\n* **Step 5**: Download the public key file from this link [public-key.gpg](https://github.com/input-output-hk/mithril/releases/download/2537.0-pre/public-key.gpg) and save it in the same folder as the asset\r\n* **Step 6**: Then import the GPG public key:\r\n```\r\ngpg --import ./public-key.gpg\r\n```\r\nYou must see something like:\r\n```\r\ngpg: key : public key \"Input Output / Mithril <mithril@iohk.io>\" imported\r\ngpg: Total number processed: 1\r\ngpg:               imported: 1\r\n```\r\n* **Step 7**: Then verify the GPG signature of the checksum file:\r\n```\r\ngpg --verify ./CHECKSUM.asc\r\n```\r\nYou must see something like:\r\n```\r\ngpg: Signature made Mon 05 Dec 2022 04:53:54 PM CET\r\ngpg:                using RSA key 35EDE9D47BBA62A2F388E655899ACD26B8BCA0D2\r\ngpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\" [unknown]\r\ngpg: WARNING: This key is not certified with a trusted signature!\r\ngpg:          There is no indication that the signature belongs to the owner.\r\nPrimary key fingerprint: 35ED E9D4 7BBA 62A2 F388  E655 899A CD26 B8BC A0D2\r\n```\r\nThe signature is valid if and only if:\r\n- there is a line with `gpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\"`\r\n- there is a line with `Primary key fingerprint: 73FC 4C3D FD55 DBDC 428A D2B5 BE04 3B79 FDA4 C2EE`\r\n* **Step 8**:\r\nIf you successfully validated all the steps of this process, then you have successfully verified the authenticity of the asset :heavy_check_mark:\r\nIf not, contact us at [mithril@iohk.io] and let us know of the outcome of your run of this process :warning:\r\n\r\n</p>\r\n</details>\r\n\r\n\r\n## Download a Docker image\r\nYou can directly pull prebuilt Mithril Docker images:\r\n\r\n| Binary             |              Image name              |                             URL                              |\r\n| ------------------ | :----------------------------------: | :----------------------------------------------------------: |\r\n| mithril-aggregator | mithril-aggregator:2537.0-pre-6a7107e | ghcr.io/input-output-hk/mithril-aggregator:2537.0-pre-6a7107e |\r\n| mithril-signer     |   mithril-signer:2537.0-pre-6a7107e   |   ghcr.io/input-output-hk/mithril-signer:2537.0-pre-6a7107e   |\r\n| mithril-client     |   mithril-client:2537.0-pre-6a7107e   |   ghcr.io/input-output-hk/mithril-client:2537.0-pre-6a7107e   |\r\n","reactions":{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/246412814/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0},"mentions_count":7},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/225559459","assets_url":"https://api.github.com/repos/input-output-hk/mithril/releases/225559459/assets","upload_url":"https://uploads.github.com/repos/input-output-hk/mithril/releases/225559459/assets{?name,label}","html_url":"https://github.com/input-output-hk/mithril/releases/tag/2524.0","id":225559459,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOGBJN7M4NccOj","tag_name":"2524.0","target_commitish":"main","name":"Mithril v2524.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2025-06-16T13:05:05Z","updated_at":"2025-06-16T13:27:43Z","published_at":"2025-06-16T13:06:50Z","assets":[{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/264407810","id":264407810,"node_id":"RA_kwDOGBJN7M4PwosC","name":"CHECKSUM.asc","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.