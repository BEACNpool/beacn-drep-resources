-unstable-86e1c01-windows-x64.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/gzip","state":"uploaded","size":8315720,"digest":"sha256:31e960fec9db8ba710f13b8cf76370db81c8eb041c69bdf2a14352a7bdfcb2fc","download_count":0,"created_at":"2026-07-10T08:55:37Z","updated_at":"2026-07-10T08:55:38Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/unstable/mithril-unstable-86e1c01-windows-x64.tar.gz"},{"url":"https://api.github.com/repos/input-output-hk/mithril/releases/assets/472293873","id":472293873,"node_id":"RA_kwDOGBJN7M4cJqHx","name":"public-key.gpg","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":673,"digest":"sha256:721c119881ac53d65b76654f04bd0176a21dab607fe8a8dae7b8e1e10bdc0835","download_count":0,"created_at":"2026-07-10T08:55:37Z","updated_at":"2026-07-10T08:55:38Z","browser_download_url":"https://github.com/input-output-hk/mithril/releases/download/unstable/public-key.gpg"}],"tarball_url":"https://api.github.com/repos/input-output-hk/mithril/tarball/unstable","zipball_url":"https://api.github.com/repos/input-output-hk/mithril/zipball/unstable","body":"\n## Crates Versions\n|  Crate  |  Version  |\n|---------- |-------------|\n| mithril-aggregator | `0.9.17` |\n| mithril-client | `0.14.17` |\n| mithril-client-cli | `0.13.19` |\n| mithril-client-wasm | `0.10.7` |\n| mithril-common | `0.7.13` |\n| mithril-signer | `1.1.5` |\n| mithril-stm | `0.10.49` |\n\n## Networks Compatibility :warning:\n|  Network  |  Compatible  |\n|---------- |:-------------:|\n| release-mainnet | ⛔ |\n| release-preprod | ⛔ |\n| pre-release-preview | ⛔ |\n| testing-preview | ✔ |\n\n## Cardano Node Compatibility\n\n| Network | Mithril Aggregator | Mithril Signer |\n|---------- |:-------------: |:-------------: |\n| release-mainnet | Cardano `10.6.2+`<sup>(*)</sup> | Cardano `10.6.2+`<sup>(*)</sup> |\n| release-preprod | Cardano `10.6.2+`<sup>(*)</sup> | Cardano `10.6.2+`<sup>(*)</sup> |\n| pre-release-preview | Cardano `10.7.1+`<sup>(*)</sup> | Cardano `10.7.1+`<sup>(*)</sup> |\n| testing-preview | Cardano `10.7.1+`<sup>(*)</sup> | Cardano `10.7.1+`<sup>(*)</sup> |\n\n<sup>*</sup>: Up to the latest Cardano node version released at the time of this release.\n\n## DMQ Node Compatibility\n\n| Network | Mithril Aggregator | Mithril Signer |\n|---------- |:-------------: |:-------------: |\n| release-mainnet | DMQ `0.6.0.0+`<sup>(*)</sup> | DMQ `0.6.0.0+`<sup>(*)</sup> |\n| release-preprod | DMQ `0.6.0.0+`<sup>(*)</sup> | DMQ `0.6.0.0+`<sup>(*)</sup> |\n| pre-release-preview | DMQ `0.6.0.0+`<sup>(*)</sup> | DMQ `0.6.0.0+`<sup>(*)</sup> |\n| testing-preview | DMQ `0.6.0.0+`<sup>(*)</sup> | DMQ `0.6.0.0+`<sup>(*)</sup> |\n\n<sup>*</sup>: Up to the latest DMQ node version released at the time of this release.\n\n## Platform Support\n\nSummary of the platforms for which pre-built binaries are provided.\n\n| Binary             | Linux x64 | Linux arm64 | macOS arm64 | Windows x64 |\n| ------------------ | :-------: | :---------: | :---------: | :---------: |\n| mithril-aggregator |     ✔     |   ✔ ⁽\\*⁾    |     ⛔      |     ⛔      |\n| mithril-signer     |     ✔     |   ✔ ⁽\\*⁾    |     ⛔      |     ⛔      |\n| mithril-client     |     ✔     |   ✔ ⁽\\*⁾    |      ✔      |      ✔      |\n\n⁽\\*⁾⚠️ Linux arm64 builds are provided on a best-effort basis and are not officially supported.\n\n\n## Fetch the latest version of the `unstable` tag\nThe `unstable` tag is updated with a new commit id when a new `unstable` release is published.\nTo fetch the latest version of the unstable tag, execute the command:\n`git tag -d unstable && git fetch origin tag unstable`\n\n## Download a binary asset\nTo simplify the installation and updating of Mithril binaries, we have created a one line installer that downloads and installs the Mithril binaries for you.\nThis installer is available for Linux and macOS and supports the Mithril signer, Mithril aggregator, and Mithril client CLI.\n\nUse the following commands to install the Mithril nodes:\n\n- Download the **Mithril signer** in the current directory:\n```bash\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-signer -d unstable -p $(pwd)\n```\n\n- Download the **Mithril client CLI** in the current directory:\n```bash\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-client -d unstable -p $(pwd)\n```\n\n- Download the **Mithril aggregator** in the current directory:\n```bash\ncurl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/input-output-hk/mithril/refs/heads/main/mithril-install.sh | sh -s -- -c mithril-aggregator -d unstable -p $(pwd)\n```\n\n## Verify the authenticity of a downloaded asset\n<details><summary>Detailed procedure to verify an asset</summary>\n<p>\n\n* **Step 1**: Identify the downloaded asset on your computer ***YOUR_ASSET_FILE***\n* **Step 2**: Download the signed checksum file from this link [CHECKSUM.asc](https://github.com/input-output-hk/mithril/releases/download/unstable/CHECKSUM.asc) and save it in the same folder as the asset\n* **Step 3**: In your terminal, go to the asset folder by running:\n```\ncd ***YOUR_ASSET_FOLDER***\n```\n* **Step 4**: Then verify the checksum of the asset by running:\n```\nsha256sum -c ./CHECKSUM.asc 2>/dev/null | grep ***YOUR_ASSET_FILE***\n```\nYou must see:\n```\n./***YOUR_ASSET_FILE***: OK\n```\n* **Step 5**: Download the public key file from this link [public-key.gpg](https://github.com/input-output-hk/mithril/releases/download/unstable/public-key.gpg) and save it in the same folder as the asset\n* **Step 6**: Then import the GPG public key:\n```\ngpg --import ./public-key.gpg\n```\nYou must see something like:\n```\ngpg: key : public key \"Input Output / Mithril <mithril@iohk.io>\" imported\ngpg: Total number processed: 1\ngpg:               imported: 1\n```\n* **Step 7**: Then verify the GPG signature of the checksum file:\n```\ngpg --verify ./CHECKSUM.asc\n```\nYou must see something like:\n```\ngpg: Signature made Mon 05 Dec 2022 04:53:54 PM CET\ngpg:                using RSA key 35EDE9D47BBA62A2F388E655899ACD26B8BCA0D2\ngpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\" [unknown]\ngpg: WARNING: This key is not certified with a trusted signature!\ngpg:          There is no indication that the signature belongs to the owner.\nPrimary key fingerprint: 35ED E9D4 7BBA 62A2 F388  E655 899A CD26 B8BC A0D2\n```\nThe signature is valid if and only if:\n- there is a line with `gpg: Good signature from \"Input Output / Mithril <mithril@iohk.io>\"`\n- there is a line with `Primary key fingerprint: 73FC 4C3D FD55 DBDC 428A D2B5 BE04 3B79 FDA4 C2EE`\n* **Step 8**:\nIf you successfully validated all the steps of this process, then you have successfully verified the authenticity of the asset :heavy_check_mark:\nIf not, contact us at [mithril@iohk.io] and let us know of the outcome of your run of this process :warning:\n\n</p>\n</details>\n\n\n## Download a Docker image\nYou can directly pull prebuilt Mithril Docker images:\n\n| Binary             |              Image name              |                             URL                              |\n| ------------------ | :----------------------------------: | :----------------------------------------------------------: |\n| mithril-aggregator | mithril-aggregator:main-86e1c01 | ghcr.io/input-output-hk/mithril-aggregator:main-86e1c01 |\n| mithril-signer     |   mithril-signer:main-86e1c01   |   ghcr.io/input-output-hk/mithril-signer:main-86e1c01   |\n| mithril-client     |   mithril-client:main-86e1c01   |   ghcr.io/input-output-hk/mithril-client:main-86e1c01   |\n\n\n## What's Changed\n* feat(stm): fixing merkle depth for all circuits by @damrobi in https://github.com/input-output-hk/mithril/pull/3194\n* ci/test: multi speed tiers for tests by @Alenar in https://github.com/input-output-hk/mithril/pull/3221\n* fix(nix): add native mithril-client-cli build for darwin and aarch64-… by @disassembler in https://github.com/input-output-hk/mithril/pull/3224\n* fix: authorize headers in signer relay in infra by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3228\n* ci: run rusts tests in nightly dispatcher by @Alenar in https://github.com/input-output-hk/mithril/pull/3226\n* ci: publish crates all at once by @Alenar in https://github.com/input-output-hk/mithril/pull/3232\n* docs(website): improve homepage SEO metadata and messaging by @dalibran in https://github.com/input-output-hk/mithril/pull/3199\n* test(halo2_ivc): add Layer A encoding  tests by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3222\n* refactor: create internal crate for Merkle tree and map by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3223\n* fix(halo2_ivc): split slow MockProver tests into mod slow and registe… by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3233\n* docs: rotate documentation for `2617` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3020\n* docs: final CHANGELOG for `2617.0` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3234\n* docs: dev blog posts for `2617` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3218\n* refactor(stm): Accelerate snark tests by @damrobi in https://github.com/input-output-hk/mithril/pull/3217\n* ci: upgrade GitHub actions by @Alenar in https://github.com/input-output-hk/mithril/pull/3237\n* test(halo2_ivc): add Layer B State tests by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3229\n* fix(stm): Fixing the flakiness in the circuit tests by @damrobi in https://github.com/input-output-hk/mithril/pull/3236\n* drop support for x86_64-darwin by @dermetfan in https://github.com/input-output-hk/mithril/pull/3238\n* Test the ledger snapshot conversion in the e2e test by @turmelclem in https://github.com/input-output-hk/mithril/pull/3235\n* feat(stm): detect circuit modification by @damrobi in https://github.com/input-output-hk/mithril/pull/3225\n* docs(website): fix doubled title on homepage by @dalibran in https://github.com/input-output-hk/mithril/pull/3240\n* fix(client): rare race condition when a file download finish by @Alenar in https://github.com/input-output-hk/mithril/pull/3248\n* Support 'current' and 'next' versions of open api by @turmelclem in https://github.com/input-output-hk/mithril/pull/3247\n* Fix artifact retrieval by specifying signed entity type by @turmelclem in https://github.com/input-output-hk/mithril/pull/3252\n* Remove mention of Open API documentation website in Open API files by @turmelclem in https://github.com/input-output-hk/mithril/pull/3253\n* Update Github runners to Ubuntu 24.04 by @turmelclem in https://github.com/input-output-hk/mithril/pull/3255\n* feat: enforce DMQ message id by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3256\n* feat: support for Cardano `11.0` configuration by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3258\n* feat(stm): Non-unique Schnorr Signature support by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3239\n* test(halo2_ivc): add Layer C1 in-circuit verification tests by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3241\n* feat(stm): Trusted setup validation by @damrobi in https://github.com/input-output-hk/mithril/pull/3249\n* feat: SNARK-friendly protocol message by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3254\n* test(halo2_ivc): add Layer C2 off-circuit verification tests by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3259\n* Add a script to check dependency version consistency by @turmelclem in https://github.com/input-output-hk/mithril/pull/3261\n* Update minor version of mithril-stm dependency to 0.10.18 for consistency by @turmelclem in https://github.com/input-output-hk/mithril/pull/3263\n* refactor(ci): fix typo in log message of crate-version-checker script by @turmelclem in https://github.com/input-output-hk/mithril/pull/3264\n* refactor(halo2_ivc): replace temporary Certificate circuit with StmCertificateCircuit by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3266\n* chore: add `CODEOWNERS` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3272\n* chore: add genesis verification key for dev networks in infra by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3273\n* feat(stm): Prepare prover input - Phase 1 and Phase 2 by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3267\n* refactor: strengthen unknown and future signed entity support by @Alenar in https://github.com/input-output-hk/mithril/pull/3265\n* fix: cloud DNS site verification in infra by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3279\n* feat(mithril-stm): add reproducible benchmarks for StmCertificateCircuit by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3275\n* feat(stm): implement `SnarkVerifierSetup` in helpers by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3281\n* chore: SNARK support enhancements by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3280\n* refactor(mithril-stm): structured error handling for halo2_ivc circuit by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3284\n* refactor: remove cardano db v1 backend by @Alenar in https://github.com/input-output-hk/mithril/pull/3285\n* fix(aggregator): warn instead of error when parsing unknown signed entity by @Alenar in https://github.com/input-output-hk/mithril/pull/3287\n* Add a cache mecanism on immutable files synchronisation by @turmelclem in https://github.com/input-output-hk/mithril/pull/3286\n* docs: update security page with honest majority section by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3277\n* fix(node-db): flush file after write to avoid race with tokio's async… by @perturbing in https://github.com/input-output-hk/mithril/pull/3289\n* docs: update dev blog post for distribution `2617.0` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3290\n* feat(stm): Prepare prover input - Phase 3 by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3278\n* refactor(mithril-stm): remove halo2_ivc helpers module by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3288\n* docs(website): add Use Cases section with Light Wallets, Bridges; add Case Studies section with Daedalus by @dalibran in https://github.com/input-output-hk/mithril/pull/3200\n* feat(stm): add disk-backed VK/PK caching with TrustedSetupProvider wiring by @perturbing in https://github.com/input-output-hk/mithril/pull/3282\n* ignore racy key-cache constructor tests by @perturbing in https://github.com/input-output-hk/mithril/pull/3299\n* feature: custom genesis verification key support in explorer by @Alenar in https://github.com/input-output-hk/mithril/pull/3291\n* chore: update dependencies for distribution `2623` by @Alenar in https://github.com/input-output-hk/mithril/pull/3301\n* fix flaky test race on shared SRS temp file by @perturbing in https://github.com/input-output-hk/mithril/pull/3294\n* refactor(mithril-stm): type consistency for halo2 IVC by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3293\n* fix: pools tickers missing in mithril-explorer by @Alenar in https://github.com/input-output-hk/mithril/pull/3312\n* refactor(mithril-stm): align halo2 IVC naming by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3309\n* Remove mithril nodes supports in mithril devnet by @turmelclem in https://github.com/input-output-hk/mithril/pull/3311\n* feat: SNARK-friendly genesis certificate primitives by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3304\n* feat: dual-signature genesis certificate and wiring by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3306\n* Removing nightly docker build of mithril legacy images by @turmelclem in https://github.com/input-output-hk/mithril/pull/3314\n* feat: updated DMQ message id enforcement by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3260\n* refactor(end-to-end): promote scenario to commands, switch epoch length based wait duration, rework and cleanup assertions by @Alenar in https://github.com/input-output-hk/mithril/pull/3316\n* feat: ledger peers support for DMQ node by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3318\n* docs: update CHANGELOG with `2624.0` distribution by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3321\n* feat: add DMQ node compatibility matrix in release notes by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3323\n* feat(stm):  Prepare prover input - Phase 4 by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3313\n* Package only one ledger state snapshot for Cardano node version above 10.4 by @turmelclem in https://github.com/input-output-hk/mithril/pull/3317\n* feat(ci): e2e light scenario for snark running in nightly ci by @Alenar in https://github.com/input-output-hk/mithril/pull/3325\n* implement `verify` IVC  proof over blake2b/poseidon by @perturbing in https://github.com/input-output-hk/mithril/pull/3315\n* chore(ci): extend timeout for e2e workflow to 120 minutes by @Alenar in https://github.com/input-output-hk/mithril/pull/3331\n* feat: certificate chain support for IVC SNARK by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3322\n* fix(explorer): unresponsive UI by @Alenar in https://github.com/input-output-hk/mithril/pull/3336\n* refactor: genesis preimage ancillary data by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3335\n* feat(mithril-stm): implement `IvcProver::prove` by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3327\n* feat: add missing ancillary data for IVC aggregate signature creation by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3340\n* Improve balance build/run time for future snark tests in CI by @perturbing in https://github.com/input-output-hk/mithril/pull/3342\n* refactor: enhanced support for unknown signed entity by @Alenar in https://github.com/input-output-hk/mithril/pull/3344\n* Updating pallas version to 1.1.0 and making adaptations by @turmelclem in https://github.com/input-output-hk/mithril/pull/3324\n* Enhance versions bump script by @turmelclem in https://github.com/input-output-hk/mithril/pull/3350\n* feat(stm): wire IVC snark prover by @damrobi in https://github.com/input-output-hk/mithril/pull/3348\n* chore: apply prettier linting to docs by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3356\n* fix: DMQ configuration docs by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3357\n* Make kes_bytes file creation/write atomic for concurrent access by @turmelclem in https://github.com/input-output-hk/mithril/pull/3353\n* fix: aggregate signature verification uses a trusted genesis verification key by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3354\n* refactor(stm): applying final comments of PR #3348 by @damrobi in https://github.com/input-output-hk/mithril/pull/3352\n* Mark stale issues and PRs with GitHub workflow by @turmelclem in https://github.com/input-output-hk/mithril/pull/3359\n* test: check unknown and discontinued signed entities in signers and aggregator integration tests by @Alenar in https://github.com/input-output-hk/mithril/pull/3355\n* fix(aggregator): reject legacy Lagrange genesis key and fix epoch pruning order by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3360\n* fix(ci): Fixing issue and PR labels exclusion of stale job by @turmelclem in https://github.com/input-output-hk/mithril/pull/3363\n* fix(ci): Fixing issue and PR labels exclusion of stale job with Github format emojis by @turmelclem in https://github.com/input-output-hk/mithril/pull/3364\n* refactor(mithril-stm): refactor and stabilize the SNARK setups by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3349\n* refactor(stm): Refactor prover input preparation by @curiecrypt in https://github.com/input-output-hk/mithril/pull/3326\n* feat(e2e): support `IvcSnark` proofs and harden the e2e test suite waits by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3365\n* fix(ci): prevent GitHub Pages deploy failure on workflow re-runs by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3369\n* refactor(stm): rename recursive-circuit backend aliases to meaningful names by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3368\n* chore: update dependencies for distribution `2627` by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3373\n* feat(stm): add tests to circuit degrees are unchanged by @damrobi in https://github.com/input-output-hk/mithril/pull/3370\n* feat(ci): add `testing-2-preview` network by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3371\n* fix(ci): configuration of `testing-2-preview` network by @jpraynaud in https://github.com/input-output-hk/mithril/pull/3376\n* refactor(mithril-stm): decouple halo2_ivc from Midnight types by @hjeljeli32 in https://github.com/input-output-hk/mithril/pull/3374\n* fix: anticipate Rust `1.97` clippy warnings by @Alenar in https://github.com/input-output-hk/mithril/pull/3391\n* feat(aggregator): add state machine `blocked` state by @Alenar in https://github.com/input-output-hk/mithril/pull/3372\n* fix: harden the Mithril install script against GitHub API errors by @jpraynaud in https://github.com/input-output-hk/mithril/