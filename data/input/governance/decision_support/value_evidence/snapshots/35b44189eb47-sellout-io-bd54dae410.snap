dyl-container" style="flex-shrink:0;user-select:none;width:100%;height:100%;opacity:1;transform:none;transform-origin:100% 50% 0"><div class="framer-F4phz framer-m9hhG framer-jH7XP framer-rHuBk framer-b6aEN framer-1p92qy1 framer-v-1p92qy1" data-framer-name="Default" style="background-color:var(--token-f56fa820-1572-4c50-a85d-c5aa6415847a, rgb(252, 252, 253));height:100%;width:100%;border-bottom-left-radius:32px;border-bottom-right-radius:32px;border-top-left-radius:32px;border-top-right-radius:32px"><div class="framer-e7ddq6" data-framer-name="Headshot" style="border-bottom-left-radius:100%;border-bottom-right-radius:100%;border-top-left-radius:100%;border-top-right-radius:100%"><div style="position:absolute;border-radius:inherit;corner-shape:inherit;top:0;right:0;bottom:0;left:0" data-framer-background-image-wrapper="true"><img decoding="async" sizes="(min-width: 1200px) min(120px, 100vw * 0.35), (max-width: 809.98px) min(120px, 100vw * 0.35), (min-width: 810px) and (max-width: 1199.98px) min(120px, 100vw * 0.35)" srcset="https://framerusercontent.com/images/xIBUboI0zoDYHUl443AEV70JsdQ.png?scale-down-to=512 512w,https://framerusercontent.com/images/xIBUboI0zoDYHUl443AEV70JsdQ.png 1000w" src="https://framerusercontent.com/images/xIBUboI0zoDYHUl443AEV70JsdQ.png" alt style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div></div><div class="framer-5x7v9w" data-framer-name="Content"><div class="framer-1y84bpm" data-framer-name="Top Content"><div class="framer-yar6ti" data-framer-name="Heading" data-framer-component-type="RichTextContainer" style="--framer-paragraph-spacing:0px;transform:none"><h5 class="framer-text framer-styles-preset-a75zjm" data-styles-preset="s9hTDsea6" dir="auto" style="--framer-text-alignment:center">"Refreshing"</h5></div><div class="framer-1iqbafv" data-framer-name="Text" data-framer-component-type="RichTextContainer" style="--extracted-r6o4lv:var(--token-b747b483-3b52-4e86-96f4-3e72ab028788, rgb(46, 18, 94));--framer-paragraph-spacing:0px;transform:none"><p class="framer-text framer-styles-preset-1j8am70" data-styles-preset="C28EYli78" style="--framer-text-alignment:center;--framer-text-color:var(--extracted-r6o4lv, var(--token-b747b483-3b52-4e86-96f4-3e72ab028788, rgb(46, 18, 94)))">Sellout is readily available and always willing to help when we need them. We’re continually impressed by how responsive they are when we have questions or needs addressed. In a world full of impersonal, big tech companies, working with Sellout is refreshing. You won’t find better customer or technical support anywhere.</p></div></div><div class="framer-19ahgx4" data-framer-name="Divider" style="background-color:var(--token-263a7f64-5dbd-42c8-80ee-6e4b6c30e99b, rgb(236, 233, 254));border-bottom-left-radius:124px;border-bottom-right-radius:124px;border-top-left-radius:124px;border-top-right-radius:124px"></div><div class="framer-1aouj90" data-framer-name="Avatar Content"><div class="framer-1b8a6ze" data-framer-name="Name" data-framer-component-type="RichTextContainer" style="--extracted-r6o4lv:var(--token-b747b483-3b52-4e86-96f4-3e72ab028788, rgb(46, 18, 94));--framer-paragraph-spacing:0px;transform:none"><p class="framer-text framer-styles-preset-379fyl" data-styles-preset="sZJOcJc3C" style="--framer-text-color:var(--extracted-r6o4lv, var(--token-b747b483-3b52-4e86-96f4-3e72ab028788, rgb(46, 18, 94)))">Matt Leow</p></div><div class="framer-1qp3efq" data-framer-name="Title" data-framer-component-type="RichTextContainer" style="--extracted-r6o4lv:var(--token-dc8aca8a-ac09-4e10-ab2f-f2231c534f86, rgb(255, 68, 5));--framer-paragraph-spacing:0px;transform:none"><p class="framer-text framer-styles-preset-1lg0dbl" data-styles-preset="OyLfwjIhE" style="--framer-text-alignment:center;--framer-text-color:var(--extracted-r6o4lv, var(--token-dc8aca8a-ac09-4e10-ab2f-f2231c534f86, rgb(255, 68, 5)))">Executive Director, MT Brewers Association</p></div></div></div>