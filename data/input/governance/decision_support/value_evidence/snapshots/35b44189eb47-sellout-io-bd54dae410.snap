orner-shape:inherit;top:0;right:0;bottom:0;left:0" data-framer-background-image-wrapper="true"><img decoding="async" src="https://framerusercontent.com/images/Bs2OpcMc4TqlMGdR4TbtoyeSEI.jpeg" alt style="display:block;width:100%;height:100%;border-radius:inherit;corner-shape:inherit;object-position:center;object-fit:cover"></div></div><div class="framer-5x7v9w" data-framer-name="Content"><div class="framer-1y84bpm" data-framer-name="Top Content"><div class="framer-yar6ti" data-framer-name="Heading" data-framer-component-type="RichTextContainer" style="--framer-paragraph-spacing:0px;transform:none"><h5 class="framer-text framer-styles-preset-a75zjm" data-styles-preset="s9hTDsea6" dir="auto" style="--framer-text-alignment:center">"Simply Superior"</h5></div><div class="framer-1iqbafv" data-framer-name="Text" data-framer-component-type="RichTextContainer" style="--extracted-r6o4lv:var(--token-b747b483-3b52-4e86-96f4-3e72ab028788, rgb(46, 18, 94));--framer-paragraph-spacing:0px;transform:none"><p class="framer-text framer-styles-preset-1j8am70" data-styles-preset="C28EYli78" style="--framer-text-alignment:center;--framer-text-color:var(--extracted-r6o4lv, var(--token-b747b483-3b52-4e86-96f4-3e72ab028788, rgb(46, 18, 94)))">"For the past 6 years, Sellout has and continues to be a critical contributor to the success of Live From The Divide. Its unique ability to address both patrons' and event producers' needs with real-time digital solutions sets it apart. After trying larger, well-known competitors, I can confidently say that Sellout is simply a superior product."</p></div></div><div class="framer-19ahgx4" data-framer-name="Divider" style="background-color:var(--token-263a7f64-5dbd-42c8-80ee-6e4b6c30e99b, rgb(236, 233, 254));border-bottom-left-radius:124px;border-bottom-right-radius:124px;border-top-left-radius:124px;border-top-right-radius:124px"></div><div class="framer-1aouj90" data-framer-name="Avatar Content"><div class="framer-1b8a6ze" data-framer-name="Name" data-