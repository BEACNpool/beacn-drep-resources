[4,17,27,37,47],{"OUPDNV183":5,"vrU58gel8":8,"UW0Go8RyM":13,"id":15},{"type":6,"value":7},"string","How much does it cost to host an event?",{"type":9,"value":10},"richtext",{"collectionId":11,"pointer":12},"0beea091-20c2-45e6-96f0-6ec7195e9218default","[1,[4,\"p\",null,[5,\"Our pricing is simple. Free events can always use our event management and ticketing software for free. Paid events use a low, per-ticket fee structure with no setup costs or surprise fees.\"]]]",{"type":6,"value":14},"how-much-does-it-cost-to-host-an-event",{"type":6,"value":16},"vJIPR3bcS",{"OUPDNV183":18,"vrU58gel8":20,"UW0Go8RyM":23,"id":25},{"type":6,"value":19},"Are there any subscription fees?",{"type":9,"value":21},{"collectionId":11,"pointer":22},"[1,[4,\"p\",null,[5,\"Nope. No monthly costs. No contracts. We only get paid when tickets are sold through our ticketing platform.\"]]]",{"type":6,"value":24},"are-there-any-subscription-fees",{"type":6,"value":26},"CjrKUKgPJ",{"OUPDNV183":28,"vrU58gel8":30,"UW0Go8RyM":33,"id":35},{"type":6,"value":29},"When do I receive payouts?",{"type":9,"value":31},{"collectionId":11,"pointer":32},"[1,[4,\"p\",null,[5,\"You’ll receive daily payouts directly to your account, so your revenue works for you sooner.\"]]]",{"type":6,"value":34},"when-do-i-receive-payouts",{"type":6,"value":36},"Jst_aO22q",{"OUPDNV183":38,"vrU58gel8":40,"UW0Go8RyM":43,"id":45},{"type":6,"value":39},"Do fans pay fees?",{"type":9,"value":41},{"collectionId":11,"pointer":42},"[1,[4,\"p\",null,[5,\"Service and processing fees are passed on to the attendee and paid at checkout. If you’d prefer not to pass the processing fees on to your attendees, you can choose to include the fee in the cost, and it will be automatically deducted at the time of sale. \"]]]",{"type":6,"value":44},"do-fans-pay-fees",{"type":6,"value":46},"XYSO95EuD",{"OUPDNV183":48,"vrU58gel8":50,"UW0Go8RyM":53,"id":55},{"type":6,"value":49},"How do I get started?",{"type":9,"value":51},{"collectionId":11,"pointer":52},"[1,[4,\"p\",null,[5,\"Begin to sell tickets to an event in minutes! All you need to get started is your EIN/TIN/SSN, business contact details, and banking information.\"]]]",{"type":6,"value":54},"get-started",{"type":6,"value":56},"dw1BRt56g","{\"from\":\"0beea091-20c2-45e6-96f0-6ec7195e9218\",\"select\":[{\"collection\":\"LGiwlAIAy\",\"name\":\"OUPDNV183\",\"type\":\"Identifier\"},{\"collection\":\"LGiwlAIAy\",\"name\":\"vrU58gel8\",\"type\":\"Identifier\"},{\"collection\":\"LGiwlAIAy\",\"name\":\"UW0Go8RyM\",\"type\":\"Identifier\"},{\"collection\":\"LGiwlAIAy\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"LGiwlAIAy\",\"name\":\"apKir67y_\",\"type\":\"Identifier\"},\"operator\":\"==\",\"right\":{\"type\":\"LiteralValue\",\"value\":\"ib8a91Whl\"},\"type\":\"BinaryOperation\"}}default",[59,69,79],{"OUPDNV183":60,"vrU58gel8":62,"UW0Go8RyM":65,"id":67},{"type":6,"value":61},"How do I create my first event?",{"type":9,"value":63},{"collectionId":11,"pointer":64},"[1,[4,\"p\",null,[5,\"Just click “Create an Event,” and our setup flow will guide you through the event creation process—from event details to ticket types—in a few minutes.\"]]]",{"type":6,"value":66},"how-do-i-create-my-first-event",{"type":6,"value":68},"pvViqwd0e",{"OUPDNV183":70,"vrU58gel8":72,"UW0Go8RyM":75,"id":77},{"type":6,"value":71},"Can I save my event as a draft?",{"type":9,"value":73},{"collectionId":11,"pointer":74},"[1,[4,\"p\",null,[5,\"Yes! Work at your pace. You can start an event, save your progress, and come back anytime.\"]]]",{"type":6,"value":76},"can-i-save-my-event-as-a-draft",{"type":6,"value":78},"Otr4ZZiJL",{"OUPDNV183":80,"vrU58gel8":82,"UW0Go8RyM":85,"id":87},{"type":6,"value":81},"Is there support available during setup?",{"type":9,"value":83},{"collectionId":11,"pointer":84},"[1,[4,\"p\",null,[5,\"Yes! Our real people are ready via chat, phone, or email whenever you need help. We also have a comprehensive online learning center and help docs ready for you to use.\"]]]",{"type":6,"value":86},"is-there-support-available-during-setup",{"type":6,"value":88},"v5t_HMtER","{\"from\":\"0beea091-20c2-45e6-96f0-6ec7195e9218\",\"select\":[{\"collection\":\"bSvveujMF\",\"name\":\"OUPDNV183\",\"type\":\"Identifier\"},{\"collection\":\"bSvveujMF\",\"name\":\"vrU58gel8\",\"type\":\"Identifier\"},{\"collection\":\"bSvveujMF\",\"name\":\"UW0Go8RyM\",\"type\":\"Identifier\"},{\"collection\":\"bSvveujMF\",\"name\":\"id\",\"type\":\"Identifier\"}],\"where\":{\"left\":{\"collection\":\"bSvveujMF\",\"name\":\"apKir67y_\",\"type\":\"Identifier\"},\"operator\":\"==\",\"right\":{\"type\":\"LiteralValue\",\"value\":\"q2ugCqoAP\"},\"type\":\"BinaryOperation\"}}default",[91,101,111],{"OUPDNV183":92,"vrU58gel8":94,"UW0Go8RyM":97,"id":99},{"type":6,"value":93},"Can I manage my event from a mobile device?",{"type":9,"value":95},{"collectionId":11,"pointer":96},"[1,[4,\"p\",null,[5,\"Absolutely. Our dashboard works easily on your phone, desktop, and tablet screens.\"]]]",{"type":6,"value":98},"can-i-manage-my-event-from-a-mobile-device",{"type":6,"value":100},"KMLfH1DWp",{"OUPDNV183":102,"vrU58gel8":104,"UW0Go8RyM":107,"id":109},{"type":6,"value":103},"How do I access sales analytics?",{"type":9,"value":105},{"collectionId":11,"pointer":106},"[1,[4,\"p\",null,[5,\"You’ll see live stats on your dashboard—including revenue, ticket sales, and check-ins. Just log in and go!\"]]]",{"type":6,"value":108},"how-do-i-access-sales-analytics",{"type":6,"value":110},"DGR1y5Hkq",{"OUPDNV183":112,"vrU58gel8":114,"UW0Go8RyM":117,"id":119},{"type":6,"value":113},"Are automated reports available?",{"type":9,"value":115},{"collectionId":11,"pointer":116},"[1,[4,\"p\",null,[5,\"Yep. Daily or weekly reports sent straight to your inbox.\"]]]",{"type":6,"value":118},"are-automated-reports-available",{"type":6,"value":120},"rIFQUZ4in",["Map"]]</script><div id="svg-templates" style="position: absolute; overflow: hidden; bottom: 0; left: 0; width: 0; height: 0; z-index: 0; contain: strict" aria-hidden="true">
