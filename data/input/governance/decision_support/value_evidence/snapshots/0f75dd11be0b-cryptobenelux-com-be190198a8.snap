=\\\"/ada\\\" title=\\\"ADA\\\"\u003eADA\u003c/a\u003e-houders treasurygeld willen inzetten om bitcoin-liquiditeit naar hun eigen ecosysteem te trekken.\"},\"style\":{\"wordBreak\":\"break-word\"},\"className\":\"first:font-bold md:text-lg text-base paragraph-content\"}],false,false,\"$L6d\"]}],[\"$\",\"$1\",\"2\",{\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cb\u003eDe belangrijkste feiten op een rij:\u003c/b\u003e\"},\"style\":{\"wordBreak\":\"break-word\"},\"className\":\"first:font-bold md:text-lg text-base paragraph-content\"}],false,false,\"$L6e\"]}],[\"$\",\"$1\",\"3\",{\"children\":[\"$undefined\",[\"$\",\"ul\",null,{\"className\":\"\\n          list-content list-outside pl-10\\n          list-disc\\n        \",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"[\u0026\u003ea]:text-primary dark:[\u0026\u003ea]:text-white [\u0026\u003ea]:underline md:text-lg text-base\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cb\u003e\\nStemronde:\u003c/b\u003e Project Alchemy staat sinds 24 juni 2026 als actieve treasury withdrawal open.\\n\"}}],[\"$\",\"li\",\"1\",{\"className\":\"[\u0026\u003ea]:text-primary dark:[\u0026\u003ea]:text-white [\u0026\u003ea]:underline md:text-lg text-base\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cb\u003e\\nDeadline:\u003c/b\u003e De stemming loopt tot 28 juli 2026.\\n\"}}],[\"$\",\"li\",\"2\",{\"className\":\"[\u0026\u003ea]:text-primary dark:[\u0026\u003ea]:text-white [\u0026\u003ea]:underline md:text-lg text-base\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cb\u003e\\nBTC-focus:\u003c/b\u003e Sundial en Charms willen FIRE en ICE bouwen rond bitcoin-reserves.\\n\"}}]]}],false,false,\"$L6f\"]}],[\"$\",\"$1\",\"4\",{\"children\":[\"$undefined\",[\"$\",\"h2\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"Alchemy ligt nu bij de DReps\"},\"style\":{\"wordBreak\":\"break-word\"},\"className\":\"heading-content\",\"id\":\"heading-1\"}],false,false,\"$L70\"]}],[\"$\",\"$1\",\"5\",{\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"Het voorstel heet voluit “Alchemy by Sundial x Charms: Cardano-Native Bitcoin Treasury Protocol”. CardanoCube toont het dossier als actieve governance action met stemdeadline op 28 juli 2026.\"},\"style\":{\"wordBreak\":\"break-word\"},\"className\":\"first:font-bold md:text-lg text-base paragraph-content\"}],false,false,\"$L71\"]}],[\"$\",\"$1\",\"6\",{\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"Daarmee is het geen los plan meer op X. Het ligt nu bij DReps en andere stemgerechtigde partijen.\"},\"style\":{\"wordBreak\":\"break-word\"},\"className\":\"first:font-bold md:text-lg text-base paragraph-content\"}],false,false,\"$L72\"]}],[\"$\",\"$1\",\"7\",{\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"Treasury withdrawals zijn op Cardano echte machtsbesluiten. Het Cardano Developer Portal schrijft dat zulke opnames uit de on-chain treasury een meerderheid van DReps en de Constitutional Committee vragen.\"},\"style\":{\"wordBreak\":\"break-word\"},\"className\":\"first:font-bold md:text-lg text-base paragraph-content\"}],false,false,\"$L73\"]}],[\"$\",\"$1\",\"8\",{\"children\":[\"$undefined\",[\"$\",\"h2\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"Bitcoin moet meer doen dan stil liggen\"},\"style\":{\"wordBreak\":\"break-word\"},\"className\":\"heading-content\",\"id\":\"heading-2\"}],false,false,\"$L74\"]}],[\"$\",\"$1\",\"9\",{\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"Sundial profileert zich als laag tussen Bitcoin-liquiditeit en Cardano smart contracts. Op CardanoCube wordt Sundial neergezet als route tussen Bitcoin’s grote liquiditeit en Cardano’s contractlaag.\"},\"style\":{\"wordBreak\":\"break-word\"},\"className\":\"first:font-bold md:text-lg text-base paragraph-content\"}],false,false,\"$L75\"]}],\"$L76\",\"$L77\",\"$L