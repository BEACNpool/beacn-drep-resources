and-monetizing-impact"},{"_id":"338","fundId":"9","name":"Challenge \u0026 Scouted for Students🎓","slug":"challenge-and-scouted-for-students"},{"_id":"337","fundId":"9","name":"Cross-Chain Collaboration","slug":"cross-chain-collaboration"},{"_id":"333","fundId":"9","name":"DAOs \u003c3 Cardano","slug":"daos-3-cardano"},{"_id":"334","fundId":"9","name":"Dapps, Products \u0026 Integrations","slug":"dapps-products-and-integrations"},{"_id":"336","fundId":"9","name":"Developer Ecosystem","slug":"developer-ecosystem"},{"_id":"340","fundId":"9","name":"dRep improvement and onboarding","slug":"drep-improvement-and-onboarding"},{"_id":"343","fundId":"9","name":"Fund10 challenge setting","slug":"fund10-challenge-setting"},{"_id":"339","fundId":"9","name":"Grow Africa, Grow Cardano","slug":"grow-africa-grow-cardano"},{"_id":"341","fundId":"9","name":"Grow East Asia, Grow Cardano","slug":"grow-east-asia-grow-cardano"},{"_id":"335","fundId":"9","name":"Legal \u0026 Financial Implementations","slug":"legal-and-financial-implementations"},{"_id":"332","fundId":"9","name":"The Great Migration (from Ethereum)","slug":"the-great-migration-from-ethereum"},{"_id":"9400","fundId":"9","name":"Sponsored by Leftovers","slug":"sponsored-by-leftovers"}]},{"_id":"10","fundName":"Fund10","challenges":[{"_id":"353","fundId":"10","name":"Atala PRISM: Launch Ecosystem","slug":"atala-prism-launch-ecosystem"},{"_id":"355","fundId":"10","name":"Building on NMKR","slug":"building-on-nmkr"},{"_id":"380","fundId":"10","name":"Catalyst Fund Operations","slug":"catalyst-fund-operations"},{"_id":"379","fundId":"10","name":"Catalyst Open","slug":"catalyst-open"},{"_id":"381","fundId":"10","name":"Catalyst Systems improvements","slug":"catalyst-systems-improvements"},{"_id":"352","fundId":"10","name":"DAOs ❤ Cardano","slug":"daos-cardano"},{"_id":"351","fundId":"10","name":"Developer Ecosystem - The Evolution","slug":"developer-ecosystem-the-evolution"},{"_id":"346","fundId":"10","name":"Development \u0026 Infrastructure","slug":"development-and-infrastructure"},{"_id":"354","fundId":"10","name":"dRep improvement and onboarding","slug":"drep-improvement-and-onboarding"},{"_id":"349","fundId":"10","name":"OSDE: Open Source Dev Ecosystem","slug":"osde-open-source-dev-ecosystem"},{"_id":"348","fundId":"10","name":"Products \u0026 Integrations","slug":"products-and-integrations"},{"_id":"350","fundId":"10","name":"SPO Tools \u0026 Community Projects","slug":"spo-tools-and-community-projects"},{"_id":"347","fundId":"10","name":"Startups \u0026 Onboarding for Students","slug":"startups-and-onboarding-for-students"},{"_id":"10400","fundId":"10","name":"Sponsored by Leftovers","slug":"sponsored-by-leftovers"}]},{"_id":"11","fundName":"Fund11","challenges":[{"_id":"407","fundId":"11","name":"Cardano Open: Developers","slug":"cardano-open-developers"},{"_id":"408","fundId":"11","name":"Cardano Open: Ecosystem","slug":"cardano-open-ecosystem"},{"_id":"404","fundId":"11","name":"Cardano Use Cases: Concept","slug":"cardano-use-cases-concept"},{"_id":"406","fundId":"11","name":"Cardano Use Cases: Product","slug":"cardano-use-cases-product"},{"_id":"405","fundId":"11","name":"Cardano Use Cases: Solution","slug":"cardano-use-cases-solution"},{"_id":"409","fundId":"11","name":"Catalyst Systems improvements: Discovery","slug":"catalyst-systems-improvements-discovery"},{"_id":"11400","fundId":"11","name":"Sponsored by Leftovers","slug":"sponsored-by-leftovers"}]},{"_id":"12","fundName":"Fund12","challenges":[{"_id":"415","fundId":"12","name":"Cardano Open: Developers","slug":"cardano-open-developers"},{"_id":"416","fundId":"12","name":"Cardano Open: Ecosystem","slug":"cardano-open-ecosystem"},{"_id":"417","fundId":"12","name":"Cardano Partners and Real World Integrations","slug":"cardano-partners-and-real-world-integrations"},{"_id":"412","fundId":"12","name":"Cardano Use Cases: Concept","slug":"cardano-use-cases-concept"},{"_id":"413","fundId":"12","name":"Cardano Use Cases: MVP","slug":"cardano-use-cases-mvp"},{"_id":"414","fundId":"12","name":"Cardano Use Cases: Product","slug":"cardano-use-cases-product"},{"_id":"12400","fundId":"12","name":"Sponsored by Leftovers","slug":"sponsored-by-leftovers"}]},{"_id":"13","fundName":"Fund13","challenges":[{"_id":"422","fundId":"13","name":"Cardano Open: Developers","slug":"cardano-open-developers"},{"_id":"423","fundId":"13","name":"Cardano Open: Ecosystem","slug":"cardano-open-ecosystem"},{"_id":"426","fundId":"13","name":"Cardano Partners: Enterprise R\u0026D","slug":"cardano-partners-enterprise-randd"},{"_id":"427","fundId":"13","name":"Cardano Partners: Growth \u0026 Acceleration","slug":"cardano-partners-growth-and-acceleration"},{"_id":"424","fundId":"13","name":"Cardano Use Cases: Concept","slug":"cardano-use-cases-concept"},{"_id":"425","fundId":"13","name":"Cardano Use Cases: Product","slug":"cardano-use-cases-product"},{"_id":"13400","fundId":"13","name":"Sponsored by Leftovers","slug":"sponsored-by-leftovers"}]},{"_id":"14","fundName":"Fund14","challenges":[{"_id":"3","fundId":"14","name":"Cardano Open: Developers","slug":"cardano-open-developers"},{"_id":"4","fundId":"14","name":"Cardano Open: Ecosystem","slug":"cardano-open-ecosystem"},{"_id":"2","fundId":"14","name":"Cardano Use Cases: Concepts","slug":"cardano-use-cases-concepts"},{"_id":"1","fundId":"14","name":"Cardano Use Cases: Partners \u0026 Products","slug":"cardano-use-cases-partners-and-products"},{"_id":"14400","fundId":"14","name":"Sponsored by Leftovers","slug":"sponsored-by-leftovers"}]},{"_id":"15","fundName":"Fund15","challenges":[{"_id":"7","fundId":"15","name":"Cardano Open: Ecosystem","slug":"cardano-open-ecosystem"},{"_id":"5","fundId":"15","name":"Cardano Partners: Tier-1 Enterprise Integrations","slug":"cardano-partners-tier-1-enterprise-integrations"},{"_id":"6","fundId":"15","name":"Cardano Use Cases: Prototype \u0026 Launch","slug":"cardano-use-cases-prototype-and-launch"},{"_id":"8","fundId":"15","name":"Midnight: Compact DApps","slug":"midnight-compact-dapps"}]}],"project":{"_id":"0198b7e3-1966-71bb-b680-3bac6c933b55","_fundingId":"1400012","fundId":"14","projectName":"Bifrost: Bitcoin-Cardano bridge secured by Cardano SPOs","projectSlug":"bifrost-bitcoin-cardano-bridge-secured-by-cardano-spos","projectStatus":"Active","updatedAt":1782259200000,"description":"\u003cp\u003eCardano\u0026#39;s most urgent narrative is becoming the Bitcoin DeFi layer. Cardano needs a permissionless, safe and always live bridge from and to Bitcoin that anyone can use and integrate.\u003c/p\u003e","summary":"\u003cp\u003eFluidTokens, ZkFold and Lantr have designed a new product called Bifrost: an optimistic bridge that leverages SPOs security and smart contracts to support permissionless BTC peg-ins and peg-outs.\u003c/p\u003e\n","aboutTeam":"\u003cul\u003e\n\u003cli\u003eMatteo Coppola: FluidTokens CEO, author of the original first draft of the Bitcoin bridge. Senior smart contract developer and cloud architect.\u003c/li\u003e\n\u003cli\u003eRaul Rosa Padilla: FluidTokens CTO, co-founder and senior full-stack Cardano developer.\u003c/li\u003e\n\u003cli\u003eVladimir Sinyakov: senior Zero Knowledge researcher and developer, as ZkFold team member he is the author of most ZK solutions in the Cardano ecosystem.\u003c/li\u003e\n\u003cli\u003eAlex Nemish: CTO of Lantr and author of previous attempts to bridge Bitcoin and Cardano\u003c/li\u003e\n\u003cli\u003eOleksii Khodakivskyi: Lantr co-founder and co-proposer of the Bifrost Watchtowers design improvements\u003c/li\u003e\n\u003c/ul\u003e\n","fullDetail":"\u003ch3\u003e[Proposal setup] Proposal title\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003ePlease provide your proposal title\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eBifrost: Bitcoin-Cardano bridge secured by Cardano SPOs\u003c/p\u003e\n\n\u003ch3\u003e[Proposal Summary] Budget Information\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eEnter the amount of funding you are requesting in ADA\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e739000\u003c/p\u003e\n\n\u003ch3\u003e[Proposal Summary] Time\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003ePlease specify how many months you expect your project to last \u003c/strong\u003e\u003c/p\u003e\u003cp\u003e6\u003c/p\u003e\n\n\u003ch3\u003e[Proposal Summary] Translation Information\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003ePlease indicate if your proposal has been auto-translated\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eNo\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eOriginal Language\u003c/strong\u003e\u003c/p\u003e\u003cp\u003een\u003c/p\u003e\n\n\u003ch3\u003e[Proposal Summary] Problem Statement\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eWhat is the problem you want to solve?\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eCardano's most urgent narrative is becoming the Bitcoin DeFi layer. Cardano needs a permissionless, safe and always live bridge from and to Bitcoin that anyone can use and integrate.\u003c/p\u003e\n\n\u003ch3\u003e[Proposal Summary] Supporting Documentation\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eSupporting links\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003ca href=\"https://fluidtokens.com/\" rel=\"noopener\" target=\"_blank\"\u003ehttps://fluidtokens.com/\u003c/a\u003e\u003c/li\u003e,\u003cli\u003e\u003ca href=\"https://github.com/FluidTokens/ft-bifrost-bridge\" rel=\"noopener\" target=\"_blank\"\u003ehttps://github.com/FluidTokens/ft-bifrost-bridge\u003c/a\u003e\u003c/li\u003e,\u003cli\u003e\u003ca href=\"https://github.com/FluidTokens/ft-bifrost-bridge/tree/main/documentation\" rel=\"noopener\" target=\"_blank\"\u003ehttps://github.com/FluidTokens/ft-bifrost-bridge/tree/main/documentation\u003c/a\u003e\u003c/li\u003e,\u003cli\u003e\u003ca href=\"https://github.com/FluidTokens/ft-bifrost-bridge/blob/main/documentation/litepaperV1.pdf\" rel=\"noopener\" target=\"_blank\"\u003ehttps://github.com/FluidTokens/ft-bifrost-bridge/blob/main/documentation/litepaperV1.pdf\u003c/a\u003e\u003c/li\u003e,\u003cli\u003e\u003ca href=\"https://x.com/FluidTokens/status/1946578539970429300\" rel=\"noopener\" target=\"_blank\"\u003ehttps://x.com/FluidTokens/status/1946578539970429300\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\n\n\u003ch3\u003e[Proposal Summary] Project Dependencies\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eDoes your project have any dependencies on other organizations, technical or otherwise?\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eNo\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eDescribe any dependencies or write 'No dependencies'\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eNo dependencies\u003c/p\u003e\n\n\u003ch3\u003e[Proposal Summary] Project Open Source\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eWill your project's outputs be fully open source?\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eYes\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eLicense and Additional Information\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThe product is fully open source under the GPLv3 license.\u003c/p\u003e\n\n\u003ch3\u003e[Theme Selection] Theme\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003ePlease choose the most relevant theme and tag related to the outcomes of your proposal\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eDeFi\u003c/p\u003e\n\n\u003ch3\u003e[Campaign Category] Category Questions\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eDescribe your established collaborations.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eOur product architecture is the result of months of research from:\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eFluidTokens\u003c/strong\u003e - Their well-known senior team brings technical depth in DeFi, token management, account abstraction and development on both Cardano and Bitcoin.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eZkFold\u003c/strong\u003e - Their deep expertise allows proving and verifying Zero Knowledge proofs between Bitcoin and Cardano, running the verifiers on Cardano smart contracts.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eLantr\u003c/strong\u003e - Their previous research on this topic allowed the latest design of the Watchtowers, an open set of parties that submit the Bitcoin blocks on Cardano\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eDescribe funding commitments.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAll the partners’ work done so far for Bifrost has been paid by the partners' time and resources: we strongly believe that a proper Bitcoin-Cardano bridge is a public good that crucially benefits the whole Cardano ecosystem.\u003c/p\u003e\n\u003cp\u003eThis grant will accelerate the development of the solution to a point where all the core components will have been developed and released. While we are committed to accomplish this product anyway, this grant allows us to deliver the results much faster, within the proposed timeline.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eDescribe your key performance metrics.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eOur key metrics for measuring project success include:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eNumber of feedbacks by the Cardano dev community and dApps\u003c/li\u003e\n\u003cli\u003eNumber of feedbacks by the general Cardano community\u003c/li\u003e\n\u003cli\u003eNumber of feedbacks by the Bitcoin community\u003c/li\u003e\n\u003cli\u003eAmount of volume on the Bifrost bridge from and to Bitcoin\u003c/li\u003e\n\u003cli\u003eAmount of fees generated\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch3\u003e[Your Project and Solution] Solution\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003ePlease describe your proposed solution and how it addresses the problem\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eWe solve the bridging BTC problem - enabling BTC DeFi on Cardano - with Bifrost, an optimistic bridge that doesn’t suffer of the typical BitVM limitations (1-of-n trust assumption, liveness for pegging-out and granular peg-outs), leveraging Cardano key properties such as eUTxO architecture, Proof-of-Stake and network strong decentralisation level.\u003c/p\u003e\n\u003cp\u003eThe core idea is to leverage Stake Pools (SPOs) consensus to protect the locked BTC on Bitcoin and to move the whole communication, peg-in and peg-out logic on the Cardano side.\u003c/p\u003e\n\u003cp\u003eSPOs know the Bitcoin confirmed state thanks to the Watchtowers, an open set of players that compete to write the correct chain of new Bitcoin blocks on Cardano. Anyone any time can become a Watchtower, even the user himself.\u003c/p\u003e\n\u003cp\u003eIt’s important to note that Watchtowers cannot forge or change Bitcoin transactions, fully avoiding the risk of scamming SPOs.\u003c/p\u003e\n\u003cp\u003eIn this way, users and institutions can independently peg-in and peg-out without intermediaries, knowing that the pegged-in BTCs are secured by the same entities (the SPOs) that are also already trusted for Cardano security.\u003c/p\u003e\n\u003cp\u003eThe bridge is designed to leverage Cardano, but it can also flawlessly connect Bitcoin to Cardano layer 2s such as Midgard and Sundial.\u003c/p\u003e\n\n\u003ch3\u003e[Your Project and Solution] Impact\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003ePlease define the positive impact your project will have on the wider Cardano community\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eBifrost Bitcoin-Cardano bridge will deliver a critical positive impact in all aspects of our beloved community:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eCardano dApps: the whole DeFi ecosystem will hugely benefit from the secure and consistent volume of BTCs that will arrive on Cardano looking for yield and other DeFi benefits.\u003c/li\u003e\n\u003cli\u003eCardano SPOs: the SPO business model secures the Cardano network and strongly depends on the volume and value of ADA. The strong inflow of BTC will increase both of them dramatically.\u003c/li\u003e\n\u003cli\u003eBitcoin users and institutions: BTC holders are desperate to find yield opportunities that don’t sacrifice the permissionless approach. Cardano and Bifrost solve that.\u003c/li\u003e\n\u003cli\u003eCardano users: ADA holders will benefit in the appreciation of the Cardano chain and ADA, while also enabling many more opportunities thanks to the increased token volume.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch3\u003e[Your Project and Solution] Capabilities \u0026 Feasibility\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eWhat is your capability to deliver your project with high levels of trust and accountability? How do you intend to validate if your approach is feasible?\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAll people involved in our teams are highly senior UTxO researchers and developers: our expertise fully covers Cardano and Bitcoin architecture and development, with a proven track record of successful protocols and infrastructure on both chains. We also have dedicated senior expertise in the Zero Knowledge field to ensure that Cardano on-chain validation allows us to prove anything that happens on the Bitcoin side.\u003c/p\u003e\n\u003cp\u003eAll team members are well known and highly regarded in the Cardano community.\u003c/p\u003e\n\u003cp\u003eFluidTokens is also well known in the Bitcoin community.\u003c/p\u003e\n\u003cp\u003eWe are fully equipped to execute this project from beginning to the end.\u003c/p\u003e\n\n\u003ch3\u003e[Milestones] Project Milestones\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Title\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eBridge Architecture Design Formalization\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Outputs\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eDefine the bridge core components, the flow of the happy and unhappy paths, the main smart contracts, the main algorithms used for signature aggregation and SPOs communication. Select a few relevant Cardano SPOs to receive ongoing feedback during Bifrost development.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eAcceptance Criteria\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\n\u003cli\u003eBridge core componenets are properly defined\u003c/li\u003e\n\u003cli\u003eHappy paths and main unhappy paths are formalized\u003c/li\u003e\n\u003cli\u003eThe smart contracts to develop are defined\u003c/li\u003e\n\u003cli\u003eThe main algorithms have been chosen\u003c/li\u003e\n\u003cli\u003eFound few relevant SPOs to collaborate\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cstrong\u003eEvidence of Completion\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThe official documentation will be updated to include all these outputs. Collaborating SPOs will be announced.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eDelivery Month\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e1\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eCost\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e82000\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eProgress\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e10 %\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Title\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eMinimal Testable Version\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Outputs\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThis iteration includes the implementation of the happy paths of the Watchtowers that post the Bitcoin confirmed blocks on Cardano, the SPOs on-chain registration, the permissionless peg-ins and the peg-outs.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eAcceptance Criteria\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\n\u003cli\u003eThe happy path of Watchtowers behaviour is complete, allowing anyone to be a watchtower and post Bitcoin blocks on Cardano\u003c/li\u003e\n\u003cli\u003eSPOs registration smart contracts are deployed\u003c/li\u003e\n\u003cli\u003ePeg-in smart contracts are deployed\u003c/li\u003e\n\u003cli\u003ePeg-out smart contracts are deployed\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cstrong\u003eEvidence of Completion\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAll smart contracts that involve the Watchtowers happy path, the SPO registration process, the peg-in and the peg-out will be added to the official repository. The Zero Knowledge code of these smart contracts is not included in this milestone.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eDelivery Month\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e3\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eCost\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e207000\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eProgress\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e30 %\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Title\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eMinimal Usable Version\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Outputs\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThis version includes SPOs coordination protocols to aggregate their Bitcoin signatures; the Watchtowers can challenge each other to post the correct Bitcoin fork; Zero Knowledge logic is added to truthfully prove the Bitcoin transactions.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eAcceptance Criteria\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\n\u003cli\u003eSPO coordination protocol is implemented in the dedicated SPO program and allows to aggregate Bitcoin signatures\u003c/li\u003e\n\u003cli\u003eWatchtower can now challenge each other to post the better Bitcoin fork\u003c/li\u003e\n\u003cli\u003eExisting smart contracts now implement Zero Knowledge proofs where needed\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cstrong\u003eEvidence of Completion\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eSPO program is now updated in the repository to allow coordination and signatures. \u003c/p\u003e\n\u003cp\u003eWatchtower program and smart contracts are now updated in the repository to allow fork challenge.\u003c/p\u003e\n\u003cp\u003ePrevious smart contracts now implement the Zero Knowledge code.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eDelivery Month\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e4\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eCost\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e164000\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eProgress\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e50 %\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Title\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eMinimal Loveable Version\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Outputs\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThe unhappy paths and the edge cases are included in this Bifrost iteration, where malicious players, coordination problems and Cardano possible network saturation are correctly managed. Hardening, optimisations and tuning are part of this version.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eAcceptance Criteria\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\n\u003cli\u003eThe onchain smart contracts are updated to include unhappy paths and edge cases\u003c/li\u003e\n\u003cli\u003eThe SPO program includes behaviours to manage unhappy paths and restore the normal flow\u003c/li\u003e\n\u003cli\u003eThe Watchtower program takes into account any possible unhappy situation without stopping\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cstrong\u003eEvidence of Completion\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eIn the official repository, onchain smart contracts, SPO and Watchtower programs are now updated to include and manage edge cases and unhappy paths, while also being optimised and tuned where needed.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eDelivery Month\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e5\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eCost\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e181000\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eProgress\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e80 %\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Title\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eDocumentation, reporting and full end-to-end execution\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eMilestone Outputs\u003c/strong\u003e\u003c/p\u003e\u003cp\u003ePublish open-source code and architecture documentation, with the evaluation of the bridge security, the edge cases and their mitigations. Execution of the main peg-in and peg-out flows. Create a final poll for SPOs to gather feedback about Bifrost, to check the commitment level and to understand how to proceed for the future incentivization phase.\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eAcceptance Criteria\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\n\u003cli\u003eThe Bifrost code is fully open source\u003c/li\u003e\n\u003cli\u003eThe documentation describes the whole architecture, the main design choices, a security evaluaion and explanation of the edge cases with their mitigations\u003c/li\u003e\n\u003cli\u003eA peg-in and a peg-out are executed\u003c/li\u003e\n\u003cli\u003eSPOs participate in the poll for feedback collection\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cstrong\u003eEvidence of Completion\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\n\u003cli\u003eAll code open sourced in the official repository\u003c/li\u003e\n\u003cli\u003eAll documents present in the official repository\u003c/li\u003e\n\u003cli\u003eResults of the SPOs poll in a dedicated document\u003c/li\u003e\n\u003cli\u003eCardano testnet transactions proving the successful peg-in and peg-out of Bitcoin BTC\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cstrong\u003eDelivery Month\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e6\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eCost\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e105000\u003c/p\u003e\n\n\u003cp\u003e\u003cstrong\u003eProgress\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e100 %\u003c/p\u003e\n\n\u003ch3\u003e[Final Pitch] Budget \u0026 Costs\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003ePlease provide a cost breakdown of the proposed work and resources\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eDesign and implementation choices - 82,000 ADA\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eThis is the most delicate task as a good bridge design must take into account several factors such as the blockchains architecture nuances, the possible saturation levels of Cardano network, the presence of bad participants and the scalability factors.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eOn-chain components - 311,000 ADA\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eSmart contracts for all the main actions need to be sound, permissionless and avoid concurrency issues, leveraging Cardano strength points and allowing validation, minting of BTC, etc.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eOff-chain core components - 241,000 ADA\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eWatchtowers monitor the Bitcoin network and post the latest confirmed blocks on Cardano, having to also interact and monitor the Cardano network. The code must be easy to use so anyone can become a Watchtower.\u003c/p\u003e\n\u003cp\u003eSPOs need to manage their Bitcoin keys, monitor the stake distributions, interact with Cardano smart contracts and coordinate safely.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eDocumentation and full flow execution - 105,000 ADA\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eThis version of the Bifrost bridge must be properly described and open-sourced.\u003c/p\u003e\n\u003cp\u003eCatalyst reports and milestones management are included here.\u003c/p\u003e\n\u003cp\u003eExecution of the main end-to-end flows also require some budget\u003c/p\u003e\n\n\u003ch3\u003e[Final Pitch] Value for Money\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eHow does the cost of the project represent value for the Cardano ecosystem?\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThe cost of our product Bifrost represents a critical value for Cardano. \u003c/p\u003e\n\u003cp\u003eCardano as the Bitcoin DeFi layer is one of the most important and urgent narratives for the ecosystem. A solid safe bridge is the only component that is stopping Cardano to start onboarding real BTC.\u003c/p\u003e\n\u003cp\u003eOn-chain volume, ADA value and new users onboarding will immensely benefit from a secure 2-way bridge that taps into the 2.3 trillion $ Bitcoin ecosystem.\u003c/p\u003e\n\u003cp\u003eCardano will also position itself as the first and only top 10 blockchain that is able to directly communicate with Bitcoin.\u003c/p\u003e\n\n\u003ch3\u003e[Required Acknowledgements] Consent \u0026 Confirmation\u003c/h3\u003e\n\n\u003cp\u003e\u003cstrong\u003eTerms and Conditions:\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eYes\u003c/p\u003e","website":"","tags":["DeFi"],"country":"Switzerland","countryData":{"slug":"switzerland"},"continentData":{"slug":"europe"},"horizonGroup":"DeFi","media":[],"ideascaleUrl":null,"funding":{"distributedToDate":{"amount":"246200000000","exp":6,"code":"$ADA"},"remaining":{"amount":"492800000000","exp":6,"code":"$ADA"},"requested":{"amount":"739000000000","exp":6,"code":"$ADA"}},"voting":{"votesCast":585,"yes":{"amount":"256533420000000","exp":6,"code":"$ADA"},"no":null,"abstain":{"amount":"28590646000000","exp":6,"code":"$ADA"},"fundDepletion":{"amount":"7761000000000","exp":6,"code":"$ADA"},"meetsApprovalThreshold":true,"reasonForNotFundedStatus":"","status":"Funded"},"reporting":[],"fund":{"_id":"14","fundName":"Fund14","active":false},"challenge":{"_id":"1","name":"Cardano Use Cases: Partners \u0026 Products","slug":"cardano-use-cases-partners-and-products","fundId":"14","active":false},"submitters":[{"_id":"cardano/oeZnXFJvceC9KRD3SFM6-h_pRrtyKD8nFwt2hfMv0mc","name":"FluidTokens","avatarUrl":"","username":"FluidTokens"}],"completed":null,"leftoverVoting":null,"milestoneDetail":{"projectId":1400012,"startDate":"2025-11-24T10:00:00+00:00","title":"Bifrost: Bitcoin-Cardano bridge secured by Cardano SPOs","currency":{"code":"$ADA","exp":6,"convertible":true},"budget":{"amount":"739000000000","code":"$ADA","exp":6},"fundsDistributed":{"amount":"246200000000","code":"$ADA","exp":6},"complete":2,"inProgress":1,"milestones":[{"cost":75000,"milestone":1,"title":"Bridge Architecture Design Formalization","deliveryMonth":"4","deliveryDate":"2026-03-24T10:00:00+00:00","status":"Completed"},{"cost":214000,"milestone":2,"title":"Minimal Testable Version","deliveryMonth":"5","deliveryDate":"2026-04-24T10:00:00+00:00","status":"Completed"},{"cost":164000,"milestone":3,"title":"Minimal Usable Version","deliveryMonth":"6","deliveryDate":"2026-05-24T10:00:00+00:00","status":"InProgress"},{"cost":138200,"milestone":4,"title":"Minimal Loveable Version","deliveryMonth":"7","deliveryDate":"2026-06-24T10:00:00+00:00","status":"Incomplete"},{"cost":36950,"milestone":5,"title":"Documentation","deliveryMonth":"8","deliveryDate":"2026-07-24T10:00:00+00:00","status":"Incomplete"},{"cost":110850,"milestone":6,"title":"Reporting and full end-to-end execution","deliveryMonth":"9","deliveryDate":"2026-08-24T10:00:00+00:00","status":"Incomplete"}],"lastUpdated":{"days":5,"date":"6/24/2026"}}}},"previewMode":null,"i18nConfig":{"locale":"en","ns":["common"],"resources":{"en":{"common":{"alt-texts":{"become-a-proposal-assesor":"Become a Proposal Assessor","become-a-voter":"Become a voter","submit-an-idea":"Submit an idea"},"banner":{"enabled":"false","link-text":"Learn more here","link-url":"https://projectcatalyst.io/funds/15","title":"\u003cstrong\u003eFund15\u003c/strong\u003e - is now live!\n"},"challenge-projects":{"monthly-report-subheading":"NB: Monthly reporting was deprecated from January 2024 and replaced fully by the Milestones Program framework. ","project-total__heading":"Total so far","project-total__sub-heading":"This is the total amount allocated to {{project}}"},"cta-blocks":{"contribute-to-earn-ada":"Become a proposal assessor and you’ll be rewarded in ada for evaluating and rating submitted ideas for quality assurance.","submit-a-proposal":"Want to solve a problem on Cardano or in the wider world? Find out how to submit a proposal.","vote-on-an-idea":"View the proposals in the current Fund and choose the ones you think will have most impact. To vote, download the Project Catalyst voting app."},"ctas":{"apply-filters":"Apply","clear-filters":"Clear","close-filters":"Close filters","download-completed-report":"Download report","download-voting-results":"Download voting results","learn-more":"Learn more","more-about-funding":"More about funding","read-less":"- Read less","read-less-detail":"Read less detail","read-more":"+ Read more","read-more-detail":"Read more detail","see-more-projects":"See more projects","submit-a-proposal":"Submit a proposal","subscribe":"Subscribe","toggle-filters":"Filter","toggle-selected-filters":"Filter ({{selectedFiltersCount}})","view-category-proposals":"View category proposals","view-current-challenges":"View current challenges","view-less-detail":"View less detail","view-more-detail":"View more detail","view-project":"View project","view-projects":"View projects","view-voting-results":"View results","voting-results":"Voting results"},"custom404":{"404-error":"404 error","body-first":"Sorry, the page you're looking for cannot be found.","body-second":"Try searching \u003cSearch /\u003e or go back to \u003ca\u003ehome\u003c/a\u003e.","home":"Project Catalyst homepage.","or-go-back":"or go back to","sorry":"Sorry! The page you're looking for can't be found. Try searching","title":"404"},"dialog":{"birthday-copy":"Let's explore how Catalyst promotes blockchain and real-world innovation and Cardano ecosystem growth.","birthday-cta-blog":"Read our blog","birthday-cta-blog-href":"/blog/project-catalyst-driving-innovation-and-real-world-impact-on-cardano","birthday-cta-continue":"Continue to the site","birthday-header":"Three years of Project Catalyst"},"error500":{"body-first":"Something went wrong and we're working hard to fix the problem.","body-second":"Try refreshing the page or go to \u003ca\u003ehome\u003c/a\u003e.","home":"Project Catalyst homepage.","sorry":"Sorry","text":"Something went wrong and we're working hard to fix the problem. Try refreshing the page or go to the ","title":"Error 500"},"fund-explorer":{"categories":" categories","category-level-heading":"Proposals","category-level-sub-heading-default":"View all proposals allocated funding","category-level-sub-heading-empty":"proposals have been submitted yet","fund-level-heading":"F{{fundId}} Proposals","sub-heading-default":"View all proposals allocated funding in all ","sub-heading-prelaunch":"We are excited to announce the Fund{{fundId}} categories.","sub-heading-preparation-fund":"Although no proposals have been submitted yet, feel free to explore our ","sub-heading-submission-fund":"Browse all the draft and final submissions directly \u003ca href=\"https://app.projectcatalyst.io/\" target=\"_blank\"\u003ein the Catalyst App\u003c/a\u003e (desktop only)."},"fund-stages":{"community-review-closed-body-copy":"What’s on right now? Once \u003ca href=\"https://docs.projectcatalyst.io/current-fund/community-review\" target=\"_blank\"\u003eCommunity Review\u003c/a\u003e is concluded, all the outcomes of the innovation stage will be plugged into governance (voting) shortly. In the meantime, if you successfully registered prior to the voting power snapshot - get ready to start voting. New voting registrations for Fund15 after the voting snapshot are no longer accepted. ","community-review-closed-hero-copy":"\u003cp\u003eFinalized proposals are reviewed by the community, who are rewarded in ada to offer their opinions and evaluate and rate proposals against impact, feasibility, resources, value for money, and success metrics.\u003c/p\u003e\n\nLearning about Fund15 for the first time?\u003cbr/\u003e Dive into our \u003ca href=\"https://projectcatalyst.io/f15launchguide\"\u003eF15 Launch Guide\u003c/a\u003e and review \u003ca href=\"https://docs.projectcatalyst.io/current-fund/fund-basics/fund-rules\"\u003eFund Rules\u003c/a\u003e.","community-review-open-body-copy":"\u003cp\u003e The Community Review stage is active until Jan 5, 2026. The stage consists of two key phases: \u003cp/\u003e\n\n\u003cp\u003e First is the \u003ca href=\"https://docs.projectcatalyst.io/current-fund/community-review/community-review-process\"\u003e\u003cstrong\u003eProposal Review\u003c/strong\u003e\u003c/a\u003e, which runs from the week of Dec 1 until Dec 15 (6:00 AM UTC). During this time, Community Reviewers will share their feedback on proposals.\u003c/p\u003e\n\n\u003cp\u003eThis is followed by the \u003ca href=\"https://docs.projectcatalyst.io/current-fund/community-review/community-moderation-process\"\u003e \u003cstrong\u003eQuality Control\u003c/strong\u003e\u003c/a\u003e phase from the week of Dec 15 until Jan 5 (6:00 AM UTC), where Community Moderators assess all reviews to ensure fairness and quality.\u003c/p\u003e\n\n\u003cp\u003e For those who have submitted proposals, now is the perfect time to share your work with the community to socialize them. You can still find all submitted proposals in the CatalystApp by using your unique links. These can be found in this  \u003ca href=\"https://docs.google.com/spreadsheets/d/1ZTKjr1bFykV7Cewhnw8iM6KdRQYiLQc2JZJqHSSGVBU/edit?usp=sharing\"\u003eCSV version\u003c/a\u003e while proposals progress through the Community Review stage. Please be aware that all submissions also undergo \u003ca href=\"https://docs.projectcatalyst.io/current-fund/community-review/community-moderation-process/l2-moderation-bounty-guidance-for-community-moderators\"\u003e\u003cstrong\u003ea standard moderation process\u003c/strong\u003e\u003c/a\u003e and check against adherence to \u003ca href=\"https://docs.projectcatalyst.io/current-fund/fund-basics/fund-rules\"\u003e\u003cstrong\u003eFund Rules.\u003c/strong\u003e \u003c/a\u003e \u003c/p\u003e\n\n\u003cp\u003e Finally, looking ahead to the vote, we encourage everyone to prepare. To participate, you must register before the Fund15 snapshot, which is scheduled for\u003cstrong\u003e Jan 4, 2026 @ 9:45 PM UTC\u003c/strong\u003e. \u003c/p\u003e\n\n\u003ca href=\"https://docs.projectcatalyst.io/current-fund-basics/how-to-register-as-a-voter\"\u003e\u003cstrong\u003e Find out how to register as a voter\u003c/strong\u003e \u003c/a\u003e\n\n\u003cp\u003eAlready registered to vote? Download the voting apps to participate easily when voting opens on Jan 13.\u003c/p\u003e","community-review-open-hero-copy":"\u003cp\u003eCommunity Review is now live! Finalized proposals are reviewed by the community, who are rewarded in ada to offer their opinions and evaluate proposals against impact, feasibility, and value for money.\n\u003c/p\u003e","community-voting-closed-body-copy":"Voting is now closed - check back here soon to view the results. ","community-voting-closed-hero-copy":"Voting has now concluded. A huge thank you to all who participated! A full breakdown of the results will be publicly available following the validation period.\n","community-voting-open-body-copy":"Vote for your favourite proposal before \u003cstrong\u003e 27 Jan 2026 (11:00AM UTC)\u003c/strong\u003e.\u2028To learn more on how to vote, please visit our \u003ca href=\"https://docs.projectcatalyst.io/current-fund-basics/voting\"\u003eguidelines\u003c/a\u003e. Please note that the voting power snapshot has already taken place on 4 Jan 2026 (9:45PM UTC), and we are no longer accepting new voter registrations for Fund15.\n\n\n\n","community-voting-open-hero-copy":"\u003cp\u003eCommunity voting is now live. This is a pivotal moment for all proposer teams that are looking to get approval from the Cardano community to proceed towards onboarding steps, and hence execution of their ideas. Ready to cast your vote? Time is now.\u003c/p\u003e\n\n\u003cp\u003eLearning about Fund15 for the first time? \n\u003cbr /\u003e\nDive into our \u003ca href=\"https://projectcatalyst.io/f15launchguide\"\u003eF15 Launch Guide\u003c/a\u003e and review \u003ca href=\"https://docs.projectcatalyst.io/current-fund/fund-basics/fund-rules\"\u003eFund Rules\u003c/a\u003e.\u003c/p\u003e","hero-copy":"Explore the challenges, ideas, and metrics for Fund{{number}}\n","hero-title":"Fund{{number}}","onboarding-hero-copy":"\u003cp\u003eOnboarding community-selected proposals fosters accountability, showcases impact, and sets expectations. It involves proof of life meetings and milestone approval by community reviewers. This process guides proposals progress and demonstrates grant program value to the community.\u003c/p\u003e\n\n\u003cp\u003eFor more information check our \u003ca href=\"https://docs.projectcatalyst.io/current-fund/project-onboarding\"\u003eOnboarding Guide\u003c/a\u003e.\u003c/p\u003e","prelaunch-body-first-column-copy":"\u003cp\u003eFund15 is here with four innovation categories to choose from. Explore each of them further down below. If you missed the official launch event - make sure to \u003ca href=\"https://x.com/Catalyst_onX/status/1986087902833500220\" target=\"_blank\"\u003erewatch it here\u003c/a\u003e to get up to speed.\u003c/p\u003e\n\n\u003cp\u003eDon’t forget to join us for the next live event. \u003ca href=\"/news/town-hall\"\u003eRegister here\u003c/a\u003e to save your front row seat. It will also be live streamed on \u003ca href=\"https://x.com/Catalyst_onX\" target=\"_blank\"\u003eX\u003c/a\u003e and \u003ca href=\"https://www.youtube.com/c/IohkIo\" target=\"_blank\"\u003eYouTube\u003c/a\u003e. Hit the notification bell not to miss it.\u003c/p\u003e\n\n\u003cMainContainer\u003e\u003cdiv\u003e\u003cSpeakerphone /\u003e \u003c/div\u003e\u003cdiv\u003eShort on time? Dive into our excellent \u003ca href=\"https://projectcatalyst.io/f15launchguide.pdf\"\u003eF15 Launch Guide\u003c/a\u003e ","prelaunch-body-heading":"Want to get involved?","prelaunch-body-second-column-copy":"\u003cp\u003eMany new updates are introduced in Fund15. Make sure to \u003ca href=\"https://docs.projectcatalyst.io/current-fund/fund-basics\" target=\"blank\"\u003efamiliarize yourself with all\u003c/a\u003e and ensure you are ready to participate. Proposal submission is expected to open in the week of Nov 10 and be open until Nov 27.\u003c/p\u003e\n\n\u003cp\u003eFor regular updates - please follow us \u003ca href=\"https://x.com/Catalyst_onX\" target=\"_blank\"\u003eon X\u003c/a\u003e, join our \u003ca href=\"https://t.me/cardanocatalyst\" target=\"_blank\"\u003eTelegram\u003c/a\u003e and \u003ca href=\"https://discord.gg/2RnUtK8\" target=\"_blank\"\u003eDiscord\u003c/a\u003e communities, sign up to \u003ca href=\"https://mpc.projectcatalyst.io/newsletter-signup\" target=\"_blank\"\u003eour newsletter\u003c/a\u003e, or join us live at our weekly \u003ca href=\"https://projectcatalyst.io/news/town-hall\" target=\"_blank\"\u003eTownHall\u003c/a\u003e.\u003c/p\u003e","prelaunch-body-second-column-heading":"What happens next?","prelaunch-date-heading":"New funding round is here. \u003cstrong\u003e₳20M\u003c/strong\u003e available in Cardano categories and an additional \u003cstrong\u003e250K $USDM\u003c/strong\u003e from Midnight.","prelaunch-hero-copy":"By stepping into Project Catalyst, you’ve just tapped into the world’s largest decentralized innovation platform.","prelaunch-launch-guide-heading":" ","results-body-cta":"View Fund{{ number }} results","results-hero-copy":"The voting period has now concluded and the results are in, thank you to all who took part. The selected projects will now be onboarded. For more information on how to validate the voting results please check this \u003ca href=\"https://docs.projectcatalyst.io/current-fund/voting/how-to-audit-the-vote\"\u003eguide\u003c/a\u003e.","submission-closed-body-copy":"Submit proposals by\u003cstrong\u003e  Nov 27, 6 AM UTC\u003c/strong\u003e. ","submission-hero-copy":"\u003cp\u003eThis round, we're dedicating \u003cstrong\u003e₳20,000,000 from the Cardano Treasury\u003c/strong\u003e and an additional \u003ca href=\"https://projectcatalyst.io/funds/15/midnight-compact-dapps\"\u003e\u003cstrong\u003e$USDM 250,000 from the Midnight Foundation\u003c/strong\u003e\u003c/a\u003e to power the next wave of community-driven innovation. If you have an idea that can strengthen the ecosystem, we want to help you build it. Pitch your project to the community and get the funding to bring it to life. \u003c/p\u003e\n\u003cp\u003eIf you missed the official F15 launch event - make sure to \u003ca href=\"https://x.com/Catalyst_onX/status/1986087902833500220\"\u003erewatch it here\u003c/a\u003e to get up to speed.\u003c/p\u003e\n\n\u003cMainContainer\u003e\n\u003cdiv\u003e\u003cSpeakerphone /\u003e \u003c/div\u003e\n\u003cdiv\u003e\nBefore you submit, please be aware that Fund15 introduces significant new updates around eligibility and guardrails. It is essential to read your selected \u003ca href=\"https://docs.projectcatalyst.io/current-fund/fund-basics/category-scopes\"\u003e\u003cstrong\u003eCategory Brief\u003c/strong\u003e\u003c/a\u003e and \u003ca href=\"https://docs.projectcatalyst.io/current-fund/fund-basics/fund-rules\"\u003e\u003cstrong\u003eFund Rules\u003c/strong\u003e\u003c/a\u003e to understand these new requirements. Familiarizing yourself with these documents will help you avoid surprises and ensure your proposal qualifies.\n\u003c/div\u003e\n\u003c/MainContainer\u003e\n\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eWant to help guide Catalyst funding? Good funding decisions are built on good feedback, and we need your help to review proposals for their impact, feasibility, and value for money. In return, you'll be rewarded for your insights. To get started, read the \u003ca href=\"https://docs.projectcatalyst.io/current-fund/community-review\"\u003e\u003cstrong\u003eReviewer Guide\u003c/strong\u003e\u003c/a\u003e, wait for registrations to open in the Catalyst App, and make sure to register before the application window closes on \u003cstrong\u003eNov 27, 6 AM UTC\u003c/strong\u003e.\u003c/p\u003e\n\n\u003cp\u003eFor regular updates - please follow us \u003ca href=\"https://x.com/Catalyst_onX\" target=\"_blank\"\u003eon X\u003c/a\u003e, join our \u003ca href=\"https://t.me/cardanocatalyst\" target=\"_blank\"\u003eTelegram\u003c/a\u003e and \u003ca href=\"https://discord.gg/2RnUtK8\" target=\"_blank\"\u003eDiscord\u003c/a\u003e communities, sign up to \u003ca href=\"https://mpc.projectcatalyst.io/newsletter-signup\" target=\"_blank\"\u003eour newsletter\u003c/a\u003e, or join us live at our weekly \u003ca href=\"https://projectcatalyst.io/news/town-hall\" target=\"_blank\"\u003eTownHall\u003c/a\u003e.\u003c/p\u003e","submission-open-body-copy":"Submit proposals by \u003cstrong\u003eNov 27, 6 AM UTC\u003c/strong\u003e "},"funds-challenges":{"active-challenge-ideas__heading":"Proposals","challenge-filters-all":"All","challenge-filters-approved":"Approved","challenge-filters-complete":"Complete","challenge-filters-funded":"Funded","challenge-filters-in-progress":"In progress","challenge-filters-not-approved":"Not approved","challenge-filters-num-results":"Showing {{count}} of {{total}} projects","challenge-ideas__heading":"Proposals","challenge-ideas__sub-heading":"View all the ideas that were allocated funding in this challenge.","challenge-placeholder-content":"Information coming soon","challenge-total__heading":"Total so far","challenge-total__sub-heading":"This is the total amount allocated to {{challenge}}"},"funds-details":{"categories__heading":"Categories ({{count}})","categories__sub-heading":"View the categories and funded ideas in this funding round.","challenges__heading":"Challenges ({{count}})","challenges__sub-heading":"View the challenges and funded ideas in this funding round.","fund-total__heading":"Fund{{number}} total","fund-total__sub-heading":"The total amount allocated in Fund{{number}}","sub-title":"Explore the challenges, ideas, and metrics for Fund{{number}}","title":"Fund{{number}}"},"funds-overview":{"charts__budget":"Budget","charts__challenges":"Challenges","fund-comparison-copy":"Discover the total number of proposals, both in progress and completed, for each fund.","fund-comparison-heading":"Proposals per fund","fund-comparison-y-axis-legend":"Number of proposals","fund-totals__heading":"Fund totals","fund-totals__sub-heading":"View the total amounts allocated in each Fund.","ideas-and-votes-total__heading":"Final results","ideas-and-votes-total__sub-heading":"See the amount of ideas and votes in each Fund.","sub-title":"Project Catalyst turns economic power into innovation power by using the Cardano Treasury to incentivize and fund community-approved ideas.","title":"Funds Overview","total-so-far__heading":"Total so far","total-so-far__sub-heading":"This is the total amount Project Catalyst has allocated to projects to date."},"get-involved":{},"glossary":{"funds_funding-status-approved-content":"When a proposal is ‘Approved’, it means it received enough support to receive funding (at least 1% of the total registered voting power voted ‘YES’). But only those proposals that most people say 'YES' to get money first until there's no funding left in that category.","funds_funding-status-approved-heading":"Approved","funds_funding-status-funded-content":"Meets all approval criteria; the highest ‘YES’ result gets funding first until the remaining budget is depleted in the category and unable to fully fund the next approved proposal. If the amount requested by a proposal is larger than the remaining category amount at any point, it is skipped.\n","funds_funding-status-funded-heading":"Funded","funds_funding-status-heading":"Proposal Status","funds_funding-status-not-approved-content":"Proposals that did not meet criteria for approval and were not eligible for funding. Each proposal needs to get enough 'YES' votes equal to 1% or more of total registered voting power in a funding round in order to be approved.","funds_funding-status-not-approved-heading":"Not Approved","funds_funding-status-not-funded-content":"Proposals that met approval criteria but whose budgets exceeded the remaining category budget. Some 'Not Funded' proposals can get second chance via 'Sponsored by Leftovers' category. Proposals can be approved but not funded due to lack of funding budget availability in a relevant category.","funds_funding-status-not-funded-heading":"Not Funded","funds_funding-status-onboarding-content":"Project is being onboarded.","funds_funding-status-subheading":"Final status of every proposal based on meeting the funding criteria and relevant thresholds.","funds_status-heading":"Proposal status","funds_status-subheading":"Explore terms that provide detailed insights into the progress and status of each proposal, ultimately determining their final standing based on meeting funding criteria and relevant thresholds.","heading":"Glossary","subheading":"Enclosed are key terms and their corresponding definitions to enhance your comprehension as you navigate through the findings.","terms_approval-criteria-content":"At least 1% of the total registered voting power must vote ‘YES’ on a proposal. In Fund11, there was ₳4,535,989,461 as a total registered voting power as accounted for by the snapshot. To be accepted (become an ‘approved proposal’ as well as be eligible for funding), a proposal must be voted by at least 0.01 * ₳4,535,989,461 = ₳45,359,894.61. ‘ABSTAIN’ votes do not count towards the acceptance threshold of 1%.","terms_approval-criteria-heading":"Approval Criteria","terms_categories-total-budget":"This represents the total budget available in this category","terms_funds-distribution-content":"Proposals are ranked by the highest ‘YES’ votes and funded one by one until the category budget runs out. Any leftover funds excludes proposals submitted in ‘Cardano Use Cases: Product’ and ‘Catalyst Systems Improvements’ categories.","terms_funds-distribution-heading":"Fund Distribution Logic","terms_funds-remaining-content":"Funds remaining within the category","terms_funds-remaining-heading":"Funds remaining","terms_funds-requested-content":"Funds requested by all proposals.","terms_funds-requested-content-overview":"Funding shown includes proposals with ADA budgets, converted to USD at fund result time. Ecosystem role incentives are excluded. Figures are estimates - see individual proposal pages for details.","terms_funds-requested-content_excluding-incentives":"Funds requested by funded projects. Please note, any ecosystem role incentives are not included in these figures.","terms_funds-requested-heading":"Funds Requested","terms_funds-total-budget":"This represents total budget available in {{fund}}, including ecosystem incentives.","terms_funds-total-distributed":"Total to be distributed","terms_leftovers-content":"There's some funds left in each category that haven't been given out. All that leftover funding is put together into a new category called 'Sponsored by Leftovers'. All approved (and not yet funded) proposals across the entire Fund are eligible for this funding, except proposals from the 'Cardano Use Cases: Product' or 'Catalyst Systems Improvements' categories.","terms_leftovers-heading":"Leftovers","terms_proposal-content":"Title of the proposal is a link that will bring you to the proposal detail page.","terms_proposal-heading":"Proposal","terms_total-budget-heading":"Total Budget","terms_unique-wallets-content":"The number of Cardano wallets that take an active part in the Catalyst voting event. Each wallet can vote once per proposal. The number indicated by each proposal represents a number of unique wallets casting a vote for that specific proposal.","terms_unique-wallets-heading":"Unique Wallets","terms_votes-abstain-content":"Total voting power in ada casting an ‘ABSTAIN’ vote from all wallets combined. ‘ABSTAIN’ votes can be found in the results CSV for reference and do not count towards the approval criteria thresholds.","terms_votes-abstain-heading":"‘ABSTAIN’ Votes","terms_votes-no-content":"Total voting power applied in opposition of a proposal","terms_votes-no-heading":"Votes No","terms_votes-results-content":"Total votes yes minus total votes no.","terms_votes-results-heading":"Vote Results","terms_votes-yes-content":"Total voting power in ada casting a ‘YES’ vote applied in support/favor of a proposal from all wallets combined counting towards approval criteria thresholds.","terms_votes-yes-heading":"‘YES’ Votes","terms_voting-power-content":"Amount of ada registered to vote in Catalyst determined by the voting power snapshot unique for every funding round. For Fund11, the snapshot took place on Jan 15, 21:45 UTC. Each wallet has its own unique voting power based on the balance on the day/time of the snapshot. Each time a wallet casts a vote, it uses its full voting power applied to a proposal. This can be done only once per each proposal: ‘YES’ or ‘ABSTAIN’.","terms_voting-power-heading":"Voting Power","toggle_view-less":"- View Less","toggle_view-more":"+ View More"},"glossary-f12":{"funds_funding-status-approved-content":"When a proposal is ‘Approved’, it means it received enough support to receive funding (at least 1% of the total registered voting power voted ‘YES’). But only those proposals that most people say 'YES' to get money first until there's no funding left in that category.","funds_funding-status-approved-heading":"Approved","funds_funding-status-funded-content":"Meets all approval criteria; the highest ‘YES’ result gets funding first until the remaining budget is depleted in the category and unable to fully fund the next approved proposal. If the amount requested by a proposal is larger than the remaining category amount at any point, it is skipped.\n","funds_funding-status-funded-heading":"Funded","funds_funding-status-heading":"Proposal Status","funds_funding-status-not-approved-content":"Proposals that did not meet criteria for approval and were not eligible for funding. Each proposal needs to get enough 'YES' votes equal to 1% or more of total registered voting power in a funding round in order to be approved.","funds_funding-status-not-approved-heading":"Not Approved","funds_funding-status-not-funded-content":"Proposals that met approval criteria but whose budgets exceeded the remaining category budget. Some 'Not Funded' proposals can get second change via 'Sponsored by Leftovers' category. Proposals can be approved but not funded due to lack of funding budget availability in a relevant category.","funds_funding-status-not-funded-heading":"Not Funded","funds_funding-status-subheading":"Final status of every proposal based on meeting the funding criteria and relevant thresholds.","funds_status-heading":"Proposal status","funds_status-subheading":"Explore terms that provide detailed insights into the progress and status of each proposal, ultimately determining their final standing based on meeting funding criteria and relevant thresholds.","heading":"Glossary","subheading":"Enclosed are key terms and their corresponding definitions to enhance your comprehension as you navigate through the findings.","terms_approval-criteria-content":"At least 1% of the total registered voting power must vote ‘YES’ on a proposal. In Fund12, there was ₳4,589,303,769 as a total registered voting power as accounted for by the snapshot. To be accepted (become an ‘approved proposal’ as well as be eligible for funding), a proposal must be voted by at least 0.01 * ₳4,589,303,769 = ₳45,893,037.69. ‘ABSTAIN’ votes do not count towards the acceptance threshold of 1%.","terms_approval-criteria-heading":"Approval Criteria","terms_categories-total-budget":"This represents the total budget available in this category","terms_funds-distribution-content":"Proposals are ranked by the highest ‘YES’ votes and funded one by one until the category budget runs out. Any leftover funds excludes proposals submitted in ‘Cardano Use Cases: Product’ and ‘Cardano Partners \u0026 Real World Integrations’ categories.","terms_funds-distribution-heading":"Fund Distribution Logic","terms_funds-remaining-content":"Funds remaining within the category","terms_funds-remaining-heading":"Funds remaining","terms_funds-requested-content":"Funds requested by all proposals.","terms_funds-requested-content-overview":"Includes Fund 10 and 11 total funds, converted to USD at the time of fund launch. Please note, any ecosystem role incentives are not included in these figures.","terms_funds-requested-content_excluding-incentives":"Funds requested by funded projects. Please note, any ecosystem role incentives are not included in these figures.","terms_funds-requested-heading":"Funds Requested","terms_funds-total-budget":"This represents total budget available in {{fund}}, including ecosystem incentives.","terms_funds-total-distributed":"Total to be distributed","terms_leftovers-content":"There's some funds left in each category that haven't been given out. All that leftover funding is put together into a new category called 'Sponsored by Leftovers'. All approved (and not yet funded) proposals across the entire Fund are eligible for this funding, except proposals from the 'Cardano Use Cases: Product' or 'Cardano Partners \u0026 Real World Integrations' categories.","terms_leftovers-heading":"Leftovers","terms_proposal-content":"Title of the proposal is a link that will bring you to the proposal detail page.","terms_proposal-heading":"Proposal","terms_total-budget-heading":"Total Budget","terms_unique-wallets-content":"The number of Cardano wallets that take an active part in the Catalyst voting event. Each wallet can vote once per proposal. The number indicated by each proposal represents a number of unique wallets casting a vote for that specific proposal.","terms_unique-wallets-heading":"Unique Wallets","terms_votes-abstain-content":"Total voting power in ada casting an ‘ABSTAIN’ vote from all wallets combined. ‘ABSTAIN’ votes can be found in the results CSV for reference and do not count towards the approval criteria thresholds.","terms_votes-abstain-heading":"‘ABSTAIN’ Votes","terms_votes-no-content":"Total voting power applied in opposition of a proposal","terms_votes-no-heading":"Votes No","terms_votes-results-content":"Total votes yes minus total votes no.","terms_votes-results-heading":"Vote Results","terms_votes-yes-content":"Total voting power in ada casting a ‘YES’ vote applied in support/favor of a proposal from all wallets combined counting towards approval criteria thresholds.","terms_votes-yes-heading":"‘YES’ Votes","terms_voting-power-content":"Amount of ada registered to vote in Catalyst determined by the voting power snapshot unique for every funding round. For Fund12, the snapshot took place on Jun 18, 21:45 UTC. Each wallet has its own unique voting power based on the balance on the day/time of the snapshot. Each time a wallet casts a vote, it uses its full voting power applied to a proposal. This can be done only once per each proposal: ‘YES’ or ‘ABSTAIN’.","terms_voting-power-heading":"Voting Power","toggle_view-less":"- View Less","toggle_view-more":"+ View More"},"glossary-f13":{"funds_funding-status-approved-content":"When a proposal is ‘Approved’, it means it received enough support to receive funding (at least 1% of the total registered voting power voted ‘YES’). But only those proposals that most people say 'YES' to get money first until there's no funding left in that category.","funds_funding-status-approved-heading":"Approved","funds_funding-status-funded-content":"Meets all approval criteria; the highest ‘YES’ result gets funding first until the remaining budget is depleted in the category and unable to fully fund the next approved proposal. If the amount requested by a proposal is larger than the remaining category amount at any point, it is skipped.\n","funds_funding-status-funded-heading":"Funded","funds_funding-status-heading":"Proposal Status","funds_funding-status-not-approved-content":"Proposals that did not meet criteria for approval and were not eligible for funding. Each proposal needs to get enough 'YES' votes equal to 1% or more of total registered voting power in a funding round in order to be approved.","funds_funding-status-not-approved-heading":"Not Approved","funds_funding-status-not-funded-content":"Proposals that met approval criteria but whose budgets exceeded the remaining category budget. Some 'Not Funded' proposals can get second change via 'Sponsored by Leftovers' category. Proposals can be approved but not funded due to lack of funding budget availability in a relevant category.","funds_funding-status-not-funded-heading":"Not Funded","funds_funding-status-subheading":"Final status of every proposal based on meeting the funding criteria and relevant thresholds.","funds_status-heading":"Proposal status","funds_status-subheading":"Explore terms that provide detailed insights into the progress and status of each proposal, ultimately determining their final standing based on meeting funding criteria and relevant thresholds.","heading":"Glossary","subheading":"Enclosed are key terms and their corresponding definitions to enhance your comprehension as you navigate through the findings.","terms_approval-criteria-content":"At least 1% of the total registered voting power must vote ‘YES’ on a proposal. In Fund13, there was ₳4,803,572,582 as a total registered voting power as accounted for by the snapshot. To be accepted (become an ‘approved proposal’ as well as be eligible for funding), a proposal must be voted by at least 0.01 * ₳4,803,572,582 = ₳48,035,725.82. ‘ABSTAIN’ votes do not count towards the acceptance threshold of 1%.","terms_approval-criteria-heading":"Approval Criteria","terms_categories-total-budget":"This represents the total budget available in this category","terms_funds-distribution-content":"Proposals are ranked by the highest ‘YES’ votes and funded one by one until the category budget runs out. Any leftover funds excludes proposals submitted in ‘Cardano Use Cases: Product’ and both ‘Cardano Partners’ categories.","terms_funds-distribution-heading":"Fund Distribution Logic","terms_funds-remaining-content":"Funds remaining within the category","terms_funds-remaining-heading":"Funds remaining","terms_funds-requested-content":"Funds requested by all proposals.","terms_funds-requested-content-overview":"Includes Fund 10 and 11 total funds, converted to USD at the time of fund launch. Please note, any ecosystem role incentives are not included in these figures.","terms_funds-requested-content_excluding-incentives":"Funds requested by funded projects. Please note, any ecosystem role incentives are not included in these figures.","terms_funds-requested-heading":"Funds Requested","terms_funds-total-budget":"This represents total budget available in {{fund}}, including ecosystem incentives.","terms_funds-total-distributed":"Total to be distributed","terms_leftovers-content":"There's some funds left in each category that haven't been given out. All that leftover funding is put together into a new category called 'Sponsored by Leftovers'. All approved (and not yet funded) proposals that have a maximum of one funded entry in Fund13 across the entire Fund are eligible for this funding, except proposals from the 'Cardano Use Cases: Product' or both ‘Cardano Partners’ categories.","terms_leftovers-heading":"Leftovers","terms_proposal-content":"Title of the proposal is a link that will bring you to the proposal detail page.","terms_proposal-heading":"Proposal","terms_total-budget-heading":"Total Budget","terms_unique-wallets-content":"The number of Cardano wallets that take an active part in the Catalyst voting event. Each wallet can vote once per proposal. The number indicated by each proposal represents a number of unique wallets casting a vote for that specific proposal.","terms_unique-wallets-heading":"Unique Wallets","terms_votes-abstain-content":"Total voting power in ada casting an ‘ABSTAIN’ vote from all wallets combined. ‘ABSTAIN’ votes can be found in the results CSV for reference and do not count towards the approval criteria thresholds.","terms_votes-abstain-heading":"‘ABSTAIN’ Votes","terms_votes-no-content":"Total voting power applied in opposition of a proposal","terms_votes-no-heading":"Votes No","terms_votes-results-content":"Total votes yes minus total votes no.","terms_votes-results-heading":"Vote Results","terms_votes-yes-content":"Total voting power in ada casting a ‘YES’ vote applied in support/favor of a proposal from all wallets combined counting towards approval criteria thresholds.","terms_votes-yes-heading":"‘YES’ Votes","terms_voting-power-content":"Amount of ada registered to vote in Catalyst determined by the voting power snapshot unique for every funding round. For Fund13, the snapshot took place on Nov 20, 21:45 UTC. Each wallet has its own unique voting power based on the balance on the day/time of the snapshot. Each time a wallet casts a vote, it uses its full voting power applied to a proposal. This can be done only once per each proposal: ‘YES’ or ‘ABSTAIN’.","terms_voting-power-heading":"Voting Power","toggle_view-less":"- View Less","toggle_view-more":"+ View More"},"glossary-generic":{"funds_funding-status-approved-content":"When a proposal is ‘Approved’, it means it received enough support to be eligible for funding (at least 1% of the total registered voting power voted ‘YES’). Proposals are ranked by the highest number of ‘YES’ votes and funded one by one until the category budget runs out.","funds_funding-status-approved-heading":"Approved","funds_funding-status-funded-content":"A proposal that meets all approval criteria. The highest ‘YES’ result gets funding first until the remaining budget is depleted in the category and unable to fully fund the next approved proposal. If the amount requested by a proposal is larger than the remaining category amount at any point, it is skipped.","funds_funding-status-funded-heading":"Funded","funds_funding-status-heading":"Proposal Status","funds_funding-status-not-approved-content":"Proposals that did not meet the criteria for approval and were not eligible for funding. Each proposal needs enough 'YES' votes, equal to 1% or more of total registered voting power in a funding round, in order to be approved.","funds_funding-status-not-approved-heading":"Not Approved","funds_funding-status-not-funded-content":"Proposals that met approval criteria but whose budgets exceeded the remaining category budget. Some 'Not Funded' proposals can get a second chance via the 'Sponsored by Leftovers' category. Proposals can also be approved but not funded due to lack of funding budget availability in a relevant category.","funds_funding-status-not-funded-heading":"Not Funded","funds_funding-status-onboarding-content":"Project is being onboarded.","funds_funding-status-subheading":"Final status of every proposal based on meeting the funding criteria and relevant thresholds.","funds_status-heading":"Proposal status","funds_status-subheading":"Explore terms that provide detailed insights into the progress and status of each proposal, ultimately determining their final standing based on meeting funding criteria and relevant thresholds.","heading":"Glossary","subheading":"Enclosed are key terms and their corresponding definitions to help with your understanding of the results.","terms_approval-criteria-content":"At least 1% of the total registered voting power, as determined by the voting power snapshot, must vote ‘YES’ on a proposal. This allows a proposal to be accepted and become an ‘approved proposal’ as well as be eligible for funding. ‘ABSTAIN’ votes do not count towards the acceptance threshold of 1%.","terms_approval-criteria-heading":"Approval Criteria","terms_categories-total-budget":"This represents the total budget available in this category","terms_funds-distribution-content":"Proposals are ranked by the highest number of ‘YES’ votes and funded one by one until the category budget runs out. Leftover funds from each category are combined and some further eligible proposals can receive funding (see ‘Leftovers’).","terms_funds-distribution-heading":"Fund Distribution Logic","terms_funds-remaining-content":"Funds remaining within the category","terms_funds-remaining-heading":"Funds remaining","terms_funds-requested-content":"Funds requested by all proposals.","terms_funds-requested-content-overview":"Includes Fund 10, 11, 12 and 13 total funds, converted to USD at the time of fund results. Please note, any ecosystem role incentives are not included in these figures.","terms_funds-requested-content_excluding-incentives":"Funds requested by funded projects. Please note, any ecosystem role incentives are not included in these figures.","terms_funds-requested-heading":"Funds Requested","terms_funds-total-budget":"This represents total budget available in {{fund}}, including ecosystem incentives.","terms_funds-total-distributed":"Total to be distributed","terms_leftovers-content":"Some funds are left unallocated in each category as there is not enough remaining budget to allocate to the next eligible proposal (see ‘Fund Distribution Logic’). These leftover funds are combined from all categories, and create a new category called 'Sponsored by Leftovers'. ","terms_leftovers-heading":"Leftovers","terms_proposal-content":"An idea put forward by members of the community seeking funding to pursue and implement it.","terms_proposal-heading":"Proposal","terms_total-budget-heading":"Total Budget","terms_unique-wallets-content":"The number of Cardano wallets that take an active part in the Catalyst voting event. Each wallet can vote once per proposal. The number indicated by each proposal represents the number of unique wallets casting a vote for that specific proposal.","terms_unique-wallets-heading":"Unique Wallets","terms_votes-abstain-content":"The total voting power in ada casting an ‘ABSTAIN’ vote from all wallets combined. ‘ABSTAIN’ votes can be found in the results CSV for reference and do not count towards the approval criteria thresholds.","terms_votes-abstain-heading":"‘ABSTAIN’ Votes","terms_votes-no-content":"Total voting power applied in opposition of a proposal","terms_votes-no-heading":"Votes No","terms_votes-results-content":"Total votes yes minus total votes no.","terms_votes-results-heading":"Vote Results","terms_votes-yes-content":"The total voting power in ada casting a ‘YES’ vote, applied in support/favor of a proposal from all wallets combined, and counts towards the approval criteria thresholds.","terms_votes-yes-heading":"‘YES’ Votes","terms_voting-power-content":"The amount of ada registered to vote in Catalyst is determined by the voting power snapshot, which is unique for every funding round. Each wallet has its own unique voting power based on the balance on the day/time of the snapshot. Each time a wallet casts a vote, it uses its full voting power applied to a proposal. This can be done only once per each proposal: ‘YES’ or ‘ABSTAIN’.","terms_voting-power-heading":"Voting Power","toggle_view-less":"- View Less","toggle_view-more":"+ View More"},"headings":{"about-this-category":"About this category","about-this-challenge":"About this challenge","about-this-idea":"About this idea","active-challenges":"Active challenges","become-a-proposal-assessor":"Become a proposal assessor","budget":"Budget","completed-outcome":"Completed outcome","content-type":"Content Type","continents":"Continent","countries":"Country","funds":"Fund number","horizonGroups":"Industry group","how-funding-works":"How funding works","how-it-works":"How it works","join-us":"Join us","monthly-report":"Monthly report","more-detail":"More detail","our-global-community":"Our global community","problem":"Problem","problem-solution":"Solution","progress-report":"Progress report","proposal-type":"Proposal status","related-content":"Related content","search":"Search","search_categories":"Category","search_posts":"Blog posts","search_projects":"Proposals","search_proposers":"Proposers","searching-for":"Searching for {{q}}","submit-a-proposal":"Submit a proposal","successful-projects":"Successful projects","tags":"Tags","team":"Team","video-title":"Project Catalyst explained: an innovation engine from IOG","vote-on-an-idea":"Vote on an idea","website":"Website"},"home-page":{"sub-title":"Project Catalyst is the world’s largest decentralized innovation engine for solving real-world challenges.","title":"Ideas. Innovation. Impact."},"homepage":{"active-challenges-copy":"See the problems we’re solving in the current funding round.","global-community-copy":"Community is at the heart of Project Catalyst. That's why we empower every member of the Cardano community to actively participate in the development of the network. Ideas can come from anyone and anywhere within our global network, no matter their background or location.","how-funding-works-copy":"Every few months, a new fund begins with a set amount of ada budgeted. Millions of ada is available as grants to allocate to projects and as ecosystem rewards.","how-it-works-copy-part-one":"At the start of each funding round, the Cardano community proposes ideas that solve challenges within the blockchain ecosystem and the wider world. The community then evalutes and votes on which technical, business, creative, and community projects will receive funding.","how-it-works-copy-part-two":"Join us and you too could make change happen.","join-us-copy":"There are lots of ways you can get involved in our community and many of them reward with Cardano's native asset, ada. If you have an idea or just want to find out more, \u003cjoinUsLink\u003ejoin the Catalyst platform\u003c/joinUsLink\u003e or \u003csignUpLink\u003esign up for updates\u003c/signUpLink\u003e and all the latest news.","our-community-has-already-voted":"Our community has already voted on 4,772 proposals, that's a total of 1,764,255 votes cast so far. Everyone has a part to play.","successful-projects-copy":"Explore some of the amazing ideas that have been brought to life through Project Catalyst."},"how-it-works":{"sub-title":"Project Catalyst has funding rounds every few months, with a set amount of ada ready to allocate to ideas.","sub-title2":"At the start of each Fund, the community has three weeks to submit proposals to answer challenges set in the previous funding round. Proposals are selected by community vote and funding is allocated to bring the projects to life.","sub-title3":"Project Catalyst is currently between funding rounds, with the next Fund coming soon.","title":"How it works"},"idea-journey":{"community-review":"Community review","community-voting":"Community voting","funding":"Funding","heading":"Idea Journey","idea-assessments":"Evaluation","project-onboarding":"Project onboarding","proposal-submission":"Proposal submission","refine-idea":"Refinement","subheading":"\u003cp\u003eDiscover how ideas come to life within Project Catalyst. Below are the key stages that drive the process forward. For the full timeline and the latest deadlines - make sure \u003ca href=\"https://docs.projectcatalyst.io/current-fund/fund-basics/fund-timeline\" target=\"_blank\"\u003eto visit our Gitbook page\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003ePlease note: all dates are subject to change due to the evolving nature of the program. Stay informed by following our official announcements on (\u003ca href=\"http://t.me/cardanocatalyst\" target=\"_blank\"\u003etelegram\u003c/a\u003e or \u003ca href=\"https://x.com/Catalyst_onX\" target=\"_blank\"\u003eX\u003c/a\u003e).\u003c/p\u003e","subheading-generic":"\u003cp\u003eSee how an idea comes to life within Project Catalyst.\u003c/p\u003e","submit-idea":"Proposal submission","voting-results":"Voting results"},"idea-journey-tooltips":{"evaluation":"Community members share ideas and insights to refine the proposals. This stage consists of two distinct parts - reviews by LV0 \u0026 LV1s reviewers, as well as moderation by LV2s moderators.","onboarding":"Projects receive funding along with guidance to deliver them. Regular reports to the community ensure everything goes to plan.","results":"Votes are tallied and the results revealed. Voters and community reviewers receive their rewards.","submission":"Participants submit initial proposals for ideas to solve challenges. A set amount of ada is allocated to the new funding round.","voting":"Community members vote using the Project Catalyst voting app. Votes are weighted based on voter's token holding."},"input":{"placeholder__email-address":"Email address","placeholder__email-address-placeholder":"e.g. ada.lovelace@example.com","placeholder__full-name":"Full name","placeholder__full-name-placeholder":"e.g. Ada Lovelace","placeholder__search-projects":"Type your search here"},"labels":{"about":"About","assessment":"Assessment","budget":"Budget","categories":"Categories","challenges":"Challenges","contact":"Contact","distributed":"Distributed","estimated-completion-date":"Estimated completion date","evaluation":"Evaluation","filters":"Filter","finalisation":"Finalisation","funding":"Funding","funds-available":"Total funds available","funds-available-short":"Funds available","funds-requested":"Funds requested","how-it-works-video-preview":"How it works video preview","ideas":"Ideas","ideas-funded":"ideas funded","ideas-proposed":"Proposals","largest-winning-idea":"Largest Winning Idea","latest-categories":"Latest Categories","latest-challenges":"Latest challenges","launched":"Launched \u003c0/\u003e","legal":"Legal","mailing-list":"Sign up to receive news and updates on all things Project Catalyst","members":"members","no":"No","num-funds":"Number of funds","num-results":"{{count}} results","on-track":"On track","play":"Play","privacy-policy":"Privacy Policy","proposals":"Proposals","proposals-approved":"Proposals approved","proposals-completed":"Proposals completed","proposals-funded":"Proposals funded","refinement":"Refinement","remaining":"Remaining","requested":"Requested","resources":"Resources","results":"Results","search":"Search","selected-filters":"Selected filters","social-links":"Follow us","status":"Status","submission":"Submission","table-empty-value":"-","table-fund-number":"Fund No","table-ideas-funded":"Ideas funded","table-ideas-proposed":"Ideas proposed","table-votes-cast":"Votes cast","terms-and-conditions":"Terms and Conditions","total-budget":"Total budget","total-categories":"Total Categories","total-challenges":"Total Challenges","total-completed-ideas":"Completed Ideas","total-funding":"total funding","total-funds-requested":"Total Funds Requested","total-ideas":"Total Ideas","total-ideas-funded":"Funded Ideas","total-ideas-proposed":"Ideas Proposed","total-ideas-submitted":"Total Ideas Submitted","total-requested":"Total requested","total-votes-cast":"Total votes cast","view-results":"View Results","voted-no":"Votes no","voted-yes":"Votes yes","votes":"Votes","voting":"Voting","we-collect-personal-data":"We collect personal data in accordance with our ","yes":"Yes"},"legal":{"copyright-notice":"© {{fullYear}} Input Output Global · All Rights Reserved"},"link-text":{"become-a-community-advisor":"Become a community advisor","become-a-proposal-assessor":"Become a Community Reviewer","become-a-voter":"Become a voter","blog":"Blog","browse-funded-ideas":"Browse funded ideas","cardano-foundation":"Cardano Foundation","cardano-org":"Cardano.org","contact-moderator":"Contact moderator","docs":"Docs","essential-cardano":"Essential Cardano","faq-and-tech-support":"FAQ \u0026 tech support","fund":"Fund","fund-overview":"Fund{{number}} Overview","funds":"Funds","funds-overview":"Funds overview","get-involved":"Get involved","get-involved-overview":"Get involved overview","home":"Home","how-it-works":"How it works","ideascale-support":"IdeaScale support","iog-academy":"IOG Academy","iohk":"IOHK","knowledge-base":"Docs","knowledge-base-href":"https://docs.projectcatalyst.io/about-project-catalyst/what-is-project-catalyst","media-kit":"Download media kit","media-kit-page":"Media kit","news":"News","overview":"Overview","reports":"Reports","search":"Search","submit-an-idea":"Submit an idea","the-project":"The project","town-hall":"Town Hall"},"mailing-list":{"join-our-mailing-list":"Join our mailing list","just-fill-in-your-details":"Fill in your details to receive news and updates on all things Project Catalyst","success-heading":"Thank you for subscribing","success-message":"We'll be in touch soon with news and updates from the Project Catalyst community."},"milestones":{"cost-label":"Cost","delivery-label":"Delivery","delivery-month":"Month","explore-cta-text":"Explore all milestones in-depth","milestone":"Milestone {{number}}","milestones-complete":"{{completed}}/{{total}} milestones complete","number-label":"Number","status-complete":"Complete","status-in-progress":"In progress","status-incomplete":"To be completed","status-label":"Status","title":"Project milestones","title-label":"Title"},"overview":{"funds_hero-body":"{{ fundedProposals }}/{{ totalProposals }} proposals remain to be completed. Dive into the total milestones, comparing complete, in-progress, and to be completed milestones across this project set.","funds_hero-title":"All funds total so far","stat-label_total-funds-requested":"Total funds requested","stat-label_total-to-be-distributed":"Total to be distributed"},"pagination":{"next":"Next","prev":"Previous","quick-jump":"Quick jump to page"},"paragraph":{"challenges-set":"Each funding round begins with a set amount of ada and the challenges selected in the previous Fund. Challenges have a clear problem definition and metrics by which to judge success. They can cover a huge range of sectors, such as government, healthcare, insurance, identity, energy, real estate, security, and supply chain.","mailing-list-instructions":"Just fill in your details below and IOG will keep you up to date with all our Project Catalyst news.","projects-funded":"The chosen projects are awarded funding. This is a mix of new technical, business, creative, and community initiatives both within the Cardano ecosystem and the wider world.","proposals-evaluated":"The community suggests ways to improve the proposals until they’re finalized. Our proposal assessors then evaluate and rate the proposals against impact, feasibility, auditability, and success metrics, based on the criteria of the challenge. They are rewarded in ada.","proposals-submitted":"Project Catalyst is built on the ingenuity of our global network. Ideas can come from anyone, from any background, anywhere in the world. Proposal submission begins with collecting ideas and insights from our community on how to solve the challenges.","votes-cast":"Ada holders can register to vote on proposals using the Project Catalyst voting app. Our proposal assessors' evaluations help community members to make their decision. Votes are anonymous and weighted depending on the amount of ada each voter has. Voters, proposal assessors and approved proposers receive their rewards from the Cardano Treasury."},"search":{"challenges":"Category","refine-by":"Refine by","selected-filters":"Selected filters","sort-by":"Sort by","sort-by__budget-high-to-low":"Budget (high to low)","sort-by__budget-low-to-high":"Budget (low to high)","sort-by__completed":"Completed","sort-by__funds-requested-high":"Funds requested (High to Low)","sort-by__funds-requested-low":"Funds requested (Low to High)","sort-by__last-updated":"Recently updated","sort-by__relevance":"Relevance","sort-by__votes":"Most votes","status":"Select","status__all-results":"All results","status__approved":"Approved","status__completed":"Completed","status__dnf":"Did not finish","status__funded":"Funded","status__in-progress":"In progress","status__native":"Native","status__not-approved":"Not approved","status__not-funded":"Not funded","status__onboarding":"Onboarding","subheading":"Find challenges or ideas from previous funding rounds.","subheading_notice":"Please note: Search results will show funded proposals only","summary":"{{ resultCount }} results for \u003cb\u003e‘{{ searchTerm }}’\u003c/b\u003e.","type__all":"All","type__blog-posts":"Blog Posts","type__categories":"Categories","type__proposals":"Proposals","type__proposers":"Proposers"},"site-name":{"site-name":"Project Catalyst"},"social-sharing":{"blog-description":"Read the latest blog posts from Project Catalyst - the largest, most accessible and impactful innovation fund for global good.","fund-18-description":"Previous Funds in Project Catalyst - the largest, most accessible and impactful innovation fund for global good.","fund-active-description":"Active Fund in Project Catalyst - the largest, most accessible and impactful innovation fund for global good.","fund-previous-description":"Previous Funds in Project Catalyst - the largest, most accessible and impactful innovation fund for global good.","funds-overview-description":"Project Catalyst Fund - the largest, most accessible and impactful innovation fund for global good.","get-involved-description":"How to participate in Project Catalyst - the largest, most accessible and impactful innovation fund for global good.","global-data-continent-title":"Global data","global-data-country-title":"Global data","global-data-title":"Global data - Project Catalyst","global-insights-description":"See where Project Catalyst works - the largest, most accessible and impactful innovation fund for global good.","global-map-title":"Global map - Project Catalyst","home-description":"Project Catalyst is the largest, most accessible and impactful innovation fund for global good. Get your idea funded to build on Cardano.","how-it-works-description":"How Project C