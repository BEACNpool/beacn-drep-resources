po.png" alt="" class="image_CvRN" loading="lazy"></span><span class="badge_Rgiz"><span class="starBadge_xZO8" aria-label="Maintainer pick">★</span></span></div><h3 class="title_VMhy">Kupo</h3><p class="description_gDVB">Lightweight Haskell chain-index that tracks only matching transaction outputs, served over an HTTP/JSON API.</p><div class="meta_nlIc"><span class="category_DA3W">Indexers &amp; Data</span><span class="property_EBAu">REST</span><span class="property_EBAu">Haskell</span></div></a></li><li class="item_j9vf"><a class="tile_c841" href="/tools/lace-anatomy/"><div class="header_EVO9"><span class="appIcon_Zwl7 appIconTile_Xnqt" aria-hidden="true"><img src="/img/tools/txpipe.png" alt="" class="image_CvRN" loading="lazy"></span><span class="badge_Rgiz"><span class="starBadge_xZO8" aria-label="Maintainer pick">★</span></span></div><h3 class="title_VMhy">Lace Anatomy</h3><p class="description_gDVB">Web tool that decodes and visualizes Cardano addresses, CBOR, and transactions.</p><div class="meta_nlIc"><span class="category_DA3W">Testing &amp; Debugging</span><span class="property_EBAu">TypeScript</span></div></a></li><li class="item_j9vf"><a class="tile_c841" href="/tools/mesh/"><div class="header_EVO9"><span class="appIcon_Zwl7 appIconTile_Xnqt" aria-hidden="true"><img src="/img/tools/mesh.png" alt="" class="image_CvRN" loading="lazy"></span><span class="badge_Rgiz"><span class="starBadge_xZO8" aria-label="Maintainer pick">★</span></span></div><h3 class="title_VMhy">Mesh</h3><p class="description_gDVB">TypeScript SDK for Cardano with transaction building, wallet integration, providers, and React UI components.</p><div class="meta_nlIc"><span class="category_DA3W">SDKs &amp; Libraries</span><span class="property_EBAu">TypeScript</span></div></a></li><li class="item_j9vf"><a class="tile_c841" href="/tools/ogmios/"><div class="header_EVO9"><span class="appIcon_Zwl7 appIconTile_Xnqt" aria-hidden="true"><img src="/img/tools/ogmios.png" alt="" class="image_CvRN" lo