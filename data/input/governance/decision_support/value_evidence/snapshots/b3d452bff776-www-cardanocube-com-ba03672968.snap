          <span class="me-2">Open anchor</span><i class="fa fa-external-link fs-9"></i>
        </a>
      </div>
    </div>

    <div class="d-flex d-none align-items-center justify-content-between fs-8 text-dark-grey mb-2" data-governance-vote-target="rationaleMissingRow">
      <div class="fw-bolder">Rationale</div>
      <div class="text-dark text-end">No rationale added</div>
    </div>

    <div class="d-flex align-items-center justify-content-between fs-8 text-dark-grey mb-3">
      <div class="fw-bolder">Tx</div>
      <div class="text-dark fw-bolder text-end">
        <a href="#" target="_blank" rel="noopener" data-governance-vote-target="txHashLink">
          <span class="me-2">cardanoscan.io</span><i class="fa fa-external-link fs-9"></i>
        </a>
      </div>
    </div>

    <button
      type="button"
      class="btn btn-dark"
      data-governance-vote-target="changeVoteButton"
      data-action="click->governance-vote#changeVote">
      Change Vote
    </button>
  </div>

  <div class="d-flex gap-2 flex-column flex-sm-row mt-3 py-3" data-governance-vote-target="actionBar">
    <button
      type="button"
      class="btn btn-lg btn-dark"
      data-governance-vote-target="castVoteButton"
      data-action="click->governance-vote#startVote">
      Cast Your Vote
    </button>
  </div>

  <div class="d-none py-3" data-governance-vote-target="chooser">
    <div class="row row-cols-1 row-cols-md-3 g-2 mb-3">
      <div class="col">
        <button
          type="button"
          class="btn btn-outline-green text-start w-100 h-100"
          data-governance-vote-target="voteOption"
          data-vote-choice-value="yes"
          data-action="click->governance-vote#selectVoteChoice">
          <span class="d-block fw-bolder mb-1 fs-6">Yes</span>
          <span class="fs-9">Support this action</span>
        </button>
      </div>
      <div class="col">
        <button
          type="button"
          class="btn btn-outline-orange text-start w-100 h-100"
          data-governance-vote-target="voteOption"
          data-vote-choice-value="no"
          data-action="click->governance-vote#selectVoteChoice">
          <span class="d-block fw-bolder mb-1 fs-6">No</span>
          <span class="fs-9">Oppose this action</span>
        </button>
      </div>
      <div class="col">
        <button
          type="button"
          class="btn btn-outline-dark text-start w-100 h-100"
          data-governance-vote-target="voteOption"
          data-vote-choice-value="abstain"
          data-action="click->governance-vote#selectVoteChoice">
          <span class="d-block fw-bolder mb-1 fs-6">Abstain</span>
          <span class="fs-9">Exclude from result</span>
        </button>
      </div>
    </div>

    <div class="d-flex gap-2 flex-column flex-sm-row">
      <button
        type="button"
        class="btn btn-dark"
        disabled
        data-governance-vote-target="submitVoteButton"
        data-action="click->governance-vote#submitSelectedVote">
