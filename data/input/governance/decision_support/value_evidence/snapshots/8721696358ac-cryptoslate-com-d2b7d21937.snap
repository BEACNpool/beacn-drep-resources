            return;
        }

        var originalClearCookies = wpConsent.clearCookies;
        patchedWPConsentClearCookies = wpConsent;

        wpConsent.clearCookies = function () {
            var preservedCookies = readPreservedCookies();
            var result = originalClearCookies.apply(this, arguments);

            restorePreservedCookies(preservedCookies);

            return result;
        };
