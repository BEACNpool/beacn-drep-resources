{"_id":"scalus","_rev":"7-842269aa393138b48382f30ee030f11a","name":"scalus","dist-tags":{"latest":"0.18.1"},"versions":{"0.0.1":{"name":"scalus","version":"0.0.1","keywords":["cardano","plutus","script","evaluator","scala","scalajs"],"license":"Apache-2.0","_id":"scalus@0.0.1","maintainers":[{"name":"atlanter","email":"anemish@gmail.com"}],"homepage":"https://scalus.org","bugs":{"url":"https://github.com/nau/scalus/issues"},"dist":{"shasum":"95a35e4fbd60e804dbf5e97d2709d1f73ad05041","tarball":"https://registry.npmjs.org/scalus/-/scalus-0.0.1.tgz","fileCount":4,"integrity":"sha512-q11CgZjOxdJ+uUMLpkCTLysVo/Cch9KJUL+OoCP1lcH44WA1XKvPBQUd+dbHyTXzQy7xSa40lWyIzXDmgCyBPA==","signatures":[{"sig":"MEQCIETKYS+SzGyXSoyubi1p0NkNipha6jE/3vc54M5qlOqyAiATGQ6XjzBw7iEyLJ7zGAugKwR7kTMVbHWyQ+bY/9GWTw==","keyid":"SHA256:DhQ8wR5APBvFHLF/+Tc+AYvPOdTpcIDqOhxsBHRwC7U"}],"unpackedSize":1004621},"main":"scalus-opt-bundle.js","types":"scalus.d.ts","gitHead":"d0df04942760c165a464f8204e4aeb4b7d9f2522","_npmUser":{"name":"atlanter","actor":{"name":"atlanter","type":"user","email":"anemish@gmail.com"},"email":"anemish@gmail.com"},"repository":{"url":"git+https://github.com/nau/scalus.git","type":"git"},"_npmVersion":"10.9.2","description":"Scalus – Cardano on-chain / off-chain toolkit compiled with Scala.js","directories":{},"_nodeVersion":"22.14.0","_hasShrinkwrap":false,"_npmOperationalInternal":{"tmp":"tmp/scalus_0.0.1_1750681656529_0.8538264372089837","host":"s3://npm-registry-packages-npm-production"}},"0.14.0":{"name":"scalus","version":"0.14.0","keywords":["cardano","plutus","script","evaluator","scala","scalajs"],"license":"Apache-2.0","_id":"scalus@0.14.0","maintainers":[{"name":"atlanter","email":"anemish@gmail.com"}],"homepage":"https://scalus.org","bugs":{"url":"https://github.com/nau/scalus/issues"},"dist":{"shasum":"89b32caed8fcd4b2b69e373d341e73ccf158c90e","tarball":"https://registry.npmjs.org/scalus/-/scalus-0.14.0.tgz","fileCount":4,"integrity":"sha512-Gv+t24uJo8rt08zUYO7g6EzXBy