</svg>`,n={success:{container:"before:bg-[#489C72]",icon:"text-[#489C72] bg-[#489C72]/12",iconSvg:d,title:"text-white",body:"text-[#C8C5C5]"},error:{container:"before:bg-[#DF5D58]",icon:"text-[#DF5D58] bg-[#DF5D58]/12",iconSvg:h,title:"text-white",body:"text-[#C8C5C5]"}};class m{element;dismissTimeout=null;id;constructor(e){this.id="toast-"+Date.now()+"-"+Math.floor(Math.random()*1e3),this.element=this.createToastElement(e)}createToastElement(e){const{theme:t,title:i,body:a}=e,o=document.createElement("div");o.className=`flex flex-row items-center gap-4 px-4 py-3 rounded-lg bg-[#191919]/95 overflow-hidden ${n[t].container} transition-all duration-300 transform translate-y-full opacity-0 w-full max-w-md before:absolute before:w-full before:h-1.25 before:left-0 before:bottom-0 before:blur-[1px]`,o.setAttribute("role","alert"),o.id=this.id;let c=`
        <div class="rounded-full p-1 ${n[t].icon}">
          ${n[t].iconSvg}
        </div>
        <div class="flex flex-col gap-1.5">
          ${i?`<div class="text-base font-semibold ${n[t].title}">${i}</div>`:""}
          ${a?`<div class="text-sm ${n[t].body}">${a}</div>`:""}
        </div>
      `;return o.innerHTML=c,o}show(e=3e3){const t=document.getElementById("toast-container");if(t)return t.appendChild(this.element),setTimeout(()=>{this.element.classList.remove("translate-y-full","opacity-0"),this.element.classList.add("translate-y-0","opacity-100")},10),e>0&&(this.dismissTimeout=setTimeout(()=>{this.hide()},e)),this}hide(){this.element.classList.remove("translate-y-0","opacity-100"),this.element.classList.add("translate-y-full","opacity-0"),setTimeout(()=>{this.element.remove()},300),this.dismissTimeout&&(clearTimeout(this.dismissTimeout),this.dismissTimeout=null)}}class l{static instance;toasts=new Map;constructor(){if(l.instance)return l.instance;l.instance=this}create(e){const t=new m(e);return this.toasts.set(t.id,t),t}show(e){const t=this.create(e);return t.show(e.duration),t}success(e,t,i=3e3){return this.show({theme:"success",title:e,body:t,duration:i})}error(e,t,i=3e3){return this.show({theme:"error",title:e,body:t,duration:i})}hideAll(){this.toasts.forEach(e=>e.hide())}}const r=new l;document.addEventListener("DOMContentLoaded",()=>{window.toast={show:s=>r.show(s),success:(s,e,t)=>r.success(s,e,t),error:(s,e,t)=>r.error(s,e,t),hideAll:()=>r.hideAll()}});</script>  </body></html>