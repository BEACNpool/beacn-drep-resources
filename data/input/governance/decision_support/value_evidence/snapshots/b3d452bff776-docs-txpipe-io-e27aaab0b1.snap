abel="Performance" class="hover:text-primary py-1 block astro-z2zdus5w"> <span class="astro-z2zdus5w">Performance</span>  </a> </li><li class="astro-z2zdus5w"> <a href="/dolos/operations/troubleshooting" aria-current="false" aria-label="Troubleshooting" class="hover:text-primary py-1 block astro-z2zdus5w"> <span class="astro-z2zdus5w">Troubleshooting</span>  </a> </li> </ul>   </details> </li><li class="astro-z2zdus5w"> <details data-current="false" class="astro-z2zdus5w"> <summary class="flex items-center justify-between cursor-pointer px-3 py-2 astro-z2zdus5w"> <div class="group-label text-white astro-z2zdus5w"> <span class="astro-z2zdus5w">APIs</span>  </div> <svg aria-hidden="true" class="caret astro-z2zdus5w astro-37fwe2cs" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1.5rem;"><path d="m14.83 11.29-4.24-4.24a1 1 0 1 0-1.42 1.41L12.71 12l-3.54 3.54a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.24-4.24a1.002 1.002 0 0 0 0-1.42Z"/></svg> </summary> <ul class="text-white/70 astro-z2zdus5w"> <li class="astro-z2zdus5w"> <a href="/dolos/apis/grpc" aria-current="false" aria-label="UTxO RPC" class="hover:text-primary py-1 block astro-z2zdus5w"> <span class="astro-z2zdus5w">UTxO RPC</span>  </a> </li><li class="astro-z2zdus5w"> <a href="/dolos/apis/minibf" aria-current="false" aria-label="Mini Blockfrost" class="hover:text-primary py-1 block astro-z2zdus5w"> <span class="astro-z2zdus5w">Mini Blockfrost</span>  </a> </li><li class="astro-z2zdus5w"> <a href="/dolos/apis/ouroboros" aria-current="false" aria-label="Ouroboros" class="hover:text-primary py-1 block astro-z2zdus5w"> <span class="astro-z2zdus5w">Ouroboros</span>  </a> </li><li class="astro-z2zdus5w"> <a href="/dolos/apis/minikupo" aria-current="false" aria-label="MiniKupo" class="hover:text-primary py-1 block astro-z2zdus5w"> <span class="astro-z2zdus5w">MiniKupo</span>  </a> </li> </ul>   </details> </li><li class="astro-z2zdus5w"> <details data-current="false" cl