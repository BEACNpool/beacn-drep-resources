asics.mdx\"}},{\"$id\":\"root:apis/txbuilder/minting.mdx\",\"type\":\"page\",\"name\":\"Minting and Burning Assets\",\"description\":\"Create and destroy native assets using Native Scripts and Plutus Scripts.\",\"icon\":\"$undefined\",\"url\":\"/apis/txbuilder/minting\",\"$ref\":{\"file\":\"apis/txbuilder/minting.mdx\"}},{\"$id\":\"root:apis/txbuilder/smart-contracts.mdx\",\"type\":\"page\",\"name\":\"Smart Contract Interactions\",\"description\":\"Lock, unlock, and interact with Plutus smart contracts on Cardano.\",\"icon\":\"$undefined\",\"url\":\"/apis/txbuilder/smart-contracts\",\"$ref\":{\"file\":\"apis/txbuilder/smart-contracts.mdx\"}},{\"$id\":\"root:apis/txbuilder/staking.mdx\",\"type\":\"page\",\"name\":\"Staking and Delegation\",\"description\":\"Delegate ADA to stake pools, register stake addresses, and withdraw staking rewards with TypeScript.\",\"icon\":\"$undefined\",\"url\":\"/apis/txbuilder/staking\",\"$ref\":{\"file\":\"apis/txbuilder/staking.mdx\"}},{\"$id\":\"root:apis/txbuilder/governance.mdx\",\"type\":\"page\",\"name\":\"Governance Transactions\",\"description\":\"Participate in Cardano's on-chain governance through DRep delegation, registration, voting, and submitting governance action proposals.\",\"icon\":\"$undefined\",\"url\":\"/apis/txbuilder/governance\",\"$ref\":{\"file\":\"apis/txbuilder/governance.mdx\"}}],\"$id\":\"root:apis/txbuilder\",\"$ref\":{\"metaFile\":\"apis/txbuilder/meta.json\"}},{\"type\":\"folder\",\"name\":\"Transaction Parser\",\"icon\":\"$L14\",\"root\":\"$undefined\",\"defaultOpen\":\"$undefined\",\"description\":\"$undefined\",\"collapsible\":\"$undefined\",\"index\":{\"$id\":\"root:apis/txparser/index.mdx\",\"type\":\"page\",\"name\":\"Cardano Transaction Parser\",\"description\":\"Parse, analyze, and test Cardano transactions from CBOR hex.\",\"icon\":\"$L15\",\"url\":\"/apis/txparser\",\"$ref\":{\"file\":\"apis/txparser/index.mdx\"}},\"children\":[{\"$id\":\"root:apis/txparser/basics.mdx\",\"type\":\"page\",\"name