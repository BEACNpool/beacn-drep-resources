g the total TVL is based on analyzing liquidity pool data and LP token balances. \nFor each Vaults we iterate through all LP tokens and calculate their price based on following onchain data: (reserve0, reserve1, total_lp_supply)\nFor each pool, a calculation is performed to determine the equivalent amount of TON based on the current pool reserves and the share of LP tokens held. \nThis calculation takes into account the reserve ratios and adjusts the token value to TON.\nFor multi-indices, the TVL of all pools is summed up, while for single indices, the value of the sole pool is used. The final TVL is represented in TON, and the index price is calculated by dividing the TVL by the total supply of the index.","misrepresentedTokens":false,"tvlCodePath":"https://github.com/DefiLlama/DefiLlama-Adapters/blob/main/projects/settleton/index.js","slug":"settleton","tvl":83499.53750609799,"chainTvls":{"TON":83499.53750609799},"change_1h":null,"change_1d":null,"change_7d":null,"tokenBreakdowns":{},"mcap":null},{"id":"2118","name":"WinerySwap","address":"bsc:0xe7eada32caf827d3ba8cb1074830d803c9bd48c3","symbol":"CORK","url":"","description":"An explosive innovation of all-in-one decentralized exchange","chain":"Binance","logo":"https://icons.llamao.fi/icons/protocols/wineryswap","audits":"0","gecko_id":"cork","cmcId":null,"tags":["AMM"],"chains":["Binance"],"forkedFromIds":["2197"],"module":"winery-swap/index.js","twitter":"WinerySwap","listedAt":1663940269,"deadUrl":true,"dimensions":{"dexs":"wineryswap"},"category":"Dexs","methodology":"Value of the tokens locked in the liquidity pools.","misrepresentedTokens":false,"tvlCodePath":"https://github.com/DefiLlama/DefiLlama-Adapters/blob/main/registries/uniswapV2.js","slug":"wineryswap","tvl":83450.05791831728,"chainTvls":{"Binance":83450.05791831728},"change_1h":0.8177767505715252,"change_1d":0.49020257041732407,"change_7d":0.49263441822743914,"tokenBreakdowns":{},"mcap":null},{"id":"3706","name":"Dyson Finance","address":"polygon