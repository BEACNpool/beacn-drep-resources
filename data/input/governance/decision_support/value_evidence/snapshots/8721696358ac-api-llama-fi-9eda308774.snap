 network is a decentralized blockchain-agnostic oracle that is true to the censorship resistant nature of blockchains. It runs on its own blockchain using the WIT coin as its native currency. A bridge has been built to handle data requests from the Ethereum blockchain. Bridges from othher networks are planned in the future.\nThe eWIT token is a custodial, wrapped version of the Witnet coin managed by the WitSwap plaform. The token is minted by the WitSwap team whenever someone wants to convert WIT coins to eWIT tokens and kept in custody. A user on the Ethereum network can also opt to swap his eWIT tokens back to WIT coins. The intent of this token is to allow decentralized trading on Ethereum DEXs and, in the future, to pay independent bridge operators with it if they choose to accept it.","chain":"Ethereum","logo":"https://icons.llamao.fi/icons/protocols/witswap","audits":"2","gecko_id":"wrapped-wit","cmcId":null,"category":"Oracle","chains":["Ethereum"],"module":"witswap/index.js","twitter":"WitSwap","audit_links":["https://github.com/witswap/contracts/blob/master/eWit_Security_Audit_Report_Final_Mainnet.pdf"],"deadUrl":true,"deadFrom":"2023-03-19","misrepresentedTokens":false,"tvlCodePath":"https://github.com/DefiLlama/DefiLlama-Adapters/blob/main/registries/deadAdapters.json","slug":"witswap","tvl":0,"chainTvls":{"Ethereum":0},"change_1h":null,"change_1d":null,"change_7d":null,"tokenBreakdowns":{},"mcap":null},{"id":"440","name":"LoTerra","address":"terra:terra1ez46kxtulsdv07538fh5ra5xj8l68mu8eg24vr","symbol":"LOTA","url":"https://loterra.io","description":"LoTerra is a decentralized lottery regulated by a smart contract and managed by LOTA holders.","chain":"Terra","logo":"https://icons.llamao.fi/icons/protocols/loterra","audits":"2","gecko_id":"loterra","cmcId":"11673","category":"Prediction Market","chains":["Terra"],"module":"loterra/index.js","twitter":"LoTerra_LOTA","audit_links":["https://docs.loterra.io/resources/security-audit"],"oracles":["Terrand"],"