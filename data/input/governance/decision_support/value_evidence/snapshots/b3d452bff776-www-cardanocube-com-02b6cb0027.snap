<h2 class="label" id="votes">Votes</h2>
<section class="pb-6">
  <turbo-cable-stream-source channel="Turbo::StreamsChannel" signed-stream-name="IloybGtPaTh2WTJGeVpHRnViMk4xWW1VdlIyOTJRV04wYVc5dUx6UXk6dm90ZXMi--fd1f9374b3d2fe2e2b35765b715b738568ba77f5402cb67e5654877fcb352b66"></turbo-cable-stream-source>
  <div
  class="bg-white border-light shadow rounded p-3 p-lg-4 mb-4 d-none d-lg-block"
  data-controller="governance-vote"
  data-governance-vote-gov-action-id-value="gov_action13tfag48nf94rtjcdq7c06vhkslmxxw9h6c88sl7q5g5nnewcsvlp2tyw3h6"
  data-governance-vote-gov-action-tx-hash-value="8ad3d454f3496a35cb0d07b0fd32f687f66338b7d60e787fc0a22939e5d8833e"
  data-governance-vote-gov-action-tx-index-value="21"
  data-governance-vote-network-value="mainnet"
  data-governance-vote-blockfrost-base-url-value="https://cardano-mainnet.blockfrost.io/api/v0"
  data-governance-vote-blockfrost-project-id-value="mainnetdcOPoUY9qtlNMmbTU7oSfUConAFII3Ss"
  data-governance-vote-current-votes-api-url-value="/governance/gov_actions/current_votes"
  data-governance-vote-vote-rationale-draft-api-url-value="/governance/gov_actions/gov_action13tfag48nf94rtjcdq7c06vhkslmxxw9h6c88sl7q5g5nnewcsvlp2tyw3h6/vote_rationale_draft"
  data-governance-vote-pin-vote-rationale-draft-url-value="/governance/gov_actions/gov_action13tfag48nf94rtjcdq7c06vhkslmxxw9h6c88sl7q5g5nnewcsvlp2tyw3h6/vote_rationale_draft/pin"
  data-governance-vote-publish-vote-rationale-draft-url-value="/governance/gov_actions/gov_action13tfag48nf94rtjcdq7c06vhkslmxxw9h6c88sl7q5g5nnewcsvlp2tyw3h6/vote_rationale_draft/publish"
  data-governance-vote-discard-pinned-rationale-url-value="/governance/gov_actions/gov_action13tfag48nf94rtjcdq7c06vhkslmxxw9h6c88sl7q5g5nnewcsvlp2tyw3h6/vote_rationale_draft/discard_pin"
  data-governance-vote-ipfs-gateway-base-url-value="https://ipfs.io/ipfs/"
  data-governance-vote-voting-open-value="false"
  data-governance-vote-drep-eligible-value="true">
  <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <h3 class="m-0 h5">Your vote</h3>
    <span class="badge bg-dark fs-9" data-governance-vote-target="drepIdentity">DRep</span>
  </div>

  <p class="text-grey fs-8 lh-sm mb-3" data-governance-vote-target="message"></p>

  <button
    type="button"
    class="btn btn-lg btn-outline-dark mb-3"
    data-governance-vote-target="connectButton"
    data-action="click->governance-vote#declareConnectIntent click->wallet-select#showWalletList">
    Connect your DRep Wallet
  </button>

  <div class="py-3 border-bottom border-light" data-governance-vote-target="rationaleSection">
    <div class="d-flex align-items-center justify-content-between gap-2">
      <h5 class="label fs-8 m-0">Rationale</h5>
      <div class="text-grey fs-8 lh-sm" data-governance-vote-target="rationaleEmpty">No rationale added yet.</div>
    </div>
    <div data-governance-vote-target="rationaleSummary">
      <div class="d-none" data-governance-vote-target="rationalePreview">
        <div class="border border-grey bg-light p-3 text-dark my-2 fs-8" data-governance-vote-target="rationaleComment"></div>
        <div class="text-grey fs-9" data-governance-vote-target="rationaleNote"></div>
      </div>

      <div class="d-flex gap-2 flex-column flex-sm-row my-3" data-governance-vote-target="rationaleActions">
        <button
          type="button"
          class="btn btn-outline-dark"
          data-governance-vote-target="rationaleButton"
          data-action="click->governance-vote#openDraftEditor">
          Add Rationale
        </button>
        <button
          type="button"
          class="btn btn-outline-dark d-none"
          data-governance-vote-target="deleteDraftButton"
          data-action="click->governance-vote#deleteDraft">
          Delete Draft
        </button>
      </div>
    </div>

    <div class="d-none my-3" data-governance-vote-target="draftEditor">
      <textarea
        id="governance-vote-comment"
        class="form-control mb-3"
        rows="8"
        placeholder="Add the rationale you want to pin with your vote."
        data-governance-vote-target="draftComment"></textarea>

      <div class="d-flex gap-2 flex-column flex-sm-row">
        <button
          type="button"
          class="btn btn-dark"
          data-governance-vote-target="saveDraftButton"
          data-action="click->governance-vote#saveDraft">
          Save Draft
        </button>
        <button
          type="button"
          class="btn btn-outline-dark"
          data-action="click->governance-vote#cancelDraftEditing">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <div class="d-none rounded border border-light p-3 py-3" data-governance-vote-target="submittedState">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
      <div class="fw-bolder" data-governance-vote-target="currentVoteSource">Your current vote</div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-dark border fs-9 fw-normal" data-governance-vote-target="currentVoteStatus">Pending on chain</span>
        <span class="text-dark fw-bolder" data-governance-vote-target="submittedVote"></span>
      </div>
    </div>

    <div class="d-flex align-items-center justify-content-between fs-8 text-dark-grey mb-2">
      <div class="fw-bolder" data-governance-vote-target="submittedAtLabel">Submitted at</div>
      <div class="text-dark fw-bolder text-end" data-governance-vote-target="submittedAt"></div>
    </div>

    <div class="d-flex d-none align-items-center justify-content-between fs-8 text-dark-grey mb-2" data-governance-vote-target="rationaleAnchorRow">
      <div class="fw-bolder">Rationale</div>
      <div class="text-dark fw-bolder text-end">
        <a href="#" target="_blank" rel="noopener" data-governance-vote-target="rationaleAnchorLink">
          <span class="me-2">Open anchor</span><i class="fa fa-external-link fs-9"></i>
        </a>
      </div>
    </div>

    <div class="d-flex d-none align-items-center justify-content-between fs-8 text-dark-grey mb-2" data-governance-vote-target="rationaleMissingRow">
      <div class="fw-bolder">Rationale</div>
      <div class="text-dark text-end">No rationale added</div>
    </div>

    <div class="d-flex align-items-center justify-content-between fs-8 text-dark-grey mb-3">
      <div class="fw-bolder">Tx</div>
      <div class="text-dark fw-bolder text-end">
        <a href="#" target="_blank" rel="noopener" data-governance-vote-target="txHashLink">
          <span class="me-2">cardanoscan.io</span><i class="fa fa-external-link fs-9"></i>
        </a>
      </div>
    </div>

    <button
      type="button"
      class="btn btn-dark"
      data-governance-vote-target="changeVoteButton"
      data-action="click->governance-vote#changeVote">
      Change Vote
    </button>
  </div>

  <div class="d-flex gap-2 flex-column flex-sm-row mt-3 py-3" data-governance-vote-target="actionBar">
    <button
      type="button"
      class="btn btn-lg btn-dark"
      data-governance-vote-target="castVoteButton"
      data-action="click->governance-vote#startVote">
      Cast Your Vote
    </button>
  </div>

  <div class="d-none py-3" data-governance-vote-target="chooser">
    <div class="row row-cols-1 row-cols-md-3 g-2 mb-3">
      <div class="col">
        <button
          type="button"
          class="btn btn-outline-green text-start w-100 h-100"
          data-governance-vote-target="voteOption"
          data-vote-choice-value="yes"
          data-action="click->governance-vote#selectVoteChoice">
          <span class="d-block fw-bolder mb-1 fs-6">Yes</span>
          <span class="fs-9">Support this action</span>
        </button>
      </div>
      <div class="col">
        <button
          type="button"
          class="btn btn-outline-orange text-start w-100 h-100"
          data-governance-vote-target="voteOption"
          data-vote-choice-value="no"
          data-action="click->governance-vote#selectVoteChoice">
          <span class="d-block fw-bolder mb-1 fs-6">No</span>
          <span class="fs-9">Oppose this action</span>
        </button>
      </div>
      <div class="col">
        <button
          type="button"
          class="btn btn-outline-dark text-start w-100 h-100"
          data-governance-vote-target="voteOption"
          data-vote-choice-value="abstain"
          data-action="click->governance-vote#selectVoteChoice">
          <span class="d-block fw-bolder mb-1 fs-6">Abstain</span>
          <span class="fs-9">Exclude from result</span>
        </button>
      </div>
    </div>

    <div class="d-flex gap-2 flex-column flex-sm-row">
      <button
        type="button"
        class="btn btn-dark"
        disabled
        data-governance-vote-target="submitVoteButton"
        data-action="click->governance-vote#submitSelectedVote">
        Submit vote
      </button>
      <button
        type="button"
        class="btn btn-outline-dark"
        data-action="click->governance-vote#cancelVoteSelection">
        Cancel
      </button>
    </div>
  </div>
</div>

  <turbo-frame id="gov_action13tfag48nf94rtjcdq7c06vhkslmxxw9h6c88sl7q5g5nnewcsvlp2tyw3h6_votes" src="/governance/gov_actions/gov_action13tfag48nf94rtjcdq7c06vhkslmxxw9h6c88sl7q5g5nnewcsvlp2tyw3h6/votes" target="_top"></turbo-frame>
</section>

          </div>
        </div>
      </div>

      <div class="col-12 col-lg-3 mb-5 mb-lg-0" data-controller="gov-action-analytics" data-gov-action-analytics-gov-action-id-value="gov_action13tfag48nf94rtjcdq7c06vhkslmxxw9h6c88sl7q5g5nnewcsvlp2tyw3h6" data-action="click->gov-action-analytics#trackClick">
        <div class="mt-n9 position-lg-sticky top-lg-2 bg-white border-light shadow rounded p-3">
          <h5 class="m-0 mb-3">Proposal Information</h5>

<div class="bg-light rounded p-2 fs-8">
  <ul class="list-group list-group-flush fs-8">
    <li class="list-group-item d-flex align-items-center justify-content-between bg-transparent text-dark-grey border-light">
      <div class="fw-bolder">Type</div>
      <div class="text-dark fw-bolder">
        <i class="fa-solid fa-coins me-2"></i>Treasury Withdrawal
      </div>
    </li>


    <li class="list-group-item d-flex align-items-center justify-content-between bg-transparent text-dark-grey border-light">
      <div class="fw-bolder">Status</div>
      <div class="text-dark fw-bolder">
        <span class="badge bg-primary" title="The proposal was enacted on Aug 12, 2025." data-controller="tooltip">Enacted</span>
      </div>
    </li>

    <li class="list-group-item d-flex align-items-center justify-content-between bg-transparent text-dark-grey border-light">
      <div class="fw-bolder">Submitted On</div>
      <div class="text-dark fw-bolder" title="Epoch 570" data-controller="tooltip">
        Jul 18, 2025
      </div>
    </li>

    <li class="list-group-item d-flex align-items-center justify-content-between bg-transparent text-dark-grey border-light">
      <div class="fw-bolder">Enacted On</div>
      <div class="text-dark fw-bolder" title="Epoch 576" data-controller="tooltip">
        Aug 12, 2025
      </div>
    </li>

    <li class="list-group-item d-flex align-items-center justify-content-between bg-transparent text-dark-grey border-light">
      <div class="fw-bolder">Voting Parties</div>
      <div class="text-dark fw-bolder">
        <span class="badge bg-green me-1" title="Delegated Representatives 67% Threshold Met" data-controller="tooltip">DRep</span><span class="badge bg-green me-1" title="Constitutional Committees 67% Threshold Met" data-controller="tooltip">CC</span>
      </div>
    </li>
  </ul>
</div>

<div
  class="mt-3 d-none d-lg-block"
  data-controller="governance-vote-status"
  data-governance-vote-status-voting-open-value="false"
  data-governance-vote-status-drep-eligible-value="true">
  <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
