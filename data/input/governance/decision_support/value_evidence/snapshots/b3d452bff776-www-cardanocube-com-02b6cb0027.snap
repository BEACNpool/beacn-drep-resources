    <span class="badge bg-dark fs-9" data-governance-vote-status-target="drepIdentity">DRep</span>
  </div>

  <p class="text-grey fs-8 lh-sm mb-3" data-governance-vote-status-target="message"></p>

  <button
    type="button"
    class="btn btn-outline-dark w-100 mb-1"
    data-governance-vote-status-target="connectButton"
    data-action="click->governance-vote-status#declareConnectIntent click->wallet-select#showWalletList">
    Connect your DRep Wallet
  </button>

  <a
    href="#votes"
    class="btn btn-dark w-100"
    data-governance-vote-status-target="goToVotesLink">
    View voting area
  </a>
</div>


        </div>
