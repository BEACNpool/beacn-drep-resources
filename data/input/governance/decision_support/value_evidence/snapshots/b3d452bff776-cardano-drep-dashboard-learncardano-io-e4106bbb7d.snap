lex items-center justify-center\",\"children\":[\"Auto\",[\"$\",\"$L21\",null,{\"label\":\"Auto\",\"body\":\"Auto is the AI's first pass at this criterion when the proposal was imported. It's a starting point, not a verdict -- automated checks save you time on rule-based criteria (open source, milestones, USD peg), but the AI can misread proposal text or miss nuance. Treat every auto value as something to sanity-check, and use the Manual override column to set Yes / No / Not applicable when you disagree.\"}]]}]}],[\"$\",\"th\",null,{\"scope\":\"col\",\"className\":\"px-4 py-3 w-40 text-center\",\"children\":\"Manual override\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"className\":\"px-4 py-3 w-12 text-right\",\"children\":\"Weight\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"doxxed-team\",{\"className\":\"border-b border-[color:var(--border)] align-top last:b"])</script><script>self.__next_f.push([1,"order-0\",\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-3 pr-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-baseline font-medium\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Team is doxxed\"}],[\"$\",\"$L21\",null,{\"label\":\"Team is doxxed\",\"body\":\"A doxxed team has a publicly known identity — real names, public profiles, GitHub history. Doxxing doesn't guarantee delivery, but it raises the accountability cost: a team putting their professional reputation on a proposal is harder to walk away from than an anonymous one.\"}]]}],\"$L22\",\"$L23\",\"$L24\"]}],\"$L25\",\"$L26\",\"$L27\"]}],\"$L28\",\"$L29\"]}]]}]}]]}],\"$L2a\",\"$L2b\",\"$L2c\"],\"$L2d\"]}]}],\"$L2e\"]}]\n2f:{\"id\":\"70cd3e3e2315683f191c73ccad0f5366f45604801c\",\"bound\":\"$@30\"}\n1a:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-4\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Vote intent\"}],\"$undefined\"]}],[\"$\",\"$L1d\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"roun