has-[:checked]:bg-[color:var(--bg-elevated)]\",\"children\":[[\"$\",\"input\",null,{\"type\":\"radio\",\"name\":\"intent\",\"value\":\"abstain\",\"defaultChecked\":false,\"className\":\"accent-[color:var(--accent-info)]\"}],[\"$\",\"span\",null,{\"className\":\"capitalize\",\"children\":\"abstain\"}]]}],[\"$\",\"label\",\"undecided\",{\"className\":\"flex cursor-pointer items-center gap-2 rounded-[--radius-md] border border-[color:var(--border-strong)] bg-[color:var(--surface)] px-3 py-1.5 text-sm has-[:checked]:border-[color:var(--accent-info)] has-[:checked]:bg-[color:var(--bg-elevated)]\",\"children\":[[\"$\",\"input\",null,{\"type\":\"radio\",\"name\":\"intent\",\"value\":\"undecided\",\"defaultChecked\":true,\"className\":\"accent-[color:var(--accent-info)]\"}],[\"$\",\"span\",null,{\"className\":\"capitalize\",\"children\":\"undecided\"}]]}]],[\"$\",\"label\",null,{\"className\":\"ml-auto flex items-center gap-1.5 text-sm text-[color:var(--fg-muted)]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center\",\"children\":[\"Confidence\",[\"$\",\"$L21\",null,{\"label\":\"Confidence in your vote\",\"body\":\"How firm is your decision (not how good the project is). Low = leaning this way but I could still flip after more research, conversation, or new information. Medium = comfortable with this call but open to compelling counter-arguments. High = decided, very unlikely to change. "])</script><script>self.__next_f.push([1,"This is published next to your vote on your public DRep page so other DReps and ADA holders can read both your conclusion and how locked-in it is.\"}]]}],[\"$\",\"select\",null,{\"name\":\"confidence\",\"defaultValue\":\"\",\"className\":\"text-sm\",\"children\":[[\"$\",\"option\",null,{\"value\":\"\",\"children\":\"—\"}],[\"$\",\"option\",null,{\"value\":\"low\",\"children\":\"Low\"}],[\"$\",\"option\",null,{\"value\":\"med\",\"children\":\"Medium\"}],[\"$\",\"option\",null,{\"value\":\"high\",\"children\":\"High\"}]]}]]}]]}]]}],[\"$\",\"label\",null,{\"className\":\"flex items-center gap-2 text-sm text-[color:var(--fg-muted)]\",\"children\":[[\"$\",\"input\",null,{\"type\":\"checkbox\",\"name\":\"is_public\",\"defaultChecked\":false,\"className\":\"accent-[color:var(--accent-primary)]\"}],\"Publish this vote + rationale on my public DRep page\"]}],\"$L31\",\"$L32\"]}]}]]}]\n1b:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-3 flex items-center justify-between\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Export \u0026 audit\"}],[\"$\",\"a\",null,{\"href\":\"/proposals/hydra-tx3-txpipe-open-api-layer/export.md\",\"className\":\"rounded-[--radius-md] border border-[color:var(--border-strong)] px-3 py-1.5 font-sans text-sm hover:bg-[color:var(--bg-elevated)]\",\"children\":\"↓ Download scorecard.md\"}]]}],false]}]\n33:T1c32,{\n  \"_meta\": {\n    \"schema_version\": \"1.2.0\",\n    \"filename\": \"hydra-tx3-txpipe-open-api-layer.json\",\n    \"ingested_at\": \"2026-05-11\",\n    \"source\": \"Cardano Budget Process 2026 - Hydra/Ekklesia\",\n    \"proposal_id\": \"69fc5a8785ddd26899aaf208\",\n    \"title\": \"Tx3 by TxPipe: Open API Layer for Cardano's dApp Protocols\",\n    \"proposer\": \"TxPipe\"\n  },\n  \"proposal\": {\n    \"id\": \"69fc5a8785ddd26899aaf208\",\n    \"title\": \"Tx3 by TxPipe: Open API Layer for Cardano's dApp Protocols\",\n    \"proposer\": \"TxPipe\",\n    \"submitted_at\": \"2026-05-08T01:10:00Z\"\n  },\n  \"ask\": {\n    \"total_ada\": 1684050,\n    \"total_usd\": 421013,\n    \"proposer_ada_rate_usd\": 0.25,\n    \"duration_months\": 12,\n    \"usd_peg_vs_market\": \"neutral\",\n    \"usd_peg_vs_market_set_by\": \"ai\",\n    \"milestone_payments_disclosed\": true,\n    \"milestone_schedule_disclosed\": \"amounts_only\",\n    \"milestone_schedule_disclosed_set_by\": \"ai\",\n    \"admin_fee_ada\": 49050,\n    \"contingency_reserve_ada\": 327000\n  },\n  \"identity\": {\n    \"doxxed\": true,\n    \"doxxed_set_by\": \"ai\",\n    \"applicant_type\": \"company\",\n    \"named_leads\": [\n      \"Santiago Carmuega (TxPipe founder, Tx3 lead architect)\"\n    ]\n  },\n  \"metadata\": {\n    \"open_source\": \"yes\",\n    \"open_source_set_by\": \"ai\",\n    \"open_source_notes\": \"All TxPipe public repositories are Apache 2.0 licensed. Tx3 itself is open source.\",\n    \"has_prior_delivery\": true,\n    \"has_prior_delivery_set_by\": \"ai\",\n    \"prior_delivery_notes\": \"TxPipe delivered 30 Catalyst proposals (24 complete, 6 in progress on schedule). 2025 Intersect-administered open-source maintenance for Pallas, Dolos, UTxO RPC on schedule. Catalyst Fund 14 'API Layer for Cardano Protocols using Tx3' currently in final report milestone with 5 protocols live on tx3.land (Strike Finance, Indigo Protocol, VyFinance, Bodega Market, Fluid Tokens).\",\n    \"admin_model\": \"intersect\",\n    \"admin_model_set_by\": \"ai\",\n    \"duplicate_of_existing_solution\": {\n      \"value\": \"no\",\n      \"confidence\": \"high\",\n      \"set_by\": \"ai\"\n    }\n  },\n  \"treasury_return\": {\n    \"has_return_clause\": true,\n    \"return_clause_set_by\": \"ai\",\n    \"treasury_favourability\": \"moderate\",\n    \"treasury_favourability_set_by\": \"ai\",\n    \"return_mechanism_notes\": \"Contingency reserve of 327,000 ADA calculated against $0.20 low-bound rate. Unused contingency returned at project close, evaluated milestone-by-milestone against $0.25 proposal rate vs actual market price.\"\n  },\n  \"relationships\": {\n    \"competes_with\": [],\n    \"related_proposals\": [\n      \"hydra-govexe-traceability-public-projects-argentina\"\n    ],\n    \"notes\": \"Same proposer (TxPipe) as GOV.EXE proposal in same budget round; scopes are distinct (this is dApp interface tooling; GOV.EXE is govtech pilot).\"\n  },\n  \"ecosystem_demand\": {\n    \"evidence_level\": \"moderate\",\n    \"evidence_level_confidence\": \"medium\",\n    \"evid"])</script><script>self.__next_f.push([1,"ence_level_set_by\": \"ai\",\n    \"active_users_known\": true,\n    \"active_users_examples\": [\n      {\n        \"name\": \"Strike Finance\",\n        \"kind\": \"integrator\",\n        \"url\": null\n      },\n      {\n        \"name\": \"Indigo Protocol\",\n        \"kind\": \"integrator\",\n        \"url\": null\n      },\n      {\n        \"name\": \"VyFinance\",\n        \"kind\": \"integrator\",\n        \"url\": null\n      },\n      {\n        \"name\": \"Bodega Market\",\n        \"kind\": \"integrator\",\n        \"url\": null\n      },\n      {\n        \"name\": \"Fluid Tokens\",\n        \"kind\": \"integrator\",\n        \"url\": null\n      }\n    ],\n    \"developer_demand_signals\": [\n      \"Catalyst Fund 14 already shipped 5 protocols live on tx3.land\",\n      \"GitHub stars: Tx3 (68), Pallas (199), Oura (288), Dolos (129)\",\n      \"Pallas used as a dependency by Aiken, Lucid, Mithril, Amaru\"\n    ],\n    \"adoption_risk_notes\": \"Five named integrators are already live from Catalyst Fund 14 work, which is real adoption evidence — though this is integrator-side, not end-user demand. The 12 additional onboardings proposed are not pre-committed by named protocols; selection is supply-side ('TVL, active users, ecosystem footprint'). The agent/MCP layer is speculative — relies on the AI-agent thesis playing out. The 'tx3.land becomes the standard interface' positioning has no committed adopters beyond the existing 5; competing approaches (e.g. direct protocol SDKs, Mesh, Lucid) exist but are not framed as competitors in the proposal.\"\n  },\n  \"incumbents\": {\n    \"has_existing_solution\": \"partial\",\n    \"has_existing_solution_confidence\": \"medium\",\n    \"has_existing_solution_set_by\": \"ai\",\n    \"existing_solutions\": [\n      {\n        \"name\": \"Mesh SDK\",\n        \"url\": null,\n        \"status\": \"shipped\",\n        \"overlap\": \"partial\",\n        \"notes\": \"Existing Cardano SDK approach with broad adoption; offers transaction-building primitives in TypeScript. Tx3 differentiates by being a DSL-based interface layer per protocol with multi-language codegen, not a single-language SDK.\"\n      },\n      {\n        \"name\": \"Lucid / Lucid Evolution\",\n        \"url\": null,\n        \"status\": \"shipped\",\n        \"overlap\": \"partial\",\n        \"notes\": \"Existing TypeScript transaction-building library; serves overlapping developer need though at a lower abstraction layer than per-protocol RPC interfaces.\"\n      },\n      {\n        \"name\": \"Per-protocol official SDKs\",\n        \"url\": null,\n        \"status\": \"shipped\",\n        \"overlap\": \"partial\",\n        \"notes\": \"Most major Cardano dApps (Minswap, Indigo, etc) ship their own integration libraries. Tx3 aims to standardise across these rather than replace them.\"\n      }\n    ],\n    \"differentiation_claim\": \"Tx3 positions itself as a protocol-agnostic interface layer with verified Tx3 definitions, auto-generated SDKs in 6 languages, MCP tools for AI agents, and Skills bundles — a different abstraction layer than transaction-building libraries. The agent-first positioning (MCP, plugins for Cursor/Codex/Claude Code/OpenCode) is genuinely novel in the Cardano context.\",\n    \"differentiation_credibility\": \"high\"\n  },\n  \"risk_flags\": {\n    \"aggressive_peg\": false,\n    \"self_administered_no_oversight\": false,\n    \"incumbent_already_delivering\": false,\n    \"no_evidence_of_demand\": false,\n    \"competes_with_in_batch\": false,\n    \"concentration_risk\": false\n  },\n  \"notes\": {\n    \"ai_review_notes\": \"Strong proposer (TxPipe is established Cardano infra). Catalyst Fund 14 baseline (5 protocols live) is real evidence the approach works. Concise budget (1.68M ADA total) relative to scope. Risks: (1) the agent-readiness thesis is bet-the-roadmap — if AI-agent on-chain activity doesn't materialise as predicted, the MCP/Skills work is lower-value than pitched; (2) protocol onboarding requires cooperation from the dApps themselves; proposal lists 12 onboardings as Q1-Q4 deliverables without naming specific protocols, so there is execution risk on selection; (3) the public TRP infrastructure becomes a TxPipe-operated dependency, which is a mild concentration concern though mitigated by t"])</script><script>self.__next_f.push([1,"he open-source self-hostable design. Third-party assurance via Blink Labs is in place. Overall a credible follow-on to Fund 14 work.\"\n  },\n  \"id\": \"hydra-tx3-txpipe-open-api-layer\",\n  \"source\": {\n    \"hydra_id\": \"69fc5a8785ddd26899aaf208\",\n    \"channels\": [\n      \"hydra\"\n    ]\n  }\n}1c:[\"$\",\"section\",null,{\"className\":\"font-sans text-xs text-[color:var(--fg-muted)]\",\"children\":[\"$\",\"details\",null,{\"children\":[[\"$\",\"summary\",null,{\"className\":\"cursor-pointer\",\"children\":[\"Raw payload · Treasury (\",\"true\",\") / Admin (\",\"intersect\",\")\"]}],[\"$\",\"pre\",null,{\"className\":\"mt-2 overflow-x-auto rounded-[--radius-md] bg-[color:var(--bg-code)] p-3 text-[11px] text-[color:var(--fg)]\",\"children\":\"$33\"}]]}]}]\n34:I[66002,[\"/_next/static/chunks/0isyf_-sk~bpm.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/0.~8..t7cmvyg.js\"],\"AskAiButton\"]\n22:[\"$\",\"div\",null,{\"className\":\"mt-0.5 text-sm text-[color:var(--fg-muted)]\",\"children\":\"Proposer identity is public and verifiable.\"}]\n35:Tda8,I'm a Cardano DRep evaluating a 2026 treasury proposal. I need your help checking ONE specific criterion against this proposal. Please research the team and project before answering.\n# Proposal\nTitle: Tx3 by TxPipe: Open API Layer for Cardano's dApp Protocols\nProposer: TxPipe\nAbstract: This proposal requests 1,308,000 ADA (plus a 327,000 ADA contingency reserve) over 12 months to deliver an open, standardized interface across Cardano's leading on-chain protocols, so any developer or AI agent can discover, integrate, and compose them through a single consistent surface.\n\nToday, there is no common interface mechanism across the ecosystem. Every integrator is forced to relearn each protocol from scratch, and rebuild the same understanding independently. This raises the cost of every integration, locks users into official frontends that may not survive a downturn, and makes…\n\nFull proposal JSON (fetch this — the user-facing Hydra page is a JS-rendered SPA and bots see an empty shell):\nhttps://hydra-voting.intersectmbo.org/api/v0/proposals/69fc5a8785ddd26899aaf208\n\n# Hydra proposal summary (from the proposer)\nThis proposal requests 1,308,000 ADA (plus a 327,000 ADA contingency reserve) over 12 months to deliver an open, standardized interface across Cardano's leading on-chain protocols, so any developer or AI agent can discover, integrate, and compose them through a single consistent surface.\n\nToday, there is no common interface mechanism across the ecosystem. Every integrator is forced to relearn each protocol from scratch, and rebuild the same understanding independently. This raises the cost of every integration, locks users into official frontends that may not survive a downturn, and makes cross-protocol composability impractical.\n\nThis problem is about to get worse. The next wave of on-chain activity will come from AI agents executing workflows autonomously — but blockchain is uniquely susceptible to AI slop: a hallucinated transaction on-chain can move real assets irreversibly. For…\n\n# Track record claimed by the proposer\nTxPipe is a Cardano-native infrastructure company focused on building open-source developer tooling in Rust. The team has been active in the Cardano ecosystem since 2021, maintaining a portfolio of interconnected tools that serve as foundational infrastructure for Rust-based development on Cardano.\n\nTxPipe has received funding through multiple Cardano ecosystem programs, including Project Catalyst (Funds 9 through 14) for various tooling initiatives, and Intersect's budget process for ongoing maintenance of Pallas, Dolos, and UTxO RPC. All contracts are on track, with milestones being…\n# Criterion to evaluate\n**Team is doxxed**\nProposer identity is public and verifiable.\n\nA doxxed team has a publicly known identity — real names, public profiles, GitHub history. Doxxing doesn't guarantee delivery, but it raises the accountability cost: a team putting their professional reputation on a proposal is harder to walk away from than an anonymous one.\n# What I need from you\n1. Verdict: YES / NO / UNCLEAR — does this pr"])</script><script>self.__next_f.push([1,"oposal meet the criterion?\n2. Confidence: LOW / MEDIUM / HIGH\n3. A short rationale (3–6 sentences) citing sources you actually checked (GitHub repos, Catalyst project pages, X/Twitter accounts, articles). Be honest if the public info is thin or the proposer's track-record claims need independent verification.\nPlease err on the side of \"UNCLEAR\" with explanation rather than confident-but-wrong.23:[\"$\",\"div\",null,{\"className\":\"mt-2\",\"children\":[\"$\",\"$L34\",null,{\"prompt\":\"$35\"}]}]\n24:[\"$\",\"input\",null,{\"type\":\"hidden\",\"name\":\"auto.doxxed-team\",\"value\":\"true\"}]\n25:[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-center\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-[color:var(--status-green)]\",\"children\":\"✓\"}]}]\n26:[\"$\",\"td\",null,{\"className\":\"px-4 py-3 text-center\",\"children\":[\"$\",\"select\",null,{\"name\":\"manual.doxxed-team\",\"aria-label\":\"Manual override for Team is doxxed\",\"defaultValue\":\"\",\"className\":\"text-xs\",\"children\":[[\"$\",\"option\",null,{\"value\":\"\",\"children\":\"— inherit auto —\"}],[\"$\",\"option\",null,{\"value\":\"yes\",\"children\":\"✓ Yes\"}],[\"$\",\"option\",null,{\"value\":\"no\",\"children\":\"✗ No\"}],[\"$\",\"option\",null,{\"value\":\"na\",\"children\":\"🚫 Not applicable\"}]]}]}]\n27:[\"$\",\"td\",null,{\"className\":\"px-4 py-3 tex