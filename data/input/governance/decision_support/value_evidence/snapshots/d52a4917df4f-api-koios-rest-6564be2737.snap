[{"block_time":1726673082,"proposal_id":"gov_action1t87n2vjnavthuggyarerafxx8c7n9mu4c7r96qlfp5uggsjdc8dsqymg588","proposal_tx_hash":"59fd353253eb177e2104e8f23ea4c63e3d32ef95c7865d03e90d3884424dc1db","proposal_index":0,"proposal_type":"InfoAction","proposal_description":{"tag": "InfoAction"},"deposit":"100000000000","return_address":"stake1uys93fhep4lc2u6lu0q09kcxayxzthasded35c0x0w60ugc9s0cm5","proposed_epoch":510,"ratified_epoch":null,"enacted_epoch":null,"dropped_epoch":518,"expired_epoch":517,"expiration":517,"meta_url":"https://c-ipfs-gw.nmkr.io/ipfs/QmXdfDSSkR8TYBntMT4nuTL9sE9E44FJnpWVpaY8ZTfwjj","meta_hash":"d4efa9e0c3d80f5be35def08551eaf5aef17eae832fdb835e5f4b208d98f3dff","meta_json":{"body": {"title": "Cardanoの生きがい - Ikigai -", "abstract": "この瞬間、私たちは心からの感謝と敬意を、Charles Hoskinson率いるInput Output、EMURGO、そしてCardano財団に捧げます。彼らはCardanoを世界にもたらし、その献身、ビジョン、そして揺るぎない努力によって、私たちが今立っている土台を築き上げてくれました。彼らは「生きがい(Ikigai)」の本質を体現し、自身の仕事に喜びと意味を見出しながら、より大きな善のために貢献する力を示したのです。\n次のステージに向かう私たちは、少数の努力から多くの力へと移行します。共通の目的意識を持ち、Cardanoコミュニティとして、この土台を集団の知恵、情熱、そしてエネルギーでさらに築き上げていくことを誓います。私たち一人ひとりがCardanoの未来の一端を担い、共通の目的と、共に大きなことを成し遂げられるという信念によって結ばれています。", "rationale": "この瞬間を振り返りながら、私たちはこの約束を、先人たちだけでなく、自分自身や未来の人々に対しても誓います。分散型ガバナンスの時代に、このガバナンスアクションを提出することで、私たちの目的-Cardanoの「生きがい(Ikigai)」を再確認するのです。\nこのガバナンスアクションは祝意を表すものであり、Cardanoエコシステムに関してオンチェーンに対してもオフチェーンに対しても、直接的にも間接的にも、変更を求めるものではありません。DRepやSPOは、この感情に共感する場合は「YES」に投票し、共感しない場合は「NO」、または確信が持てない場合は「棄権」を選んでください。", "motivation": "CharlesがTEDトークやホワイトボードビデオで示した夢は、私たちがこの旅を始めた理由を思い起こさせる灯台のような存在です。私たちは、金融システムの変革だけでなく、すべての人類に自由と繁栄をもたらす可能性を秘めたビジョンの実現に向けて動いています。この大きな変革の一翼を担い、人々が共通の目的で団結したときに何を成し遂げられるかという証を残すことができるというチャンスに、私たちはつき動かされているのです。", "references": [{"uri": "ipfs://QmXZUBLuUV3V8e46N9AvCJJU9y5maZ3qkiaSCuKMEECsGV", "@type": "Other", "label": "العربية", "@language": "ar"}, {"uri": "ipfs://QmWeKwFYfc47K2NKYt2h4oudHk3RG7HzyCtwrwPo99Uayj", "@type": "Other", "label": "বাংলা", "@language": "bn"}, {"uri": "ipfs://QmYuLWBiZzNdxjzMcVmyGbpw5UGTvMfDH1sHDqrfw7pZqJ", "@type": "Other", "label": "Deutsch", "@language": "de"}, {"uri": "ipfs://QmW6XKvnqT57FWhXVAzALVqYvFnVeyM8cTu6HFQe5JicQr", "@type": "Other", "label": "Ελληνικά", "@language": "el"}, {"uri": "ipfs://QmfB28eTYeBsVV4WQ1WdSyZrGmrRcFQumgMDbJfhDPcnQs", "@type": "Other", "label": "English", "@language": "en"}, {"uri": "ipfs://QmPT9f5yBQEmTxkx36HsNMAagiquYnHA3jfEumwM1M3EjG", "@type": "Other", "label": "español", "@language": "es"}, {"uri": "ipfs://QmbvXamvY3VgE8eMfzUUxJ4LqcenPyWLLCQrHPJfb2BZgb", "@type": "Other", "label": "français", "@language": "fr"}, {"uri": "ipfs://QmdMbc1PkdwhXMHcPs2EATq7w3JHTkK5bpddtmjgU4r2Dj", "@type": "Other", "label": "हिंदी", "@language": "hi"}, {"uri": "ipfs://QmdVueQ5EckVhKyeUdSAnE9WFo6qT5zX8ycS9zBWjh2bR9", "@type": "Other", "label": "Bahasa Indonesia", "@language": "id"}, {"uri": "ipfs://QmR3tAYR6w9tVKskYcv4XeNwqCYCoLvM3c7jafi97La1Ax", "@type": "Other", "label": "italiano", "@language": "it"}, {"uri": "ipfs://QmWGxfcfZUiMNgy7T2SLFEMS9FdWc6TbsocdJhckczJ6S2", "@type": "Other", "label": "한국어", "@language": "ko"}, {"uri": "ipfs://QmNbGsjePLT9kD1rL2z8z3gWHDuhd7C1j5AE8JTsgTJrE4", "@type": "Other", "label": "Te Reo Māori", "@language": "mi"}, {"uri": "ipfs://QmamVhdtn4UitFNb2isFqhrPhpHMNSDKQHon8toUB6na3v", "@type": "Other", "label": "português", "@language": "pt"}, {"uri": "ipfs://QmQSVXMEztL5AgiF4aRD9PMbTXsEnZoatx7RhWid4kqw2R", "@type": "Other", "label": "русский", "@language": "ru"}, {"uri": "ipfs://QmTVaWmhUVWsKZcknBVmMDeN5fkdZKpszLxM8tN65op4vX", "@type": "Other", "label": "Kiswahili", "@language": "sw"}, {"uri": "ipfs://QmTY9odd2hsJgPXCKVPSiYv48M8BDZWyuzJq5oy8kj9NBL", "@type": "Other", "label": "Türkçe", "@language": "tr"}, {"uri": "ipfs://QmTLQZBJwYo8EhuwMSKM8FNEoLv1EECjiUBDchrETRoUkU", "@type": "Other", "label": "اُردو", "@language": "ur"}, {"uri": "ipfs://QmbxNiEbVhyKhbycfztG18WJxCRFWn6GjF9EeoZY2eFYKj", "@type": "Other", "label": "Tiếng Việt", "@language": "vi"}, {"uri": "ipfs://QmenMXtpbZUGJ17uWNg2r6qmxy1fKFyqzkcoN1LMf6rRhs", "@type": "Other", "